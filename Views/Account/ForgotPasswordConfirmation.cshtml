@{
    ViewBag.Title = "Forgot Password Confirmation";
}

<main aria-labelledby="title">
    <hgroup class="title">
        <h1 id="title">@ViewBag.Title.</h1>
    </hgroup>
    <div>
        <p>
            If an account exists for that email address, a password reset link will arrive shortly. The link expires after one hour.
        </p>
    </div>
</main>
