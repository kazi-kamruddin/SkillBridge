@{
    ViewBag.Title = "About Us";
}
<main class="container my-5 sb-about-page">
    <header class="sb-page-heading">
        <span class="sb-eyebrow">About SkillBridge</span>
        <h1>Skills are better<br />when shared.</h1>
        <p>We connect people who want to teach and learn, creating opportunities to exchange skills, knowledge, and grow together as a community.</p>
    </header>
    <div class="sb-about-story">
        <section><span class="sb-eyebrow">01 / Why we exist</span><h2>Our mission</h2><p>Our mission is to connect people who want to teach and learn, creating opportunities to exchange skills, knowledge, and grow together as a community.</p></section>
        <section><span class="sb-eyebrow">02 / Where we started</span><h2>Our history</h2><p>SkillBridge began as a university project to help people exchange skills and learn together. We are continuing to improve it with feedback from the community.</p></section>
    </div>
    <section class="sb-about-people" aria-labelledby="team-heading">
        <div class="sb-section-heading"><span class="sb-section-number">03</span><h2 id="team-heading">Meet our dev team</h2></div>
        <div class="sb-people-grid">
            <article class="sb-person-card"><img src="~/Content/DP/rakibul.jpg" alt="Rakibul Islam Rahi" /><div><h3>Rakibul Islam Rahi</h3><p>FrontEnd</p></div></article>
            <article class="sb-person-card"><img src="~/Content/DP/kazi.jpg" alt="Kazi Kamruddin Ahmed" /><div><h3>Kazi Kamruddin Ahmed</h3><p>FrontEnd + BackEnd</p></div></article>
            <article class="sb-person-card"><img src="~/Content/DP/sakib.jpg" alt="Abdullah Ishtiaq" /><div><h3>Abdullah Ishtiaq</h3><p>FrontEnd</p></div></article>
        </div>
    </section>
    <section class="sb-about-people" aria-labelledby="thanks-heading">
        <div class="sb-section-heading"><span class="sb-section-number">04</span><h2 id="thanks-heading">Special thanks to</h2></div>
        <div class="sb-people-grid">
            <article class="sb-person-card"><img src="~/Content/DP/broti.jpeg" alt="Ms. Tanjila Broti" /><div><h3>Ms. Tanjila Broti</h3><p>Lecturer</p></div></article>
            <article class="sb-person-card"><img src="~/Content/DP/muthaki.jpeg" alt="Ms. Tahsina Muthaki" /><div><h3>Ms. Tahsina Muthaki</h3><p>Lecturer</p></div></article>
        </div>
    </section>
</main>
