@model SkillBridge.Models.HomePageViewModel
@{
    ViewBag.Title = "Home";
}

<main class="tw:mx-auto tw:max-w-[1320px] tw:px-4 tw:py-8 tw:font-display tw:text-sb-ink tw:dark:text-sb-night-ink">
    @if (!Model.IsLoggedIn)
    {
        <section class="tw:relative tw:grid tw:grid-cols-1 tw:items-center tw:gap-6 tw:overflow-hidden tw:rounded-[1.6rem] tw:border-2 tw:border-sb-ink tw:bg-sb-sage tw:p-5 tw:shadow-sb tw:dark:border-sb-border-card tw:md:grid-cols-2 tw:md:p-8 tw:lg:p-9">
            <div class="tw:pointer-events-none tw:absolute tw:-right-10 tw:-top-16 tw:size-52 tw:rounded-full tw:border-2 tw:border-sb-ink/10 tw:dark:border-sb-night-ink/10"></div>
            <div class="tw:relative tw:z-10">
                <span class="tw:inline-flex tw:items-center tw:gap-2 tw:rounded-full tw:border-2 tw:border-sb-ink tw:bg-sb-card tw:px-3 tw:py-1 tw:text-xs tw:font-black tw:uppercase tw:tracking-[.14em] tw:shadow-sb-small tw:dark:border-sb-border-card tw:dark:bg-sb-surface-raised">A community built on give &amp; grow <span aria-hidden="true">✳</span></span>
                <h1 class="tw:mt-5 tw:max-w-[620px] tw:text-4xl tw:font-black tw:leading-[1.02] tw:tracking-[-.055em] tw:md:text-5xl tw:lg:text-6xl">Teach what you know.<br /><span class="tw:text-sb-blue-strong tw:dark:text-sb-blue-link">Learn what you love.</span></h1>
                <p class="tw:mt-4 tw:max-w-[520px] tw:text-base tw:leading-relaxed tw:text-sb-muted tw:dark:text-sb-muted tw:md:text-lg">Trade skills with real people. Find someone who wants to learn from you and has something new to share in return.</p>
                <div class="tw:mt-6 tw:flex tw:flex-wrap tw:gap-3">
                    <a class="tw:inline-flex tw:min-h-11 tw:items-center tw:gap-2 tw:rounded-xl tw:border-2 tw:border-sb-border-control tw:bg-sb-blue-strong tw:px-5 tw:py-2.5 tw:font-extrabold tw:text-white tw:shadow-sb-small tw:transition-transform tw:hover:translate-x-[2px] tw:hover:translate-y-[2px]" href="@Url.Action("Skills", "Explore")">Explore skills <span aria-hidden="true">↗</span></a>
                    <a class="tw:inline-flex tw:min-h-11 tw:items-center tw:gap-2 tw:rounded-xl tw:border-2 tw:border-sb-border-control tw:bg-sb-card tw:px-5 tw:py-2.5 tw:font-extrabold tw:text-sb-ink tw:shadow-sb-small tw:transition-transform tw:hover:translate-x-[2px] tw:hover:translate-y-[2px] tw:dark:bg-sb-surface-raised tw:dark:text-sb-night-ink" href="@Url.Action("Register", "Account")">Join SkillBridge <span aria-hidden="true">✳</span></a>
                </div>
                <div class="tw:mt-6 tw:flex tw:flex-wrap tw:gap-x-5 tw:gap-y-2 tw:text-xs tw:font-bold tw:text-sb-muted tw:dark:text-sb-muted tw:md:text-sm"><span>01 / Share what you know</span><span>02 / Learn from someone new</span></div>
            </div>

            <div class="tw:relative tw:mx-auto tw:my-4 tw:min-h-[300px] tw:w-full tw:max-w-[440px] tw:md:min-h-[370px]" aria-label="A sample skill exchange between two members">
                <div class="tw:absolute tw:left-[4%] tw:top-[4%] tw:rotate-[-7deg] tw:rounded-lg tw:border-2 tw:border-sb-ink tw:bg-sb-blue tw:px-3 tw:py-2 tw:text-sm tw:font-black tw:shadow-sb-small tw:dark:border-sb-border-card tw:dark:bg-sb-blue">SKILL EXCHANGE <span class="tw:ml-1 tw:text-lg tw:tabular-nums">01</span></div>
                <div class="tw:absolute tw:right-[2%] tw:top-[3%] tw:grid tw:size-16 tw:rotate-[10deg] tw:place-items-center tw:rounded-full tw:border-2 tw:border-sb-ink tw:bg-sb-coral tw:text-2xl tw:shadow-sb-small tw:dark:border-sb-border-card tw:dark:bg-sb-coral-rich">✳</div>
                <div class="tw:absolute tw:left-[8%] tw:top-[24%] tw:w-[76%] tw:rotate-[-5deg] tw:rounded-2xl tw:border-2 tw:border-sb-ink tw:bg-sb-card tw:p-4 tw:shadow-sb tw:dark:border-sb-border-card tw:dark:bg-sb-surface-raised">
                    <span class="tw:text-xs tw:font-black tw:uppercase tw:tracking-[.18em] tw:text-sb-muted">I can teach</span>
                    <strong class="tw:mt-2 tw:block tw:text-3xl tw:font-black tw:tracking-[-.05em] tw:md:text-4xl">UI Design <span class="tw:float-right tw:text-2xl">✎</span></strong>
                    <span class="tw:mt-3 tw:inline-flex tw:rounded-full tw:border tw:border-sb-ink tw:bg-sb-sage tw:px-3 tw:py-0.5 tw:text-xs tw:font-bold tw:dark:border-sb-border-card tw:dark:bg-sb-sage">Make ideas visible</span>
                </div>
                <div class="tw:absolute tw:left-[40%] tw:top-[47%] tw:z-10 tw:grid tw:size-14 tw:rotate-[8deg] tw:place-items-center tw:rounded-full tw:border-2 tw:border-sb-ink tw:bg-sb-coral tw:text-3xl tw:font-black tw:shadow-sb-small tw:dark:border-sb-border-card tw:dark:bg-sb-coral-rich">↔</div>
                <div class="tw:absolute tw:bottom-[6%] tw:right-[5%] tw:w-[76%] tw:rotate-[4deg] tw:rounded-2xl tw:border-2 tw:border-sb-ink tw:bg-sb-blue tw:p-4 tw:shadow-sb tw:dark:border-sb-border-card tw:dark:bg-sb-blue">
                    <span class="tw:text-xs tw:font-black tw:uppercase tw:tracking-[.18em] tw:text-sb-muted">I want to learn</span>
                    <strong class="tw:mt-2 tw:block tw:text-3xl tw:font-black tw:tracking-[-.05em] tw:md:text-4xl">JavaScript <span class="tw:float-right tw:text-2xl">⌘</span></strong>
                    <span class="tw:mt-3 tw:inline-flex tw:rounded-full tw:border tw:border-sb-ink tw:bg-sb-card tw:px-3 tw:py-0.5 tw:text-xs tw:font-bold tw:dark:border-sb-border-card tw:dark:bg-sb-surface-raised">Start with the basics</span>
                </div>
                <span class="tw:absolute tw:bottom-[1%] tw:left-[3%] tw:rotate-[-8deg] tw:rounded-full tw:border-2 tw:border-sb-ink tw:bg-sb-sage tw:px-3 tw:py-1.5 tw:text-xs tw:font-black tw:text-sb-ink tw:shadow-sb-small tw:dark:border-sb-border-card tw:dark:bg-sb-sage-deep tw:dark:text-white">Better, together.</span>
            </div>
        </section>

        <div class="tw:my-7 tw:flex tw:flex-wrap tw:items-center tw:justify-center tw:gap-x-5 tw:gap-y-2 tw:border-y-2 tw:border-sb-ink tw:py-4 tw:text-center tw:text-sm tw:font-black tw:uppercase tw:tracking-[.12em] tw:dark:border-sb-border-card tw:md:gap-x-10"><span>Share a skill <span class="tw:text-sb-blue-strong tw:dark:text-sb-blue-link">✳</span></span><span>Find your people <span class="tw:text-sb-blue-strong tw:dark:text-sb-blue-link">✳</span></span><span>Make something new <span class="tw:text-sb-blue-strong tw:dark:text-sb-blue-link">✳</span></span><span>Keep growing</span></div>

        <section class="tw:py-8 tw:md:py-12" aria-labelledby="home-good-part">
            <div class="tw:mb-8 tw:flex tw:flex-wrap tw:items-end tw:justify-between tw:gap-4">
                <div><span class="tw:text-xs tw:font-black tw:uppercase tw:tracking-[.16em] tw:text-sb-blue-strong tw:dark:text-sb-blue-link">The good part / 02</span><h2 id="home-good-part" class="tw:mt-2 tw:max-w-[700px] tw:text-4xl tw:font-black tw:leading-[1.02] tw:tracking-[-.05em] tw:md:text-5xl">Everyone brings something to the table.</h2></div>
                <p class="tw:max-w-[360px] tw:text-sb-muted">Start with curiosity. Leave with a new skill and a new connection.</p>
            </div>
            <div class="tw:grid tw:grid-cols-1 tw:gap-5 tw:md:grid-cols-3">
                <article class="tw:rounded-2xl tw:border-2 tw:border-sb-ink tw:bg-sb-card tw:p-6 tw:shadow-sb-small tw:dark:border-sb-border-card"><span class="tw:grid tw:size-14 tw:place-items-center tw:rounded-xl tw:border-2 tw:border-sb-ink tw:bg-sb-blue tw:text-2xl tw:shadow-sb-small tw:dark:border-sb-border-card">◎</span><span class="tw:mt-5 block tw:text-xs tw:font-black tw:uppercase tw:tracking-[.14em] tw:text-sb-muted">Find your people</span><h3 class="tw:mt-2 tw:text-2xl tw:font-black">Join communities</h3><p class="tw:mt-2 tw:text-sb-muted">Meet people who are learning, making, and figuring things out alongside you.</p><a class="tw:mt-4 tw:inline-flex tw:py-1 tw:font-extrabold tw:text-sb-blue-strong tw:underline tw:decoration-2 tw:underline-offset-4 tw:dark:text-sb-blue-link" href="@Url.Action("Index", "Communities")">Community Feed ↗</a></article>
                <article class="tw:rounded-2xl tw:border-2 tw:border-sb-ink tw:bg-sb-sage tw:p-6 tw:shadow-sb-small tw:dark:border-sb-border-card"><span class="tw:grid tw:size-14 tw:place-items-center tw:rounded-full tw:border-2 tw:border-sb-ink tw:bg-sb-coral tw:text-2xl tw:shadow-sb-small tw:dark:border-sb-border-card tw:dark:bg-sb-coral-rich">↔</span><span class="tw:mt-5 block tw:text-xs tw:font-black tw:uppercase tw:tracking-[.14em] tw:text-sb-muted">Give and get</span><h3 class="tw:mt-2 tw:text-2xl tw:font-black">Trade skills</h3><p class="tw:mt-2 tw:text-sb-muted">Teach something you know and learn something you have always wanted to try.</p><a class="tw:mt-4 tw:inline-flex tw:py-1 tw:font-extrabold tw:text-sb-blue-strong tw:underline tw:decoration-2 tw:underline-offset-4 tw:dark:text-sb-blue-link" href="@Url.Action("Skills", "Explore")">Explore skills ↗</a></article>
                <article class="tw:relative tw:overflow-hidden tw:rounded-2xl tw:border-2 tw:border-sb-ink tw:bg-sb-blue tw:p-6 tw:shadow-sb-small tw:dark:border-sb-border-card"><span class="tw:grid tw:size-14 tw:rotate-[-8deg] tw:place-items-center tw:rounded-xl tw:border-2 tw:border-sb-ink tw:bg-sb-sage tw:text-2xl tw:shadow-sb-small tw:dark:border-sb-border-card tw:dark:bg-sb-sage-deep tw:dark:text-white">↗</span><span class="tw:mt-5 block tw:text-xs tw:font-black tw:uppercase tw:tracking-[.14em] tw:text-sb-muted">One step at a time</span><h3 class="tw:mt-2 tw:text-2xl tw:font-black">Grow together</h3><p class="tw:mt-2 tw:text-sb-muted">Set a pace, plan sessions, and celebrate progress with your learning partner.</p><a class="tw:mt-4 tw:inline-flex tw:py-1 tw:font-extrabold tw:text-sb-blue-strong tw:underline tw:decoration-2 tw:underline-offset-4 tw:dark:text-sb-blue-link" href="@Url.Action("HowItWorks", "Home")">See how it works ↗</a></article>
            </div>
        </section>

        <section class="tw:mb-4 tw:grid tw:grid-cols-1 tw:items-center tw:gap-5 tw:rounded-2xl tw:border-2 tw:border-sb-ink tw:bg-sb-coral tw:p-6 tw:shadow-sb-small tw:dark:border-sb-border-card tw:dark:bg-sb-coral-rich tw:md:grid-cols-[1fr_auto] tw:md:p-8">
            <div><span class="tw:text-xs tw:font-black tw:uppercase tw:tracking-[.16em]">Your next chapter</span><h2 class="tw:mt-2 tw:text-3xl tw:font-black tw:tracking-[-.04em] tw:md:text-4xl">Curiosity looks good on you.</h2><p class="tw:mt-2 tw:max-w-[620px] tw:text-sb-ink/85 tw:dark:text-sb-night-ink/85">Create a profile, share your skills, and see what you can learn from each other.</p></div>
            <a class="tw:inline-flex tw:min-h-11 tw:items-center tw:justify-center tw:gap-2 tw:rounded-xl tw:border-2 tw:border-sb-border-control tw:bg-sb-card tw:px-5 tw:py-3 tw:font-extrabold tw:text-sb-ink tw:shadow-sb-small tw:transition-transform tw:hover:translate-x-[2px] tw:hover:translate-y-[2px] tw:dark:bg-sb-surface-raised tw:dark:text-sb-night-ink" href="@Url.Action("Register", "Account")">Create your account <span aria-hidden="true">↗</span></a>
        </section>
    }
    else
    {
        <div class="tw:space-y-7">
            @if (TempData["AccountNotice"] is string accountNotice)
            {
                <div class="alert tw:rounded-xl tw:border-2 tw:border-sb-border-card tw:bg-sb-blue tw:p-4 tw:font-semibold tw:text-sb-ink tw:shadow-sb-small" role="status">@accountNotice</div>
            }
            <header class="tw:relative tw:grid tw:grid-cols-1 tw:items-center tw:gap-6 tw:overflow-hidden tw:rounded-[1.6rem] tw:border-2 tw:border-sb-ink tw:bg-sb-sage tw:p-5 tw:shadow-sb tw:dark:border-sb-border-card tw:md:grid-cols-2 tw:md:p-7 tw:lg:p-8">
                <div><span class="tw:inline-flex tw:items-center tw:gap-2 tw:rounded-full tw:border-2 tw:border-sb-ink tw:bg-sb-card tw:px-3 tw:py-1 tw:text-xs tw:font-black tw:uppercase tw:tracking-[.14em] tw:shadow-sb-small tw:dark:border-sb-border-card tw:dark:bg-sb-surface-raised">Your SkillBridge space <span aria-hidden="true">✳</span></span><h1 class="tw:mt-5 tw:text-3xl tw:font-black tw:leading-[1.04] tw:tracking-[-.055em] tw:md:text-5xl">Good to see you,<br /><span class="tw:text-sb-blue-strong tw:dark:text-sb-blue-link">@Model.FullName.</span></h1><p class="tw:mt-3 tw:max-w-[540px] tw:text-base tw:text-sb-muted tw:md:text-lg">Something good starts when you share what you know.</p><div class="tw:mt-5 tw:flex tw:flex-wrap tw:gap-3"><a class="tw:inline-flex tw:min-h-11 tw:items-center tw:rounded-xl tw:border-2 tw:border-sb-border-control tw:bg-sb-blue-strong tw:px-5 tw:py-2.5 tw:font-extrabold tw:text-white tw:shadow-sb-small tw:transition-transform tw:hover:translate-x-[2px] tw:hover:translate-y-[2px]" href="@Url.Action("Index", "Explore")">Find a partner ↗</a><a class="tw:inline-flex tw:min-h-11 tw:items-center tw:rounded-xl tw:border-2 tw:border-sb-border-control tw:bg-sb-card tw:px-5 tw:py-2.5 tw:font-extrabold tw:text-sb-ink tw:shadow-sb-small tw:transition-transform tw:hover:translate-x-[2px] tw:hover:translate-y-[2px] tw:dark:bg-sb-surface-raised tw:dark:text-sb-night-ink" href="@Url.Action("Index", "Communities")">Community Feed</a></div></div>
                <div class="tw:relative tw:mx-auto tw:min-h-[220px] tw:w-full tw:max-w-[400px]" aria-hidden="true"><div class="tw:absolute tw:left-[5%] tw:top-[10%] tw:w-[76%] tw:rotate-[-7deg] tw:rounded-xl tw:border-2 tw:border-sb-ink tw:bg-sb-blue tw:p-4 tw:text-xl tw:font-black tw:shadow-sb tw:dark:border-sb-border-card tw:dark:bg-sb-blue">I CAN TEACH <span class="tw:float-right tw:text-2xl">✎</span></div><div class="tw:absolute tw:bottom-[8%] tw:right-[4%] tw:w-[76%] tw:rotate-[6deg] tw:rounded-xl tw:border-2 tw:border-sb-ink tw:bg-sb-coral tw:p-4 tw:text-xl tw:font-black tw:shadow-sb tw:dark:border-sb-border-card tw:dark:bg-sb-coral-rich">I WANT TO LEARN <span class="tw:float-right tw:text-2xl">↗</span></div><span class="tw:absolute tw:left-[42%] tw:top-[43%] tw:grid tw:size-14 tw:place-items-center tw:rounded-full tw:border-2 tw:border-sb-ink tw:bg-sb-card tw:text-2xl tw:shadow-sb-small tw:dark:border-sb-border-card tw:dark:bg-sb-surface-raised">↔</span><span class="tw:absolute tw:right-[1%] tw:top-0 tw:grid tw:size-11 tw:rotate-6 tw:place-items-center tw:rounded-xl tw:border-2 tw:border-sb-ink tw:bg-sb-card tw:text-xl tw:shadow-sb-small tw:dark:border-sb-border-card tw:dark:bg-sb-surface-raised">✦</span><span class="tw:absolute tw:bottom-0 tw:left-[2%] tw:grid tw:size-11 tw:-rotate-6 tw:place-items-center tw:rounded-full tw:border-2 tw:border-sb-ink tw:bg-sb-sage tw:text-xl tw:shadow-sb-small tw:dark:border-sb-border-card tw:dark:bg-sb-sage-deep tw:dark:text-white">⌘</span></div>
            </header>

            <div class="tw:grid tw:grid-cols-1 tw:gap-4 tw:md:grid-cols-[1.25fr_.75fr]">
                <section class="tw:flex tw:flex-col tw:items-start tw:rounded-2xl tw:border-2 tw:border-sb-ink tw:bg-sb-card tw:p-6 tw:shadow-sb-small tw:dark:border-sb-border-card" aria-labelledby="next-action-heading"><span class="tw:text-xs tw:font-black tw:uppercase tw:tracking-[.15em] tw:text-sb-blue-strong tw:dark:text-sb-blue-link">Your next step</span><h2 id="next-action-heading" class="tw:mt-2 tw:text-2xl tw:font-black">@Model.NextActionTitle</h2><p class="tw:mt-2 tw:flex-1 tw:text-sb-muted">@Model.NextActionDescription</p><a class="tw:mt-5 tw:inline-flex tw:min-h-11 tw:items-center tw:gap-2 tw:rounded-xl tw:border-2 tw:border-sb-border-control tw:bg-sb-blue-strong tw:px-5 tw:py-3 tw:font-extrabold tw:text-white tw:shadow-sb-small tw:transition-transform tw:hover:translate-x-[2px] tw:hover:translate-y-[2px]" href="@Model.NextActionUrl">Continue <span aria-hidden="true">↗</span></a></section>
                @if (!string.IsNullOrEmpty(Model.MotivationalQuote))
                {
                    <blockquote class="tw:flex tw:flex-col tw:justify-center tw:rounded-2xl tw:border-2 tw:border-sb-ink tw:bg-sb-blue tw:p-6 tw:shadow-sb-small tw:dark:border-sb-border-card"><span class="tw:text-4xl tw:font-black" aria-hidden="true">“</span><p class="tw:text-xl tw:font-bold tw:italic">@Model.MotivationalQuote</p><span class="tw:mt-3 tw:text-xs tw:font-black tw:uppercase tw:tracking-[.14em] tw:text-sb-muted">A small thought for today</span></blockquote>
                }
            </div>

            <section aria-labelledby="my-skills-heading"><div class="tw:mb-5 tw:flex tw:flex-wrap tw:items-end tw:justify-between tw:gap-3"><div><span class="tw:text-xs tw:font-black tw:uppercase tw:tracking-[.15em] tw:text-sb-blue-strong tw:dark:text-sb-blue-link">Your toolkit / 01</span><h2 id="my-skills-heading" class="tw:mt-1 tw:text-3xl tw:font-black tw:tracking-[-.04em]">Your skills</h2></div><a class="tw:inline-block tw:py-1 tw:font-extrabold tw:text-sb-blue-strong tw:underline tw:decoration-2 tw:underline-offset-4 tw:dark:text-sb-blue-link" href="@Url.Action("UpdateProfile", "Profile")">Manage skills ↗</a></div>
                <div class="tw:grid tw:grid-cols-1 tw:gap-4 tw:sm:grid-cols-2 tw:lg:grid-cols-3">
                    @if (Model.MySkills.Any())
                    {
                        foreach (var skill in Model.MySkills)
                        {
                            <article class="tw:relative tw:rounded-xl tw:border-2 tw:border-sb-ink tw:bg-sb-card tw:p-5 tw:shadow-sb-small tw:dark:border-sb-border-card"><span class="tw:absolute tw:right-4 tw:top-4 tw:grid tw:size-9 tw:rotate-3 tw:place-items-center tw:rounded-lg tw:border-2 tw:border-sb-ink tw:bg-sb-blue tw:text-lg tw:font-black tw:dark:border-sb-border-card">@(skill.Status == "Teaching" ? "✎" : "⌘")</span><span class="tw:text-xs tw:font-black tw:uppercase tw:tracking-[.14em] tw:text-sb-muted">@(skill.Status == "Teaching" ? "I can teach" : "I want to learn")</span><h3 class="tw:mt-2 tw:pr-10 tw:text-2xl tw:font-black">@skill.Skill.Name</h3><span class="tw:mt-4 tw:inline-flex tw:rounded-full tw:border tw:border-sb-border-card tw:bg-sb-sage tw:px-3 tw:py-1 tw:text-sm tw:font-bold">@skill.Status</span></article>
                        }
                    }
                    else
                    {
                        <div class="tw:rounded-xl tw:border-2 tw:border-dashed tw:border-sb-ink tw:bg-sb-card tw:p-6 tw:dark:border-sb-border-card"><span class="tw:text-3xl" aria-hidden="true">✳</span><h3 class="tw:mt-2 tw:text-xl tw:font-black">Your first skill goes here</h3><p class="tw:mt-1 tw:text-sb-muted">Add something you can teach, something you want to learn, or both—tailored matches update automatically.</p><a class="tw:mt-3 tw:inline-flex tw:py-1 tw:font-extrabold tw:text-sb-blue-strong tw:underline tw:dark:text-sb-blue-link" href="@Url.Action("UpdateProfile", "Profile")">Add skills ↗</a></div>
                    }
                </div>
            </section>

            <section aria-labelledby="latest-interaction-heading"><div class="tw:mb-5"><span class="tw:text-xs tw:font-black tw:uppercase tw:tracking-[.15em] tw:text-sb-blue-strong tw:dark:text-sb-blue-link">Keep the exchange moving / 02</span><h2 id="latest-interaction-heading" class="tw:mt-1 tw:text-3xl tw:font-black tw:tracking-[-.04em]">Latest interaction</h2></div>
                @if (Model.LatestInteractionId != null)
                {
                    var isOneWay = string.IsNullOrWhiteSpace(Model.LatestInteractionSkillYouLearn) || string.IsNullOrWhiteSpace(Model.LatestInteractionSkillYouTeach);
                    <article class="tw:rounded-2xl tw:border-2 tw:border-sb-ink tw:bg-sb-card tw:p-5 tw:shadow-sb-small tw:dark:border-sb-border-card">
                        <div class="tw:flex tw:flex-wrap tw:items-center tw:justify-between tw:gap-4">
                            <div class="tw:flex tw:items-center tw:gap-3">
                                <img src="@Model.LatestInteractionOtherUserProfileImage" alt="@Model.LatestInteractionOtherUserFullName" class="tw:size-14 tw:rounded-full tw:border-2 tw:border-sb-ink tw:object-cover tw:shadow-sb-small tw:dark:border-sb-border-card" />
                                <div>
                                    <h3 class="tw:text-xl tw:font-black">@Model.LatestInteractionOtherUserFullName</h3>
                                    <p class="tw:mt-1 tw:text-sm tw:text-sb-muted">Status: <span class="tw:font-extrabold tw:text-sb-ink">@Model.LatestInteractionStatus</span>@(isOneWay ? " · One-way mentorship" : "")</p>
                                </div>
                            </div>
                            <a class="tw:inline-flex tw:min-h-10 tw:items-center tw:rounded-xl tw:border-2 tw:border-sb-border-control tw:bg-sb-sage tw:px-4 tw:py-2 tw:font-extrabold tw:text-sb-ink tw:shadow-sb-small tw:transition-transform tw:hover:translate-x-[2px] tw:hover:translate-y-[2px]" href="@Url.Action("Sessions", "Interactions", new { id = Model.LatestInteractionId })">View stages ↗</a>
                        </div>
                        <div class="tw:mt-5 tw:grid tw:grid-cols-1 tw:items-center tw:gap-3 tw:md:grid-cols-[1fr_auto_1fr]">
                            <div class="tw:rounded-xl tw:border-2 tw:border-sb-border-card tw:bg-sb-sage tw:p-4">
                                <span class="tw:text-xs tw:font-black tw:uppercase tw:tracking-[.12em]">You're teaching</span>
                                <p class="tw:mt-1 tw:text-lg tw:font-black">@(string.IsNullOrWhiteSpace(Model.LatestInteractionSkillYouTeach) ? "None (1-way mentorship)" : Model.LatestInteractionSkillYouTeach)</p>
                            </div>
                            <span class="tw:justify-self-center tw:text-3xl tw:font-black" aria-hidden="true">@(isOneWay ? "→" : "↔")</span>
                            <div class="tw:rounded-xl tw:border-2 tw:border-sb-border-card tw:bg-sb-blue tw:p-4">
                                <span class="tw:text-xs tw:font-black tw:uppercase tw:tracking-[.12em]">You're learning</span>
                                <p class="tw:mt-1 tw:text-lg tw:font-black">@(string.IsNullOrWhiteSpace(Model.LatestInteractionSkillYouLearn) ? "None (1-way mentorship)" : Model.LatestInteractionSkillYouLearn)</p>
                            </div>
                        </div>
                    </article>
                }
                else
                {
                    <div class="tw:flex tw:flex-wrap tw:items-center tw:justify-between tw:gap-4 tw:rounded-2xl tw:border-2 tw:border-dashed tw:border-sb-border-card tw:bg-sb-card tw:p-6"><div><span class="tw:text-3xl" aria-hidden="true">↔</span><h3 class="tw:mt-2 tw:text-xl tw:font-black">Your next exchange is out there.</h3><p class="tw:mt-1 tw:text-sb-muted">Find someone whose skills complement yours.</p></div><a class="tw:inline-flex tw:min-h-11 tw:items-center tw:rounded-xl tw:border-2 tw:border-sb-border-control tw:bg-sb-blue-strong tw:px-5 tw:py-3 tw:font-extrabold tw:text-white tw:shadow-sb-small tw:transition-transform tw:hover:translate-x-[2px] tw:hover:translate-y-[2px]" href="@Url.Action("Index", "Explore")">Find a partner ↗</a></div>
                }
            </section>

            <section aria-labelledby="latest-posts-heading"><div class="tw:mb-5"><span class="tw:text-xs tw:font-black tw:uppercase tw:tracking-[.15em] tw:text-sb-blue-strong tw:dark:text-sb-blue-link">From your communities / 03</span><h2 id="latest-posts-heading" class="tw:mt-1 tw:text-3xl tw:font-black tw:tracking-[-.04em]">Latest community posts</h2></div>
                <div class="tw:grid tw:grid-cols-1 tw:gap-4 tw:md:grid-cols-2">
                    @if (Model.MyLatestPost != null)
                    {
                        <article class="tw:rounded-xl tw:border-2 tw:border-sb-border-card tw:bg-sb-card tw:p-5 tw:shadow-sb-small"><span class="tw:text-xs tw:font-black tw:uppercase tw:tracking-[.12em]">Your post</span><h3 class="tw:mt-2 tw:text-xl tw:font-black">@Model.MyLatestPost.Title</h3><p class="tw:mt-2 tw:line-clamp-3 tw:text-sb-muted">@Model.MyLatestPost.Content</p><small class="tw:mt-4 block tw:font-bold">Posted @Model.MyLatestPost.CreatedAt.ToString("MMM dd, yyyy")</small></article>
                    }
                    @if (Model.OtherLatestPost != null)
                    {
                        <article class="tw:rounded-xl tw:border-2 tw:border-sb-border-card tw:bg-sb-blue tw:p-5 tw:shadow-sb-small"><span class="tw:text-xs tw:font-black tw:uppercase tw:tracking-[.12em]">From the community</span><h3 class="tw:mt-2 tw:text-xl tw:font-black">@Model.OtherLatestPost.Title</h3><p class="tw:mt-2 tw:line-clamp-3 tw:text-sb-muted">@Model.OtherLatestPost.Content</p><small class="tw:mt-4 block tw:font-bold">Posted @Model.OtherLatestPost.CreatedAt.ToString("MMM dd, yyyy")</small></article>
                    }
                    @if (Model.MyLatestPost == null && Model.OtherLatestPost == null)
                    {
                        <div class="tw:rounded-xl tw:border-2 tw:border-dashed tw:border-sb-border-card tw:bg-sb-card tw:p-6"><span class="tw:text-3xl" aria-hidden="true">✎</span><h3 class="tw:mt-2 tw:text-xl tw:font-black">The conversation is waiting.</h3><p class="tw:mt-1 tw:text-sb-muted">Drop into a community and share what you are learning.</p><a class="tw:mt-3 tw:inline-flex tw:py-1 tw:font-extrabold tw:text-sb-blue-strong tw:underline tw:dark:text-sb-blue-link" href="@Url.Action("Index", "Communities")">Community Feed ↗</a></div>
                    }
                    else if (Model.MyLatestPost == null || Model.OtherLatestPost == null)
                    {
                        <aside class="tw:relative tw:overflow-hidden tw:rounded-xl tw:border-2 tw:border-sb-border-card tw:bg-sb-sage tw:p-5 tw:shadow-sb-small"><span class="tw:absolute tw:right-5 tw:top-4 tw:grid tw:size-12 tw:rotate-6 tw:place-items-center tw:rounded-full tw:border-2 tw:border-sb-border-card tw:bg-sb-coral tw:text-2xl tw:shadow-sb-small tw:dark:bg-sb-coral-rich">✳</span><span class="tw:text-xs tw:font-black tw:uppercase tw:tracking-[.12em]">Keep exploring</span><h3 class="tw:mt-2 tw:pr-14 tw:text-xl tw:font-black">More ideas are waiting in your communities.</h3><p class="tw:mt-2 tw:max-w-lg tw:text-sb-muted">See what other members are sharing, or add your own perspective.</p><a class="tw:mt-4 tw:inline-flex tw:min-h-10 tw:items-center tw:rounded-lg tw:border-2 tw:border-sb-border-control tw:bg-sb-card tw:px-4 tw:py-2 tw:font-extrabold tw:text-sb-ink tw:shadow-sb-small tw:transition-transform tw:hover:translate-x-[2px] tw:hover:translate-y-[2px] tw:dark:bg-sb-surface-raised tw:dark:text-sb-night-ink" href="@Url.Action("Index", "Communities")">Community Feed ↗</a></aside>
                    }
                </div>
            </section>
        </div>
    }
</main>
