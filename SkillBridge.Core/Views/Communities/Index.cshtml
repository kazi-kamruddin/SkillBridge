@model SkillBridge.Models.CommunityIndexViewModel
@{
    ViewBag.Title = "Communities";
}
<main class="container my-5 sb-community-directory">
    <header class="sb-page-heading sb-community-hero">
        <span class="sb-eyebrow">Learn out loud</span>
        <h1>Find your people.</h1>
        <p>Every skill has a conversation. Explore ideas, ask questions, and grow alongside people learning the same thing.</p>
        @if (Model.IsGuest)
        {
            <div class="sb-hero-actions">
                <a class="btn btn-primary" href="@Url.Action("Register", "Account")">Join SkillBridge</a>
                <span class="sb-community-hint">Read freely. Add a skill to your profile to join in.</span>
            </div>
        }
    </header>
    <form method="get" action="@Url.Action("Index", "Communities")" class="sb-directory-search" role="search">
        <div><label for="community-search" class="form-label fw-bold">Search communities</label><input id="community-search" class="form-control" name="q" value="@Model.SearchQuery" maxlength="100" placeholder="Try a skill or category" /></div>
        <button class="btn btn-primary" type="submit">Search</button>
    </form>
    @if (!Model.SkillsYouKnow.Any() && !Model.SkillsYouWantToLearn.Any() && !Model.OtherCommunities.Any())
    {
        <div class="alert alert-info">@(string.IsNullOrEmpty(Model.SearchQuery) ? "Communities are being prepared." : "No communities match that search.") <a href="@Url.Action("Skills", "Explore")">Browse skills</a>.</div>
    }
    @if (Model.SkillsYouKnow.Any())
    {
        <section class="sb-community-section" aria-labelledby="known-heading">
            <div class="sb-section-heading"><span class="sb-section-number">01</span><h2 id="known-heading">Skills you know</h2></div>
            <div class="sb-community-grid">
                @foreach (var c in Model.SkillsYouKnow)
                {
                    <a href="@Url.Action("Landing", "Communities", new { id = c.CommunityId })" class="sb-community-card sb-community-card-known"><span class="sb-community-card-label">SHARE WHAT YOU KNOW</span><strong>@c.SkillName</strong><span aria-hidden="true" class="sb-community-arrow">↗</span></a>
                }
            </div>
        </section>
    }
    @if (Model.SkillsYouWantToLearn.Any())
    {
        <section class="sb-community-section" aria-labelledby="learning-heading">
            <div class="sb-section-heading"><span class="sb-section-number">02</span><h2 id="learning-heading">Skills you want to learn</h2></div>
            <div class="sb-community-grid">
                @foreach (var c in Model.SkillsYouWantToLearn)
                {
                    <a href="@Url.Action("Landing", "Communities", new { id = c.CommunityId })" class="sb-community-card sb-community-card-learning"><span class="sb-community-card-label">KEEP GETTING BETTER</span><strong>@c.SkillName</strong><span aria-hidden="true" class="sb-community-arrow">↗</span></a>
                }
            </div>
        </section>
    }
    @if (Model.OtherCommunities.Any())
    {
        <section class="sb-community-section" aria-labelledby="other-heading">
            <div class="sb-section-heading"><span class="sb-section-number">@(Model.IsGuest ? "01" : "03")</span><h2 id="other-heading">@(Model.IsGuest ? "Browse communities" : "More communities")</h2></div>
            <div class="sb-community-grid">
                @foreach (var c in Model.OtherCommunities)
                {
                    <a href="@Url.Action("Landing", "Communities", new { id = c.CommunityId })" class="sb-community-card"><span class="sb-community-card-label">EXPLORE THE CONVERSATION</span><strong>@c.SkillName</strong><span aria-hidden="true" class="sb-community-arrow">↗</span></a>
                }
            </div>
        </section>
    }
</main>
