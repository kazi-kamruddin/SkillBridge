@model SkillBridge.Models.CommunityIndexViewModel
@{
    ViewBag.Title = "Communities";
}
<main class="container my-5 sb-community-directory">
    <header class="sb-page-heading sb-community-hero">
        <span class="sb-eyebrow">Learn out loud</span>
        <h1>Find your people.</h1>
        <p>Every skill has a conversation. Explore ideas, ask questions, and grow alongside people learning the same thing.</p>
        @if (Model.IsGuest)
        {
            <div class="sb-hero-actions">
                <a class="btn btn-primary" href="@Url.Action("Register", "Account")">Join SkillBridge</a>
                <span class="sb-community-hint">Read freely. Add a skill to your profile to join in.</span>
            </div>
        }
    </header>
    <form method="get" action="@Url.Action("Index", "Communities")" class="sb-directory-search" role="search">
        <div><label for="community-search" class="form-label fw-bold">Search communities</label><input id="community-search" class="form-control" name="q" value="@Model.SearchQuery" maxlength="100" placeholder="Try a skill or category" /></div>
        <button class="btn btn-primary" type="submit">Search</button>
    </form>
    @if (!Model.SkillsYouKnow.Any() && !Model.SkillsYouWantToLearn.Any() && !Model.OtherCommunities.Any())
    {
        <div class="alert alert-info">@(string.IsNullOrEmpty(Model.SearchQuery) ? "Communities are being prepared." : "No communities match that search.") <a href="@Url.Action("Skills", "Explore")">Browse skills</a>.</div>
    }
    @{
        var communities = Model.SkillsYouKnow.Select(c => new { Community = c, Kind = "known", Label = "YOU TEACH" })
            .Concat(Model.SkillsYouWantToLearn.Select(c => new { Community = c, Kind = "learning", Label = "YOU LEARN" }))
            .Concat(Model.OtherCommunities.Select(c => new { Community = c, Kind = "explore", Label = "EXPLORE" }))
            .GroupBy(item => string.IsNullOrWhiteSpace(item.Community.CategoryName) ? "More skills" : item.Community.CategoryName)
            .OrderBy(group => group.Key).ToList();
        var categoryIndex = 0;
    }
    @foreach (var category in communities)
    {
        categoryIndex++;
        var categoryName = category.Key.ToLowerInvariant();
        var icon = categoryName.Contains("design") || categoryName.Contains("art") ? "fa-palette"
            : categoryName.Contains("program") || categoryName.Contains("tech") || categoryName.Contains("software") ? "fa-code"
            : categoryName.Contains("language") || categoryName.Contains("communication") ? "fa-language"
            : categoryName.Contains("business") || categoryName.Contains("management") ? "fa-briefcase"
            : categoryName.Contains("science") || categoryName.Contains("math") ? "fa-flask" : "fa-shapes";
        <details class="sb-community-category" open>
            <summary><span class="sb-category-symbol" aria-hidden="true"><i class="fas @icon"></i></span><span class="sb-category-title"><span class="sb-eyebrow">CATEGORY @categoryIndex.ToString("00")</span><strong>@category.Key</strong></span><span class="sb-category-count">@category.Count() communities</span><span class="sb-category-toggle" aria-hidden="true">⌄</span></summary>
            <div class="sb-community-grid">
                @foreach (var item in category)
                {
                    <a href="@Url.Action("Landing", "Communities", new { id = item.Community.CommunityId })" class="sb-community-card sb-community-card-@item.Kind"><span class="sb-community-card-top"><span class="sb-community-monogram" aria-hidden="true">@(item.Community.SkillName.Trim()[0])</span><span class="sb-community-card-label">@item.Label</span></span><strong>@item.Community.SkillName</strong><span class="sb-community-card-bottom">Open community <span aria-hidden="true">↗</span></span></a>
                }
            </div>
        </details>
    }
</main>
