@model SkillBridge.Models.CommunityIndexViewModel
@{
    ViewBag.Title = "Communities";
}
<main class="container tw:mx-auto tw:w-full tw:max-w-[1400px] tw:px-4 my-4 tw:my-6 sb-community-directory">
    <header class="sb-page-heading sb-community-hero">
        <div class="sb-hero-kicker"><span class="sb-icon-tile sb-icon-tile-blue" aria-hidden="true"><svg class="sb-icon"><use href="#sb-i-chat" /></svg></span><span class="sb-eyebrow">Learn out loud</span></div>
        <h1>Find your people.</h1>
        <p>Every skill has a conversation. Explore ideas, ask questions, and grow alongside people learning the same thing.</p>
        @if (Model.IsGuest)
        {
            <div class="sb-hero-actions">
                <a class="btn tw:inline-flex tw:items-center tw:justify-center tw:gap-2 tw:rounded-xl tw:border-2 tw:border-sb-ink tw:px-4 tw:py-2 tw:font-extrabold tw:shadow-sb-small tw:transition-transform tw:hover:translate-x-[2px] tw:hover:translate-y-[2px] tw:dark:border-sb-night-ink btn-primary tw:bg-sb-blue-strong tw:text-white" href="@Url.Action("Register", "Account")">Join SkillBridge</a>
                <span class="sb-community-hint">Read freely. Add a skill to your profile to join in.</span>
            </div>
        }
    </header>
    <form method="get" action="@Url.Action("Index", "Communities")" class="sb-directory-search" role="search">
        <div><label for="community-search" class="form-label tw:mb-1 tw:block tw:font-bold fw-bold">Search communities</label><input id="community-search" class="form-control tw:min-h-11 tw:w-full tw:rounded-lg tw:border-2 tw:border-sb-muted/40 tw:bg-sb-card tw:px-3 tw:py-2 tw:text-sb-ink tw:focus:border-sb-blue-strong tw:focus:outline-none tw:focus:ring-2 tw:focus:ring-sb-blue/70 tw:dark:border-sb-night-ink/50 tw:dark:bg-sb-night-card tw:dark:text-sb-night-ink" name="q" value="@Model.SearchQuery" maxlength="100" placeholder="Try a skill or category" /></div>
        <button class="btn tw:inline-flex tw:items-center tw:justify-center tw:gap-2 tw:rounded-xl tw:border-2 tw:border-sb-ink tw:px-4 tw:py-2 tw:font-extrabold tw:shadow-sb-small tw:transition-transform tw:hover:translate-x-[2px] tw:hover:translate-y-[2px] tw:dark:border-sb-night-ink btn-primary tw:bg-sb-blue-strong tw:text-white" type="submit">Search</button>
    </form>
    @if (!Model.SkillsYouKnow.Any() && !Model.SkillsYouWantToLearn.Any() && !Model.OtherCommunities.Any())
    {
        <div class="alert tw:rounded-xl tw:border-2 tw:border-sb-ink tw:p-4 tw:shadow-sb-small alert-info tw:bg-sb-blue tw:text-sb-ink">@(string.IsNullOrEmpty(Model.SearchQuery) ? "Communities are being prepared." : "No communities match that search.") <a href="@Url.Action("Skills", "Explore")">Browse skills</a>.</div>
    }
    @{
        var communities = Model.SkillsYouKnow.Select(c => new { Community = c, Kind = "known", Label = "YOU TEACH" })
            .Concat(Model.SkillsYouWantToLearn.Select(c => new { Community = c, Kind = "learning", Label = "YOU LEARN" }))
            .Concat(Model.OtherCommunities.Select(c => new { Community = c, Kind = "explore", Label = "EXPLORE" }))
            .GroupBy(item => string.IsNullOrWhiteSpace(item.Community.CategoryName) ? "More skills" : item.Community.CategoryName)
            .OrderBy(group => group.Key).ToList();
        var categoryIndex = 0;
    }
    @foreach (var category in communities)
    {
        categoryIndex++;
        var categoryName = category.Key.ToLowerInvariant();
        var symbol = categoryName.Contains("design") || categoryName.Contains("art") ? "✦"
            : categoryName.Contains("program") || categoryName.Contains("tech") || categoryName.Contains("software") ? "</>"
            : categoryName.Contains("language") || categoryName.Contains("communication") ? "文"
            : categoryName.Contains("business") || categoryName.Contains("management") ? "▣"
            : categoryName.Contains("science") || categoryName.Contains("math") ? "⚗" : "✳";
        <details class="sb-community-category" open>
            <summary><span class="sb-category-symbol" aria-hidden="true">@symbol</span><span class="sb-category-title"><span class="sb-eyebrow">CATEGORY @categoryIndex.ToString("00")</span><strong>@category.Key</strong></span><span class="sb-category-count">@category.Count() communities</span><span class="sb-category-toggle" aria-hidden="true">⌄</span></summary>
            <div class="sb-community-grid">
                @foreach (var item in category)
                {
                    <a href="@Url.Action("Landing", "Communities", new { id = item.Community.CommunityId })" class="sb-community-card sb-community-card-@item.Kind"><span class="sb-community-card-top"><span class="sb-community-monogram" aria-hidden="true">@(item.Community.SkillName.Trim()[0])</span><span class="sb-community-card-label">@item.Label</span></span><strong>@item.Community.SkillName</strong><span class="sb-community-card-bottom">Open community <span aria-hidden="true">↗</span></span></a>
                }
            </div>
        </details>
    }
</main>
