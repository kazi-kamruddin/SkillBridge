
@model SkillBridge.Models.PostDetailsViewModel
@{
    ViewBag.Title = Model.Title;
}

<main class="container my-5">
    @if (TempData["CommunityNotice"] is string notice)
    {
        <div class="alert alert-info" role="status">@notice</div>
    }
    <!-- Post Header -->
    <div class="card shadow-sm border-0 mb-4">
        <div class="card-body">
            <h2 class="fw-bold">@Model.Title</h2>
            <p class="text-muted mb-3">
                by <strong>@Model.CreatedByUserName</strong> on @Model.CreatedAt.ToString("MMM dd, yyyy HH:mm")
            </p>
            <p class="fs-5">@Model.Content</p>
            @if (!string.IsNullOrWhiteSpace(Model.ImageUrl)) { <img src="@Model.ImageUrl" alt="Image attached to this post" class="img-fluid rounded mb-3 sb-community-image" loading="lazy" /> }
            @if (User.Identity.IsAuthenticated)
            {
                <details class="mt-3">
                    <summary>Report this post</summary>
                    <form action="@Url.Action("Report", "Communities")" method="post" class="mt-2">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="postId" value="@Model.PostId" />
                        <label class="form-label" for="post-report-reason">Reason for report</label>
                        <textarea id="post-report-reason" name="reason" class="form-control mb-2" maxlength="500" required></textarea>
                        <button class="btn btn-outline-danger btn-sm" type="submit">Send report</button>
                    </form>
                </details>
            }
        </div>
    </div>

    <!-- Comments Section -->
    <section class="comments">
        <h4 class="mb-3">Comments (@Model.Comments.Count)</h4>

        @if (Model.Comments.Any())
        {
            foreach (var c in Model.Comments.OrderBy(c => c.CreatedAt))
            {
                <div class="comment-card d-flex align-items-start p-3 mb-3 rounded">
                    <div class="comment-avatar me-3">
                        <i class="fas fa-user-circle fa-2x text-secondary"></i>
                    </div>
                    <div class="comment-body flex-grow-1">
                        <p class="mb-1">@c.Content</p>
                        @if (!string.IsNullOrWhiteSpace(c.ImageUrl)) { <img src="@c.ImageUrl" alt="Image attached to this comment" class="img-fluid rounded mb-2 sb-community-image" loading="lazy" /> }
                        <small class="text-muted">@c.CreatedByFullName, @c.CreatedAt.ToString("MMM dd, yyyy HH:mm")</small>
                        @if (User.Identity.IsAuthenticated)
                        {
                            <details class="mt-2">
                                <summary>Report comment</summary>
                                <form action="@Url.Action("Report", "Communities")" method="post" class="mt-2">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="postId" value="@Model.PostId" />
                                    <input type="hidden" name="commentId" value="@c.CommentId" />
                                    <label class="form-label" for="comment-report-@c.CommentId">Reason for report</label>
                                    <textarea id="comment-report-@c.CommentId" name="reason" class="form-control mb-2" maxlength="500" required></textarea>
                                    <button class="btn btn-outline-danger btn-sm" type="submit">Send report</button>
                                </form>
                            </details>
                        }
                    </div>
                </div>
            }
        }
        else
        {
            <div class="alert alert-light border">No comments yet. Be the first!</div>
        }
    </section>

    <!-- Add Comment Form -->
    @if (Model.IsMember)
    {
        <section class="comment-form mt-4">
            <h5 class="mb-3">Add a Comment</h5>
            <p class="text-muted small">Comments can be read by signed-out visitors.</p>

            <form action="@Url.Action("CreateComment", "Communities")" method="post" enctype="multipart/form-data" class="card p-3 shadow-sm border-0">
                @Html.AntiForgeryToken()
                <input type="hidden" name="PostId" value="@Model.PostId" />

                <div class="mb-3">
                    <textarea name="Content" class="form-control" placeholder="Write your comment..." rows="3" maxlength="1000"></textarea>
                    @Html.ValidationMessage("Content", "", new { @class = "text-danger small" })
                </div>
                <div class="mb-3"><label for="comment-image" class="form-label">Add an image (optional, up to 5 MB)</label><input type="file" id="comment-image" name="Image" class="form-control" accept="image/jpeg,image/png,image/webp" /></div>

                <div class="text-end">
                    <button type="submit" class="btn btn-primary">
                        <i class="fas fa-paper-plane me-1"></i> Submit
                    </button>
                </div>
            </form>
        </section>
    }
    else if (!User.Identity.IsAuthenticated)
    {
        <p class="mt-4">Want to join the conversation? <a href="@Url.Action("Register", "Account")">Create an account</a> or <a href="@Url.Action("Login", "Account")">log in</a>.</p>
    }
    else
    {
        <p class="mt-4">Add this skill to your profile to post or comment in this community. <a href="@Url.Action("UpdateProfile", "Profile")">Update your skills</a>.</p>
    }
</main>

@section Styles {
    <style>
        .comment-card {
            background: #f8f9fa;
            border: 1px solid #e5e5e5;
            transition: background 0.2s ease;
        }

            .comment-card:hover {
                background: #f1f3f5;
            }

        .comment-avatar {
            flex-shrink: 0;
        }

        .comment-body {
            font-size: 0.95rem;
        }
        .sb-community-image { display: block; max-height: 480px; object-fit: contain; }
    </style>
}

@section Scripts {
    <script src="~/Scripts/jquery.validate.min.js"></script>
<script src="~/Scripts/jquery.validate.unobtrusive.min.js"></script>
}
