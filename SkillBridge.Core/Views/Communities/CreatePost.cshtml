
@model SkillBridge.Models.CommunityPostCreateModel
@{
    ViewBag.Title = "Create Post";
}

<main class="container my-5 sb-post-editor-page">
    <header class="sb-page-heading sb-post-editor-hero"><span class="sb-eyebrow">A PLACE TO THINK OUT LOUD</span><h1>Start a conversation.</h1><p>Ask a question, share a breakthrough, or show what you are making.</p></header>
    <div class="sb-post-editor-layout">
        <div class="card sb-post-editor-card">
                <div class="card-body p-4">
                    <span class="sb-eyebrow">NEW COMMUNITY POST / 01</span>
                    <h2 class="h3 mt-2 mb-3">What is on your mind?</h2>
                    <p class="text-muted small">Community posts can be read by signed-out visitors. Avoid sharing private contact details.</p>
                    @using (Html.BeginForm("CreatePost", "Communities", FormMethod.Post, new { enctype = "multipart/form-data" }))
                    {
                        @Html.AntiForgeryToken()
                        @Html.HiddenFor(m => m.CommunityId)

                        <!-- Title -->
                        <div class="mb-3">
                            @Html.LabelFor(m => m.Title, new { @class = "form-label fw-bold" })
                            @Html.TextBoxFor(m => m.Title, new { @class = "form-control form-control-lg", placeholder = "Give your post a clear title...", maxlength = "200" })
                            @Html.ValidationMessageFor(m => m.Title, "", new { @class = "text-danger small" })
                        </div>

                        <!-- Content -->
                        <div class="mb-3">
                            @Html.LabelFor(m => m.Content, new { @class = "form-label fw-bold" })
                            <div class="sb-editor-toolbar" role="toolbar" aria-label="Post formatting">
                                <button type="button" data-format="bold" aria-label="Bold selected text" title="Bold"><strong>B</strong></button>
                                <button type="button" data-format="italic" aria-label="Italic selected text" title="Italic"><em>I</em></button>
                                <button type="button" data-format="heading" aria-label="Turn line into heading" title="Heading">H2</button>
                            </div>
                            @Html.TextAreaFor(m => m.Content, 8, 60, new { @class = "form-control sb-editor-textarea", placeholder = "Share your idea, question, or progress...", maxlength = "2000" })
                            <p class="form-text">Bold, italic, and headings are available. New lines stay as you write them.</p>
                            @Html.ValidationMessageFor(m => m.Content, "", new { @class = "text-danger small" })
                        </div>
                        <div class="mb-3">
                            <label for="Image" class="form-label fw-bold">Image (optional, up to 5 MB)</label>
                            <input type="file" id="Image" name="Image" class="form-control" accept="image/jpeg,image/png,image/webp" />
                            @Html.ValidationMessageFor(m => m.Image, "", new { @class = "text-danger small" })
                        </div>

                        <!-- Buttons -->
                        <div class="d-flex justify-content-end mt-4">
                            <a href="@Url.Action("Landing", "Communities", new { id = Model.CommunityId })" class="btn btn-outline-secondary me-2">
                                Cancel
                            </a>
                            <button type="submit" class="btn btn-primary">
                                <i class="bi bi-send-fill me-1"></i> Create Post
                            </button>
                        </div>
                    }
                </div>
        </div>
        <aside class="sb-post-editor-aside" aria-label="Writing tips"><span aria-hidden="true" class="sb-editor-spark">✳</span><span class="sb-eyebrow">GOOD POSTS START HERE</span><h2>Make it easy to join in.</h2><p>A specific question or example gives others something useful to respond to.</p><div class="sb-editor-example"><span>EXAMPLE PROMPT</span><strong>“What helped you get past the first stage?”</strong></div></aside>
    </div>
</main>

@section Scripts {
    <script src="~/Scripts/jquery.validate.min.js"></script>
<script src="~/Scripts/jquery.validate.unobtrusive.min.js"></script>
<script>
document.querySelectorAll('.sb-editor-toolbar button').forEach(button => button.addEventListener('click', () => {
    const editor = document.getElementById('Content');
    const start = editor.selectionStart;
    const end = editor.selectionEnd;
    const selected = editor.value.slice(start, end);
    const kind = button.dataset.format;
    let replacement;
    if (kind === 'heading') {
        const lineStart = editor.value.lastIndexOf('\n', start - 1) + 1;
        if (editor.value.slice(lineStart, lineStart + 3) === '## ') return;
        editor.setRangeText('## ', lineStart, lineStart, 'preserve');
        editor.focus();
        return;
    }
    const mark = kind === 'bold' ? '**' : '*';
    replacement = mark + (selected || 'your text') + mark;
    editor.setRangeText(replacement, start, end, 'select');
    editor.focus();
}));
</script>
}
