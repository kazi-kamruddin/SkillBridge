@model SkillBridge.Models.CompleteProfileViewModel
@using System.Linq
@{
    ViewBag.Title = "Complete Your Profile";

    var expandOptionalDetails = !ViewData.ModelState.IsValid
        || Model.Age.HasValue
        || !string.IsNullOrWhiteSpace(Model.Profession)
        || !string.IsNullOrWhiteSpace(Model.Location)
        || !string.IsNullOrWhiteSpace(Model.Bio)
        || Model.IsPublic
        || (Model.SkillsToLearn?.Any() ?? false)
        || (Model.SkillsIKnow?.Any() ?? false);

    var boardModel = new SkillBridge.Models.SkillSelectionBoardViewModel
    {
        FormId = "completeProfileForm",
        AllSkillCategories = Model.AllSkillCategories ?? new List<SkillBridge.Models.SkillCategory>(),
        SkillsToLearn = Model.SkillsToLearn ?? new List<int>(),
        KnownSkillStages = (Model.SkillsIKnow ?? new List<SkillBridge.Models.CompleteProfileViewModel.UserKnownSkill>())
            .GroupBy(s => s.SkillId)
            .ToDictionary(g => g.Key, g => g.First().KnownUpToStage),
        VerifiedLearningStages = new Dictionary<int, int>()
    };
}

@section Styles {
    <link rel="stylesheet" href="~/Styles/indexCompleteProfile.css" />
}

<main aria-labelledby="title" class="tw:my-8">
    <h2 id="title">@ViewBag.Title</h2>
    <p class="text-muted tw:text-sb-muted tw:dark:text-sb-night-ink/70">Add your name and optional details, or skip for now to browse members, join communities, and start conversations right away.</p>

    @using (Html.BeginForm("Index", "CompleteProfile", FormMethod.Post, new { @id = "completeProfileForm", enctype = "multipart/form-data" }))
    {
        @Html.AntiForgeryToken()
        @Html.ValidationSummary(false, "", new { @class = "sb-validation-summary" })

        <h4>Basic Information</h4>
        <div class="form-group tw:mb-4 mb-3">
            @Html.LabelFor(m => m.FullName, new { @class = "form-label tw:mb-1 tw:block tw:font-bold" })
            @Html.TextBoxFor(m => m.FullName, new { @class = "form-control tw:min-h-11 tw:w-full tw:rounded-lg tw:border-2 tw:border-sb-border-control tw:bg-sb-surface-sunken tw:px-3 tw:py-2 tw:text-sb-ink tw:focus:border-sb-border-focus tw:focus:outline-none", placeholder = "Full Name" })
            @Html.ValidationMessageFor(m => m.FullName, "", new { @class = "sb-field-error" })
        </div>

        <div class="form-group tw:mb-4 mb-3">
            <label for="ProfileImage" class="form-label tw:mb-1 tw:block tw:font-bold">Profile photo (optional, up to 3 MB)</label>
            <div class="sb-avatar-picker" data-sb-avatar-picker>
                <input type="file"
                       id="ProfileImage"
                       name="ProfileImage"
                       data-sb-avatar-input
                       data-sb-avatar-max-bytes="3145728"
                       class="form-control tw:min-h-11 tw:w-full tw:rounded-lg tw:border-2 tw:border-sb-border-control tw:bg-sb-surface-sunken tw:px-3 tw:py-2 tw:text-sb-ink tw:focus:border-sb-border-focus tw:focus:outline-none"
                       accept="image/jpeg,image/png,image/webp" />
                <div class="sb-avatar-client-error" data-sb-avatar-error hidden role="alert"></div>
                <div class="sb-avatar-preview" data-sb-avatar-preview hidden>
                    <div class="sb-avatar-preview-slot" data-sb-avatar-img-slot></div>
                    <div class="sb-avatar-preview-meta">
                        <span class="sb-avatar-preview-name" data-sb-avatar-name></span>
                        <span class="sb-avatar-preview-size" data-sb-avatar-size></span>
                    </div>
                    <button type="button" class="sb-avatar-clear-btn tw:min-h-10" data-sb-avatar-clear hidden>Remove</button>
                </div>
            </div>
            @Html.ValidationMessageFor(m => m.ProfileImage, "", new { @class = "sb-field-error" })
        </div>

        <details class="mb-4 tw:mb-6 p-3 tw:p-4 rounded tw:rounded-xl border tw:border-2 tw:border-sb-border-card tw:bg-sb-card tw:shadow-sb-small" open="@expandOptionalDetails">
            <summary class="fw-semibold tw:font-semibold tw:cursor-pointer">Add more details and skills now (optional)</summary>
            <p class="text-muted tw:text-sb-muted tw:dark:text-sb-night-ink/70 mt-3 tw:mt-4">Add skills you want to learn, skills you can teach, or both—whenever you are ready.</p>

            <div class="form-group tw:mb-4 mb-3">
                @Html.LabelFor(m => m.Age, new { @class = "form-label tw:mb-1 tw:block tw:font-bold" })
                @Html.TextBoxFor(m => m.Age, new { @class = "form-control tw:min-h-11 tw:w-full tw:rounded-lg tw:border-2 tw:border-sb-border-control tw:bg-sb-surface-sunken tw:px-3 tw:py-2 tw:text-sb-ink tw:focus:border-sb-border-focus tw:focus:outline-none", type = "number", min = "1", placeholder = "Age" })
                @Html.ValidationMessageFor(m => m.Age, "", new { @class = "sb-field-error" })
            </div>
            <div class="form-group tw:mb-4 mb-3">
                @Html.LabelFor(m => m.Profession, new { @class = "form-label tw:mb-1 tw:block tw:font-bold" })
                @Html.DropDownListFor(m => m.Profession,
                    new SelectList(new[]
                    {
                        "Student","Teacher","Software Developer","Engineer","Designer","Freelancer","Entrepreneur"
                    }, Model.Profession),
                    "Select Profession",
                    new { @class = "form-control tw:min-h-11 tw:w-full tw:rounded-lg tw:border-2 tw:border-sb-border-control tw:bg-sb-surface-sunken tw:px-3 tw:py-2 tw:text-sb-ink tw:focus:border-sb-border-focus tw:focus:outline-none" })
            </div>
            <div class="form-group tw:mb-4 mb-3">
                @Html.LabelFor(m => m.Location, new { @class = "form-label tw:mb-1 tw:block tw:font-bold" })
                @Html.DropDownListFor(m => m.Location,
                    new SelectList(new[]
                    {
                        "Barishal","Chattogram","Dhaka","Khulna","Rajshahi","Rangpur","Mymensingh","Sylhet"
                    }, Model.Location),
                    "Select Location",
                    new { @class = "form-control tw:min-h-11 tw:w-full tw:rounded-lg tw:border-2 tw:border-sb-border-control tw:bg-sb-surface-sunken tw:px-3 tw:py-2 tw:text-sb-ink tw:focus:border-sb-border-focus tw:focus:outline-none" })
            </div>
            <div class="form-group tw:mb-4 mb-3">
                @Html.LabelFor(m => m.Bio, new { @class = "form-label tw:mb-1 tw:block tw:font-bold" })
                @Html.TextAreaFor(m => m.Bio, 4, 50, new { @class = "form-control tw:min-h-11 tw:w-full tw:rounded-lg tw:border-2 tw:border-sb-border-control tw:bg-sb-surface-sunken tw:px-3 tw:py-2 tw:text-sb-ink tw:focus:border-sb-border-focus tw:focus:outline-none", placeholder = "Short Bio" })
            </div>

            <div class="form-check tw:flex tw:items-start tw:gap-3 mb-3 tw:mb-4">
                @Html.CheckBoxFor(m => m.IsPublic, new { @class = "form-check-input tw:mt-0.5 tw:accent-sb-blue-strong" })
                <div>
                    @Html.LabelFor(m => m.IsPublic, "Allow signed-out visitors to view my profile", new { @class = "form-check-label tw:font-semibold tw:cursor-pointer" })
                    <div class="form-text tw:mt-1 tw:block tw:text-sm tw:text-sb-muted tw:dark:text-sb-night-ink/70">Your name, location, profession, bio, skills and ratings will be public. Your email and age stay private.</div>
                </div>
            </div>

            <hr class="tw:my-6 tw:border-sb-border-card" />
            <partial name="_SkillSelectionBoard" model="boardModel" />
        </details>

        <div class="mt-4 tw:mt-6 tw:flex tw:flex-wrap tw:items-center tw:gap-3">
            <button type="submit" class="btn tw:inline-flex tw:min-h-11 tw:items-center tw:justify-center tw:gap-2 tw:rounded-xl tw:border-2 tw:border-sb-border-control tw:px-5 tw:py-2.5 tw:font-extrabold tw:shadow-sb-small tw:transition-transform tw:hover:translate-x-[2px] tw:hover:translate-y-[2px] btn-success tw:bg-sb-sage-deep tw:text-white" id="proceedButton">Create my space</button>
            <button type="submit" form="skipProfileForm" id="skipOnboardingButton" class="btn tw:inline-flex tw:min-h-11 tw:items-center tw:justify-center tw:gap-2 tw:rounded-xl tw:border-2 tw:border-sb-border-control tw:bg-sb-card tw:px-5 tw:py-2.5 tw:font-extrabold tw:text-sb-ink tw:shadow-sb-small tw:transition-transform tw:hover:translate-x-[2px] tw:hover:translate-y-[2px] tw:dark:bg-sb-night-card tw:dark:text-sb-night-ink">Skip for now</button>
        </div>
    }
    <form id="skipProfileForm" method="post" action="@Url.Action("Skip", "CompleteProfile")" class="tw:hidden">
        @Html.AntiForgeryToken()
    </form>
</main>

@section Scripts {
    <script src="~/Scripts/jquery.validate.min.js"></script>
    <script src="~/Scripts/jquery.validate.unobtrusive.min.js"></script>
    <script src="~/Scripts/skill-selection-board.js" asp-append-version="true"></script>

    <script>
        $(document).ready(function () {
            var $form = $("#completeProfileForm");
            $form.submit(function (e) {
                e.preventDefault();
                $form.find(".invalid-feedback").remove();
                $form.find(".is-invalid").removeClass("is-invalid");

                var firstInvalidField = null;
                function markInvalid($field, message) {
                    if (!firstInvalidField) firstInvalidField = $field;
                    $field.addClass("is-invalid");
                    if ($field.next(".invalid-feedback").length === 0) {
                        $("<div class='invalid-feedback'>" + message + "</div>").insertAfter($field);
                    }
                }

                if (!$.trim($form.find("input[name='FullName']").val())) {
                    markInvalid($("input[name='FullName']"), "Full Name is required");
                }
                var age = $form.find("input[name='Age']").val();
                if (age && parseInt(age, 10) <= 0) {
                    markInvalid($("input[name='Age']"), "Enter a valid age");
                }

                var photoInput = document.getElementById("ProfileImage");
                if (photoInput && photoInput.files && photoInput.files[0] && photoInput.files[0].size > 3145728) {
                    var photoErr = document.querySelector("[data-sb-avatar-error]");
                    if (photoErr) {
                        photoErr.textContent = "Choose an image up to 3 MB.";
                        photoErr.hidden = false;
                    }
                    firstInvalidField = firstInvalidField || $(photoInput);
                }

                if (firstInvalidField) {
                    $('html, body').animate({ scrollTop: firstInvalidField.offset().top - 110 }, 300);
                    return false;
                }

                this.submit();
            });
        });
    </script>
}
