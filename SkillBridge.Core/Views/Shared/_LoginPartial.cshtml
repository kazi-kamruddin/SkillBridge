@using SkillBridge.Helpers
@using SkillBridge.Models
@inject ApplicationDbContext ProfileDb

@if (User.Identity.IsAuthenticated)
{
    <li class="nav-item tw:list-none">
        <a class="nav-link tw:flex tw:items-center" href="@Url.Action("Index", "Profile")" title="Manage">
            @{ var navProfile = ProfileDb.UserInformations.FirstOrDefault(info => info.UserId == User.Identity.GetUserId()); }
            <img src="@ProfileImageHelper.GetProfileImage(navProfile?.ProfileImageUrl, navProfile?.FullName)"
                 alt="Profile Image" class="tw:rounded-full" width="40" height="40" />
        </a>
    </li>
    <li class="nav-item tw:list-none">
        <button type="button" class="nav-link sb-more-toggle" data-ui-toggle="modal"
                data-ui-target="#logoutModal" aria-haspopup="dialog">Log off</button>
    </li>
}
else
{
    <li class="nav-item tw:list-none">@Html.ActionLink("Register", "Register", "Account", routeValues: null, htmlAttributes: new { id = "registerLink", @class = "nav-link tw:inline-flex tw:items-center tw:justify-center tw:rounded-full tw:px-3 tw:py-2 tw:font-bold" })</li>
    <li class="nav-item tw:list-none">@Html.ActionLink("Log in", "Login", "Account", routeValues: null, htmlAttributes: new { id = "loginLink", @class = "nav-link tw:inline-flex tw:items-center tw:justify-center tw:rounded-full tw:px-3 tw:py-2 tw:font-bold" })</li>
}
