                    </li>

                </ul>
            </div>
        </div>
    </nav>

    <main id="main-content" class="main-content">
        <div class="container tw:mx-auto tw:w-full tw:max-w-[1400px] tw:px-4">
            @RenderBody()
        </div>
    </main>

    <footer>
        <div class="container tw:mx-auto tw:w-full tw:max-w-[1400px] tw:px-4">
            <div class="footer-content">
                <div class="footer-brand">
                    <h3><i class="fas fa-bridge me-2 tw:me-2"></i>SkillBridge</h3>
                    <p>Connecting talent with opportunity through skill sharing and community collaboration.</p>
                </div>
                <div class="footer-links">
                    <div class="footer-links-column">
                        <h4>Explore</h4>
                        <ul>
                            <li><a href="@Url.Action("Index", "Explore")">Skills Directory</a></li>
                            @if (User.Identity.IsAuthenticated)
                            {
                                <li><a href="@Url.Action("Index", "Interactions")">Interactions</a></li>
                            }
                            <li><a href="@Url.Action("Index", "Communities")">Communities</a></li>
                        </ul>
                    </div>
                    <div class="footer-links-column">
                        <h4>Company</h4>
                        <ul>
                            <li><a href="@Url.Action("About", "Home")">About Us</a></li>
                            <li><a href="@Url.Action("Contact", "Home")">Contact</a></li>
                        </ul>
                    </div>
                    <div class="footer-links-column">
                        <h4>Support</h4>
                        <ul>
                            <li><a href="@Url.Action("ForgotPassword", "Account")">Password Help</a></li>
