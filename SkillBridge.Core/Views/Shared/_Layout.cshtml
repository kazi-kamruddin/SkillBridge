    <script src="~/Scripts/jquery-3.7.0.min.js"></script>
    <script src="~/Scripts/signalr.min.js"></script>

    @RenderSection("scripts", required: false)

    <script>
        // Small site-owned interaction layer; visual styling lives in Tailwind and app CSS.
        function closeSkillBridgeModal(modal, returnFocus) {
            modal.classList.remove('is-open');
            modal.setAttribute('aria-hidden', 'true');
            if (returnFocus && modal._returnFocusElement) modal._returnFocusElement.focus();
        }

        document.addEventListener('click', function (event) {
            const toggle = event.target.closest('[data-ui-toggle]');
            if (toggle) {
                const type = toggle.dataset.uiToggle;
                if (type === 'collapse') {
                    const target = document.querySelector(toggle.dataset.uiTarget);
                    if (target) {
                        const isOpen = target.classList.toggle('is-open');
                        toggle.setAttribute('aria-expanded', String(isOpen));
                    }
                } else if (type === 'dropdown') {
                    const menu = toggle.parentElement.querySelector('.sb-more-menu');
                    if (menu) {
                        menu.hidden = !menu.hidden;
                        toggle.setAttribute('aria-expanded', String(!menu.hidden));
                    }
                } else if (type === 'modal') {
                    const modal = document.querySelector(toggle.dataset.uiTarget);
                    if (modal) {
                        modal._returnFocusElement = toggle;
                        modal.classList.add('is-open');
                        modal.setAttribute('aria-hidden', 'false');
                        modal.setAttribute('aria-modal', 'true');
                        modal.querySelector('.sb-modal-close, [data-ui-dismiss="modal"]')?.focus();
                    }
                }
                return;
            }

            const dismiss = event.target.closest('[data-ui-dismiss="modal"]');
            if (dismiss) {
                const modal = dismiss.closest('.sb-modal');
                if (modal) closeSkillBridgeModal(modal, true);
                return;
            }

            document.querySelectorAll('.sb-more-menu:not([hidden])').forEach(function (menu) {
                if (!menu.parentElement.contains(event.target)) {
                    menu.hidden = true;
                    menu.parentElement.querySelector('[data-ui-toggle="dropdown"]')?.setAttribute('aria-expanded', 'false');
                }
            });
        });

        document.addEventListener('keydown', function (event) {
            const openModal = document.querySelector('.sb-modal.is-open');
            if (openModal && event.key === 'Tab') {
                const focusable = Array.from(openModal.querySelectorAll('button:not([disabled]), a[href], input:not([disabled]), select:not([disabled]), textarea:not([disabled]), [tabindex]:not([tabindex="-1"])'));
                if (focusable.length) {
                    const first = focusable[0];
                    const last = focusable[focusable.length - 1];
                    if (event.shiftKey && document.activeElement === first) { event.preventDefault(); last.focus(); }
                    else if (!event.shiftKey && document.activeElement === last) { event.preventDefault(); first.focus(); }
                }
            }
            if (event.key === 'Escape') {
                document.querySelectorAll('.sb-modal.is-open').forEach(function (modal) {
                    closeSkillBridgeModal(modal, true);
                });
                document.querySelectorAll('.sb-more-menu:not([hidden])').forEach(function (menu) {
                    menu.hidden = true;
                    menu.parentElement.querySelector('[data-ui-toggle="dropdown"]')?.setAttribute('aria-expanded', 'false');
                });
            }
        });

        $(function () {
            function updateNotifBadge() {
                if ('@User.Identity.IsAuthenticated' === 'True') {
                    $.get('@Url.Action("GetNotifications", "Notifications")', function (data) {
                        var badge = $("#notifBadge");
                        if (data.unreadCount > 0) {
                            badge.text(data.unreadCount).show();
                            badge.addClass('pulse');
                            setTimeout(() => badge.removeClass('pulse'), 500);
                        } else {
                            badge.hide();
                        }
                    }).fail(function() {
                        console.log("Failed to fetch notifications");
                    });
                }
            }

            updateNotifBadge();
            setInterval(updateNotifBadge, 15000);
            if ('@User.Identity.IsAuthenticated' === 'True') {
                function updateMessageBadge() {
                    $.get('@Url.Action("UnreadCount", "Messages")', function (data) {
                        var badge = $('#messageBadge');
                        if (data.count > 0) badge.text(data.count).show();
                        else badge.hide();
                    });
                }
                updateMessageBadge();
                setInterval(updateMessageBadge, 15000);
            }
        });

        $(function () {
            const body = $("body");
            const toggleBtn = $("#themeToggle");
            const icon = toggleBtn.find("i");
            const prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;

            function initTheme() {
                const savedTheme = localStorage.getItem("theme");

                if (savedTheme === "dark" || (!savedTheme && prefersDark)) {
                    enableDarkMode();
                } else {
                    enableLightMode();
                }
            }

            function enableDarkMode() {
                body.attr("data-theme", "dark");
                localStorage.setItem("theme", "dark");
                icon.removeClass("fa-moon").addClass("fa-sun");
                toggleBtn.attr("title", "Switch to Light Mode");
            }

            function enableLightMode() {
                body.removeAttr("data-theme");
                localStorage.setItem("theme", "light");
                icon.removeClass("fa-sun").addClass("fa-moon");
                toggleBtn.attr("title", "Switch to Dark Mode");
            }

            toggleBtn.on("click", function () {
                if (body.attr("data-theme") === "dark") {
                    enableLightMode();
                } else {
                    enableDarkMode();
                }
            });

            initTheme();

            window.matchMedia('(prefers-color-scheme: dark)').addEventListener('change', e => {
                if (!localStorage.getItem("theme")) {
                    if (e.matches) {
                        enableDarkMode();
                    } else {
                        enableLightMode();
                    }
                }
            });
        });

        $(document).ready(function() {
            const currentPath = window.location.pathname.replace(/\/$/, '').toLowerCase() || '/';
            const section = currentPath.split('/')[1];
            $('.sb-nav a[href]').each(function() {
                const linkPath = new URL(this.href, window.location.href).pathname.replace(/\/$/, '').toLowerCase() || '/';
                const sameSection = section && ['explore', 'communities', 'interactions', 'messages', 'savedprofiles'].includes(section)
                    && section === linkPath.split('/')[1];
                if (currentPath === linkPath || sameSection) {
                    $(this).closest('.nav-item').addClass('active');
                    if ($(this).hasClass('dropdown-item')) $(this).closest('.dropdown').addClass('active');
                }
            });
        });
    </script>
</body>
</html>
