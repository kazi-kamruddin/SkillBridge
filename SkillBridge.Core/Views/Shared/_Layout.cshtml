<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <script>
        (function () {
            try {
                var saved = localStorage.getItem('theme');
                var prefersDark = window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)').matches;
                if (saved === 'dark' || (!saved && prefersDark)) {
                    document.documentElement.setAttribute('data-theme', 'dark');
                    document.documentElement.classList.add('dark');
                } else {
                    document.documentElement.removeAttribute('data-theme');
                    document.documentElement.classList.remove('dark');
                }
            } catch (e) { }
        })();
    </script>
    <title>@ViewBag.Title - SkillBridge</title>
    <link rel="icon" type="image/svg+xml" href="~/favicon.svg" asp-append-version="true" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
    @RenderSection("Styles", required: false)
    <link rel="stylesheet" href="~/Content/skillbridge-refresh.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/Content/skillbridge-overhaul.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/Content/tailwind-app.css" asp-append-version="true" />
</head>
<body>
    <svg xmlns="http://www.w3.org/2000/svg" aria-hidden="true" focusable="false" style="position:absolute;width:0;height:0;overflow:hidden">
        <symbol id="sb-i-people" viewBox="0 0 24 24"><circle cx="9" cy="8" r="3"/><path d="M3 20v-2a6 6 0 0 1 12 0v2z"/><path d="M17 5a3 3 0 0 1 0 6m1 4a5 5 0 0 1 3 5"/></symbol>
        <symbol id="sb-i-chat" viewBox="0 0 24 24"><path d="M4 4h16v12H9l-5 4z"/><path d="M8 9h8m-8 3h5"/></symbol>
        <symbol id="sb-i-compass" viewBox="0 0 24 24"><circle cx="12" cy="12" r="9"/><path d="m15.7 8.3-2.1 5.3-5.3 2.1 2.1-5.3z"/></symbol>
        <symbol id="sb-i-spark" viewBox="0 0 24 24"><path d="m12 2 1.9 8.1L22 12l-8.1 1.9L12 22l-1.9-8.1L2 12l8.1-1.9z"/></symbol>
    </svg>
    <a class="sb-skip-link" href="#main-content">Skip to content</a>
    <nav class="sb-nav" aria-label="Main navigation">
        <div class="container tw:mx-auto tw:w-full tw:max-w-[1400px] tw:px-4 sb-nav-shell">
            <button class="sb-menu-toggle" type="button" data-ui-toggle="collapse" data-ui-target="#navbarContent"
                    aria-controls="navbarContent" aria-expanded="false" aria-label="Toggle navigation">
                <svg class="sb-nav-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M4 6h16M4 12h16M4 18h16" /></svg><span class="ms-2 tw:ms-2">Menu</span>
            </button>
            <a class="navbar-brand sb-brand" href="@Url.Action("Index", "Home")" aria-label="SkillBridge home">Skill<span>Bridge</span><span class="sb-brand-spark" aria-hidden="true">✳</span></a>
            <div class="sb-nav-content" id="navbarContent">
                <ul class="navbar-nav sb-nav-primary tw:flex tw:items-center tw:gap-1 tw:m-0 tw:list-none tw:p-0">
                    <li class="nav-item tw:list-none">@Html.ActionLink("Explore", "Index", "Explore", new { area = "" }, new { @class = "nav-link tw:inline-flex tw:items-center tw:justify-center tw:rounded-full tw:px-3 tw:py-2 tw:font-bold" })</li>
                    <li class="nav-item tw:list-none">@Html.ActionLink("Community Feed", "Index", "Communities", new { area = "" }, new { @class = "nav-link tw:inline-flex tw:items-center tw:justify-center tw:rounded-full tw:px-3 tw:py-2 tw:font-bold" })</li>
                    @if (User.Identity.IsAuthenticated)
                    {
                        <li class="nav-item tw:list-none">@Html.ActionLink("Interactions", "Index", "Interactions", new { area = "" }, new { @class = "nav-link tw:inline-flex tw:items-center tw:justify-center tw:rounded-full tw:px-3 tw:py-2 tw:font-bold" })</li>
                        <li class="nav-item tw:list-none"><a class="nav-link tw:inline-flex tw:items-center tw:justify-center tw:rounded-full tw:px-3 tw:py-2 tw:font-bold" href="@Url.Action("Index", "Messages")">Messages <span id="messageBadge" class="badge tw:items-center tw:rounded-full tw:border tw:border-sb-ink tw:px-2.5 tw:py-1 tw:text-xs tw:font-bold tw:bg-sb-coral" style="display:none;"></span></a></li>
                    }
                </ul>

                <ul class="navbar-nav sb-nav-secondary tw:flex tw:items-center tw:gap-1 tw:m-0 tw:list-none tw:p-0">
                    @if (User.Identity.IsAuthenticated)
                    {
                        <li class="nav-item tw:list-none">@Html.ActionLink("Saved", "Index", "SavedProfiles", new { area = "" }, new { @class = "nav-link tw:inline-flex tw:items-center tw:justify-center tw:rounded-full tw:px-3 tw:py-2 tw:font-bold" })</li>
                    }
                    <li class="nav-item dropdown tw:list-none">
                        <button class="nav-link sb-more-toggle tw:inline-flex tw:items-center tw:justify-center tw:rounded-full tw:px-3 tw:py-2 tw:font-bold" type="button" data-ui-toggle="dropdown" aria-expanded="false" aria-controls="moreMenu">More</button>
                        <ul class="sb-more-menu" id="moreMenu" hidden>
                            <li><a class="dropdown-item tw:block tw:rounded-lg tw:px-3 tw:py-2 tw:font-bold" href="@Url.Action("HowItWorks", "Home")">How It Works</a></li>
                            <li><a class="dropdown-item tw:block tw:rounded-lg tw:px-3 tw:py-2 tw:font-bold" href="@Url.Action("About", "Home")">About</a></li>
                            <li><a class="dropdown-item tw:block tw:rounded-lg tw:px-3 tw:py-2 tw:font-bold" href="@Url.Action("Contact", "Home")">Contact</a></li>
                            @if (User.Identity.IsAuthenticated && !string.IsNullOrWhiteSpace(Environment.GetEnvironmentVariable("SKILLBRIDGE_MODERATOR_EMAIL")) &&
                                 string.Equals(User.Identity.Name, Environment.GetEnvironmentVariable("SKILLBRIDGE_MODERATOR_EMAIL"), StringComparison.OrdinalIgnoreCase))
                            {
                                <li><a class="dropdown-item tw:block tw:rounded-lg tw:px-3 tw:py-2 tw:font-bold" href="@Url.Action("Index", "Moderation")">Reports</a></li>
                            }
                        </ul>
                    </li>
                    <partial name="_LoginPartial" />

                    @if (User.Identity.IsAuthenticated)
                    {
                        <li class="nav-item tw:list-none">
                            <a class="nav-link sb-notification-link tw:inline-flex tw:items-center tw:justify-center" href="@Url.Action("Index", "Notifications")" title="Notifications">
                                <svg class="sb-nav-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M18 8a6 6 0 0 0-12 0c0 7-3 7-3 9h18c0-2-3-2-3-9"/><path d="M10 21h4"/></svg>
                                <span id="notifBadge" class="notification-badge badge tw:items-center tw:rounded-full tw:border tw:border-sb-ink tw:px-2.5 tw:py-1 tw:text-xs tw:font-bold bg-danger tw:bg-sb-coral sb-notification-badge" style="display:none;"></span>
                            </a>
                        </li>
                    }

                    <li class="nav-item tw:list-none">
                        <button id="themeToggle" type="button" class="btn tw:inline-flex tw:items-center tw:justify-center tw:gap-2 tw:rounded-xl tw:border-2 tw:border-sb-ink tw:p-0 tw:font-extrabold tw:shadow-sb-small tw:transition-transform tw:hover:translate-x-[2px] tw:hover:translate-y-[2px] tw:dark:border-sb-night-ink theme-toggle" title="Toggle Dark/Light Mode" aria-label="Toggle color theme">
                            <svg class="sb-nav-icon sb-moon-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 15.5A8.5 8.5 0 0 1 8.5 4 8.5 8.5 0 1 0 20 15.5Z"/></svg>
                            <svg class="sb-nav-icon sb-sun-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="4"/><path d="M12 2v2m0 16v2M4.93 4.93l1.42 1.42m11.3 11.3 1.42 1.42M2 12h2m16 0h2M4.93 19.07l1.42-1.42m11.3-11.3 1.42-1.42"/></svg>
                        </button>
                    </li>

                </ul>
            </div>
        </div>
    </nav>

    @if (User.Identity.IsAuthenticated)
    {
        <partial name="_LogoutModal" />
    }

    <main id="main-content" class="main-content">
        <div class="container tw:mx-auto tw:w-full tw:max-w-[1400px] tw:px-4">
            @RenderBody()
        </div>
    </main>

    <footer>
        <div class="container tw:mx-auto tw:w-full tw:max-w-[1400px] tw:px-4">
            <div class="footer-content">
                <div class="footer-brand">
                    <h3><i class="fas fa-bridge me-2 tw:me-2"></i>SkillBridge</h3>
                    <p>Connecting talent with opportunity through skill sharing and community collaboration.</p>
                </div>
                <div class="footer-links">
                    <div class="footer-links-column">
                        <h4>Explore</h4>
                        <ul>
                            <li><a href="@Url.Action("Index", "Explore")">Skills Directory</a></li>
                            @if (User.Identity.IsAuthenticated)
                            {
                                <li><a href="@Url.Action("Index", "Interactions")">Interactions</a></li>
                            }
                            <li><a href="@Url.Action("Index", "Communities")">Community Feed</a></li>
                        </ul>
                    </div>
                    <div class="footer-links-column">
                        <h4>Company</h4>
                        <ul>
                            <li><a href="@Url.Action("About", "Home")">About Us</a></li>
                            <li><a href="@Url.Action("Contact", "Home")">Contact</a></li>
                        </ul>
                    </div>
                    <div class="footer-links-column">
                        <h4>Support</h4>
                        <ul>
                            <li><a href="@Url.Action("ForgotPassword", "Account")">Password Help</a></li>
                            <li><a href="https://github.com/kazi-kamruddin/SkillBridge/issues" rel="noopener noreferrer">Report an Issue</a></li>
                        </ul>
                    </div>
                </div>
            </div>
            <div class="footer-bottom">
                <div class="copyright">
                    <p>&copy; @DateTime.Now.Year - SkillBridge. All rights reserved.</p>
                </div>
            </div>
        </div>
    </footer>

    <script src="~/Scripts/jquery-3.7.0.min.js"></script>
    <script src="~/Scripts/signalr.min.js"></script>

    @RenderSection("scripts", required: false)

    <script>
        // Small site-owned interaction layer; visual styling lives in Tailwind and app CSS.
        // Show / Hide Password toggle
        document.addEventListener('click', function (event) {
            const toggleBtn = event.target.closest('.sb-password-toggle');
            if (!toggleBtn) return;

            event.preventDefault();
            const group = toggleBtn.closest('.input-group');
            if (!group) return;

            const input = group.querySelector('input');
            if (!input) return;

            const eyeIcon = toggleBtn.querySelector('.sb-eye-icon');
            const eyeOffIcon = toggleBtn.querySelector('.sb-eye-off-icon');

            if (input.type === 'password') {
                input.type = 'text';
                toggleBtn.setAttribute('aria-label', 'Hide password');
                toggleBtn.setAttribute('title', 'Hide password');
                if (eyeIcon) eyeIcon.classList.add('tw:hidden');
                if (eyeOffIcon) eyeOffIcon.classList.remove('tw:hidden');
            } else {
                input.type = 'password';
                toggleBtn.setAttribute('aria-label', 'Show password');
                toggleBtn.setAttribute('title', 'Show password');
                if (eyeIcon) eyeIcon.classList.remove('tw:hidden');
                if (eyeOffIcon) eyeOffIcon.classList.add('tw:hidden');
            }
        });

        // Smooth sliding & morphing transition between Login and Register
        (function () {
            let isTransitioning = false;

            async function switchAuthPage(targetUrl, direction) {
                if (isTransitioning) return;
                isTransitioning = true;

                const currentScreen = document.querySelector('.sb-auth-screen');
                const currentCard = currentScreen?.querySelector('.sb-auth-card');
                if (!currentScreen || !currentCard) {
                    window.location.href = targetUrl;
                    return;
                }

                try {
                    const fetchPromise = fetch(targetUrl, {
                        headers: { 'X-Requested-With': 'XMLHttpRequest' }
                    }).then(res => {
                        if (!res.ok) throw new Error('Network error');
                        return res.text();
                    });

                    const animClass = direction === 'register' ? 'is-switching-to-register' : 'is-switching-to-login';
                    currentCard.classList.add(animClass);

                    const [html] = await Promise.all([
                        fetchPromise,
                        new Promise(resolve => setTimeout(resolve, 360))
                    ]);

                    const parser = new DOMParser();
                    const doc = parser.parseFromString(html, 'text/html');
                    const newCard = doc.querySelector('.sb-auth-card');
                    const newTitle = doc.title;

                    if (!newCard) {
                        window.location.href = targetUrl;
                        return;
                    }

                    newCard.classList.add('is-incoming');
                    currentCard.replaceWith(newCard);

                    requestAnimationFrame(() => {
                        newCard.classList.add('is-incoming-active');
                        setTimeout(() => {
                            newCard.classList.remove('is-incoming', 'is-incoming-active');
                            isTransitioning = false;
                        }, 260);
                    });

                    if (window.location.pathname.toLowerCase() !== new URL(targetUrl, window.location.href).pathname.toLowerCase()) {
                        window.history.pushState({ authPage: true }, '', targetUrl);
                    }
                    if (newTitle) {
                        document.title = newTitle;
                    }

                    if (window.jQuery && window.jQuery.validator && window.jQuery.validator.unobtrusive) {
                        window.jQuery.validator.unobtrusive.parse('form');
                    }
                } catch (err) {
                    window.location.href = targetUrl;
                }
            }

            document.addEventListener('click', function (e) {
                const switchLink = e.target.closest('.sb-auth-switch-link');
                if (!switchLink) return;

                if (e.metaKey || e.ctrlKey || e.shiftKey) return;

                e.preventDefault();
                const targetUrl = switchLink.getAttribute('href');
                const targetType = switchLink.getAttribute('data-auth-target') ||
                    (targetUrl.toLowerCase().includes('register') ? 'register' : 'login');
                switchAuthPage(targetUrl, targetType);
            });

            window.addEventListener('popstate', function () {
                const path = window.location.pathname.toLowerCase();
                if (path.includes('/account/login')) {
                    switchAuthPage(window.location.href, 'login');
                } else if (path.includes('/account/register')) {
                    switchAuthPage(window.location.href, 'register');
                }
            });
        })();

        function closeSkillBridgeModal(modal, returnFocus) {
            modal.classList.remove('is-open');
            modal.setAttribute('aria-hidden', 'true');
            if (returnFocus && modal._returnFocusElement) modal._returnFocusElement.focus();
        }

        document.addEventListener('click', function (event) {
            const toggle = event.target.closest('[data-ui-toggle]');
            if (toggle) {
                const type = toggle.dataset.uiToggle;
                if (type === 'collapse') {
                    const target = document.querySelector(toggle.dataset.uiTarget);
                    if (target) {
                        const isOpen = target.classList.toggle('is-open');
                        toggle.setAttribute('aria-expanded', String(isOpen));
                    }
                } else if (type === 'dropdown') {
                    const menu = toggle.parentElement.querySelector('.sb-more-menu');
                    if (menu) {
                        menu.hidden = !menu.hidden;
                        toggle.setAttribute('aria-expanded', String(!menu.hidden));
                    }
                } else if (type === 'modal') {
                    const modal = document.querySelector(toggle.dataset.uiTarget);
                    if (modal) {
                        modal._returnFocusElement = toggle;
                        modal.classList.add('is-open');
                        modal.setAttribute('aria-hidden', 'false');
                        modal.setAttribute('aria-modal', 'true');
                        modal.querySelector('.sb-modal-close, [data-ui-dismiss="modal"]')?.focus();
                    }
                }
                return;
            }

            const dismiss = event.target.closest('[data-ui-dismiss="modal"]');
            if (dismiss) {
                const modal = dismiss.closest('.sb-modal');
                if (modal) closeSkillBridgeModal(modal, true);
                return;
            }

            document.querySelectorAll('.sb-more-menu:not([hidden])').forEach(function (menu) {
                if (!menu.parentElement.contains(event.target)) {
                    menu.hidden = true;
                    menu.parentElement.querySelector('[data-ui-toggle="dropdown"]')?.setAttribute('aria-expanded', 'false');
                }
            });
            const navigation = document.querySelector('.sb-nav');
            const mobileMenu = navigation?.querySelector('.sb-nav-content.is-open');
            if (mobileMenu && !navigation.contains(event.target)) {
                mobileMenu.classList.remove('is-open');
                navigation.querySelector('.sb-menu-toggle')?.setAttribute('aria-expanded', 'false');
            }
        });

        document.addEventListener('keydown', function (event) {
            const openModal = document.querySelector('.sb-modal.is-open');
            if (openModal && event.key === 'Tab') {
                const focusable = Array.from(openModal.querySelectorAll('button:not([disabled]), a[href], input:not([disabled]), select:not([disabled]), textarea:not([disabled]), [tabindex]:not([tabindex="-1"])'));
                if (focusable.length) {
                    const first = focusable[0];
                    const last = focusable[focusable.length - 1];
                    if (event.shiftKey && document.activeElement === first) { event.preventDefault(); last.focus(); }
                    else if (!event.shiftKey && document.activeElement === last) { event.preventDefault(); first.focus(); }
                }
            }
            if (event.key === 'Escape') {
                const mobileMenu = document.querySelector('.sb-nav-content.is-open');
                if (mobileMenu) {
                    mobileMenu.classList.remove('is-open');
                    const menuToggle = document.querySelector('.sb-menu-toggle');
                    menuToggle?.setAttribute('aria-expanded', 'false');
                    menuToggle?.focus();
                }
                document.querySelectorAll('.sb-modal.is-open').forEach(function (modal) {
                    closeSkillBridgeModal(modal, true);
                });
                document.querySelectorAll('.sb-more-menu:not([hidden])').forEach(function (menu) {
                    menu.hidden = true;
                    menu.parentElement.querySelector('[data-ui-toggle="dropdown"]')?.setAttribute('aria-expanded', 'false');
                });
            }
        });

        window.addEventListener('resize', function () {
            if (window.innerWidth >= 1200) {
                document.querySelector('.sb-nav-content.is-open')?.classList.remove('is-open');
                document.querySelector('.sb-menu-toggle')?.setAttribute('aria-expanded', 'false');
            }
        });

        $(function () {
            if ('@User.Identity.IsAuthenticated' === 'True') {
                function updateNotifBadge() {
                    if (document.hidden) return;
                    $.get('@Url.Action("GetNotifications", "Notifications")', function (data) {
                        var badge = $("#notifBadge");
                        if (data && data.unreadCount > 0) {
                            badge.text(data.unreadCount).show();
                            badge.addClass('pulse');
                            setTimeout(() => badge.removeClass('pulse'), 500);
                        } else {
                            badge.hide();
                        }
                    });
                }

                function updateMessageBadge() {
                    if (document.hidden) return;
                    $.get('@Url.Action("UnreadCount", "Messages")', function (data) {
                        var badge = $('#messageBadge');
                        if (data && data.count > 0) badge.text(data.count).show();
                        else badge.hide();
                    });
                }

                function refreshBadges() {
                    updateNotifBadge();
                    updateMessageBadge();
                }

                refreshBadges();
                setInterval(refreshBadges, 60000);
                document.addEventListener('visibilitychange', function () {
                    if (!document.hidden) refreshBadges();
                });
            }
        });

        $(function () {
            const body = $("body");
            const toggleBtn = $("#themeToggle");
            const prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;

            function initTheme() {
                const savedTheme = localStorage.getItem("theme");

                if (savedTheme === "dark" || (!savedTheme && prefersDark)) {
                    enableDarkMode();
                } else {
                    enableLightMode();
                }
            }

            function enableDarkMode() {
                document.documentElement.setAttribute("data-theme", "dark");
                document.documentElement.classList.add("dark");
                body.attr("data-theme", "dark");
                localStorage.setItem("theme", "dark");
                toggleBtn.attr("title", "Switch to Light Mode");
            }

            function enableLightMode() {
                document.documentElement.removeAttribute("data-theme");
                document.documentElement.classList.remove("dark");
                body.removeAttr("data-theme");
                localStorage.setItem("theme", "light");
                toggleBtn.attr("title", "Switch to Dark Mode");
            }

            toggleBtn.on("click", function () {
                if (document.documentElement.getAttribute("data-theme") === "dark" || body.attr("data-theme") === "dark") {
                    enableLightMode();
                } else {
                    enableDarkMode();
                }
            });

            initTheme();

            window.matchMedia('(prefers-color-scheme: dark)').addEventListener('change', e => {
                if (!localStorage.getItem("theme")) {
                    if (e.matches) {
                        enableDarkMode();
                    } else {
                        enableLightMode();
                    }
                }
            });
        });

        $(document).ready(function() {
            const currentPath = window.location.pathname.replace(/\/$/, '').toLowerCase() || '/';
            const section = currentPath.split('/')[1];
            $('.sb-nav a[href]').each(function() {
                const linkPath = new URL(this.href, window.location.href).pathname.replace(/\/$/, '').toLowerCase() || '/';
                const sameSection = section && ['explore', 'communities', 'interactions', 'messages', 'savedprofiles'].includes(section)
                    && section === linkPath.split('/')[1];
                if (currentPath === linkPath || sameSection) {
                    $(this).closest('.nav-item').addClass('active');
                    if ($(this).hasClass('dropdown-item')) $(this).closest('.dropdown').addClass('active');
                }
            });
        });
    </script>
</body>
</html>
