@model List<SkillBridge.Models.MeetingEventViewModel>
@if (Model.Count == 0) { <p class="text-muted tw:text-sb-muted tw:dark:text-sb-night-ink/70">No meeting changes recorded yet.</p> }
else
{
    <ol class="list-group tw:flex tw:flex-col tw:gap-2 list-group-numbered mb-3 tw:mb-4">
        @foreach (var meeting in Model)
        {
            <li class="list-group-item tw:rounded-xl tw:border-2 tw:border-sb-ink tw:bg-sb-card tw:p-4 tw:shadow-sb-small tw:dark:border-sb-night-ink tw:dark:bg-sb-night-card">
                <strong>@meeting.EventType</strong>
                @if (meeting.EventType != "Earlier saved state") { <span>by @(meeting.IsMine ? "you" : "your partner")</span> }
                <span> · @meeting.Format · </span>
                <time class="meeting-time" data-utc="@meeting.StartsAtUtc.ToString("yyyy-MM-ddTHH:mm:ssZ")">@meeting.StartsAtUtc.ToString("yyyy-MM-dd HH:mm") UTC</time>
                @if (!string.IsNullOrWhiteSpace(meeting.Note)) { <div class="small tw:text-sm">@meeting.Note</div> }
            </li>
        }
    </ol>
}
