@{
    ViewBag.Title = "Error";
}

<main class="container tw:mx-auto tw:w-full tw:max-w-[1400px] tw:px-4 sb-account-simple" aria-labelledby="title">
    <div class="sb-account-panel">
        <span class="sb-eyebrow">Something went wrong</span>
        <h1 id="title" class="text-danger tw:text-sb-danger-text">Error.</h1>
        <p class="tw:font-semibold tw:text-sb-ink">An error occurred while processing your request.</p>
        <a class="btn tw:inline-flex tw:min-h-11 tw:items-center tw:justify-center tw:gap-2 tw:rounded-xl tw:border-2 tw:border-sb-border-control tw:px-4 tw:py-2 tw:font-extrabold tw:shadow-sb-small btn-primary tw:bg-sb-blue-strong tw:text-white" href="@Url.Action("Index", "Home")">Return home</a>
    </div>
</main>
