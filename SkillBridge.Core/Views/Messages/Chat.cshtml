@model SkillBridge.Models.Conversation

@using System
@using SkillBridge.Models

@{
    ViewBag.Title = "Messages";

    var messages = ViewBag.Messages as IEnumerable<ChatMessageViewModel>;
    var conversationId = Convert.ToString(ViewBag.ConversationId);
    var otherUserId = ViewBag.OtherUserId;
    var allConversations = ViewBag.AllConversations as IEnumerable<SkillBridge.Models.Conversation>;
    var unreadByConversation = ViewBag.UnreadByConversation as Dictionary<int, int> ?? new Dictionary<int, int>();
    var partnerNames = ViewBag.PartnerNames as Dictionary<string, string> ?? new Dictionary<string, string>();
    var lastMessagePreviews = ViewBag.LastMessagePreviews as Dictionary<int, string> ?? new Dictionary<int, string>();
    var currentUserId = User.Identity.GetUserId();

    var otherUserProfile = ViewBag.OtherUserProfile as ChatPartnerViewModel;
}

<div class="container-fluid tw:w-full tw:px-4 mt-3 tw:mt-4 sb-chat">
    <div class="row tw:grid tw:grid-cols-12 tw:gap-4">
        <!-- Left column: conversation list -->
        <div class="col-md-3 tw:col-span-12 tw:md:col-span-3 border-end sb-chat-list" style="height:80vh; overflow-y:auto;">
            <h5 class="mb-3 tw:mb-4">Conversations</h5>
            <ul class="list-group tw:flex tw:flex-col tw:gap-2">
                @foreach (var convo in allConversations)
                {
                    var partnerId = convo.User1Id == currentUserId ? convo.User2Id : convo.User1Id;

                    <li class="list-group-item tw:rounded-xl tw:border-2 tw:border-sb-ink tw:bg-sb-card tw:p-4 tw:shadow-sb-small tw:dark:border-sb-night-ink tw:dark:bg-sb-night-card @(convo.Id == Model.Id ?"active" : "")" data-conversation-id="@convo.Id">
                        <a class="d-block tw:block text-decoration-none text-dark tw:text-sb-ink tw:dark:text-sb-night-ink @(convo.Id == Model.Id ?"text-white" : "")"
                           href="@Url.Action("Chat", "Messages", new { id = convo.Id })">
                            @(partnerNames.TryGetValue(partnerId, out var partnerName) ? partnerName : "Member")
                            @if (unreadByConversation.TryGetValue(convo.Id, out var unread) && unread > 0)
                            { <span class="badge tw:inline-flex tw:items-center tw:rounded-full tw:border tw:border-sb-ink tw:px-2.5 tw:py-1 tw:text-xs tw:font-bold bg-danger tw:bg-sb-coral conversation-unread">@unread unread</span> }
                            <br />
                            <small class="d-block tw:block text-truncate conversation-preview">@(lastMessagePreviews.TryGetValue(convo.Id, out var preview) ? preview : "No messages yet")</small>
                            <small class="text-muted tw:text-sb-muted tw:dark:text-sb-night-ink/70 conversation-last-activity">@convo.LastMessageAt?.ToString("g")</small>
                        </a>
                    </li>
                }
            </ul>
        </div>

        <!-- Middle column: chat history -->
        <div class="col-md-6 tw:col-span-12 tw:md:col-span-6 d-flex tw:flex flex-column tw:flex-col sb-chat-main" style="height:80vh;">
            <div id="messagePane" class="flex-grow-1 tw:flex-1 border tw:border-2 tw:border-sb-ink p-2 tw:p-2 mb-2 tw:mb-2" style="overflow-y:auto;">
                <h5>@otherUserProfile?.FullName</h5>
                <hr />
                <div id="messageList">
                    @if (messages != null && messages.Any())
                    {
                        foreach (var m in messages)
                        {
                            if (m.IsMine)
                            {
                                <div class="text-end tw:text-right mb-2 tw:mb-2" data-message-id="@m.Id">
                                    @if (!string.IsNullOrWhiteSpace(m.Text)) { <span class="sb-chat-bubble sb-chat-bubble-mine">@m.Text</span> }
                                    @if (m.HasImage) { <a href="@Url.Action("Image", "Messages", new { id = m.Id })" target="_blank" rel="noopener"><img src="@Url.Action("Image", "Messages", new { id = m.Id })" alt="Image sent in chat" class="sb-chat-image" loading="lazy" /></a> }
                                    <br />
                                    <small class="text-muted tw:text-sb-muted tw:dark:text-sb-night-ink/70">@m.CreatedAt · <span class="read-state">@(m.IsRead ? "Read" : "Sent")</span></small>
                                </div>
                            }
                            else
                            {
                                <div class="text-start tw:text-left mb-2 tw:mb-2" data-message-id="@m.Id">
                                    @if (!string.IsNullOrWhiteSpace(m.Text)) { <span class="sb-chat-bubble sb-chat-bubble-other">@m.Text</span> }
                                    @if (m.HasImage) { <a href="@Url.Action("Image", "Messages", new { id = m.Id })" target="_blank" rel="noopener"><img src="@Url.Action("Image", "Messages", new { id = m.Id })" alt="Image sent in chat" class="sb-chat-image" loading="lazy" /></a> }
                                    <br />
                                    <small class="text-muted tw:text-sb-muted tw:dark:text-sb-night-ink/70">@m.CreatedAt</small>
                                </div>
                            }
                        }
                    }
                    else
                    {
                        <p class="text-muted tw:text-sb-muted tw:dark:text-sb-night-ink/70">No messages yet. Start the conversation.</p>
                    }
                </div>
            </div>

            <form id="sendMessageForm" class="d-flex tw:flex align-items-center tw:items-center gap-2 tw:gap-2" method="post" enctype="multipart/form-data" autocomplete="off" action="@Url.Action("Send", "Messages")">
                @Html.AntiForgeryToken()
                @Html.Hidden("conversationId", (string)conversationId)

                <label class="btn tw:inline-flex tw:items-center tw:justify-center tw:gap-2 tw:rounded-xl tw:border-2 tw:border-sb-ink tw:px-4 tw:py-2 tw:font-extrabold tw:shadow-sb-small tw:transition-transform tw:hover:translate-x-[2px] tw:hover:translate-y-[2px] tw:dark:border-sb-night-ink btn-outline-secondary tw:bg-sb-card tw:text-sb-ink mb-0 tw:mb-0" for="chatImage" title="Attach an image">📷</label>
                <input type="file" id="chatImage" name="image" class="visually-hidden" accept="image/jpeg,image/png,image/webp" aria-label="Attach an image (up to 5 MB)" />
                <div class="sb-chat-composer">
                    <div id="chatImagePreview" class="sb-chat-image-preview" hidden>
                        <img id="chatImageThumbnail" alt="Selected image preview" />
                        <span id="chatImageName"></span>
                        <button id="removeChatImage" type="button" class="btn tw:inline-flex tw:items-center tw:justify-center tw:gap-2 tw:rounded-xl tw:border-2 tw:border-sb-ink tw:px-4 tw:py-2 tw:font-extrabold tw:shadow-sb-small tw:transition-transform tw:hover:translate-x-[2px] tw:hover:translate-y-[2px] tw:dark:border-sb-night-ink btn-sm tw:px-3 tw:py-1.5 tw:text-sm btn-outline-secondary tw:bg-sb-card tw:text-sb-ink" aria-label="Remove attached image">Remove</button>
                    </div>
                    <textarea id="messageText" name="messageText" class="form-control tw:min-h-11 tw:w-full tw:rounded-lg tw:border-2 tw:border-sb-muted/40 tw:bg-sb-card tw:px-3 tw:py-2 tw:text-sb-ink tw:focus:border-sb-blue-strong tw:focus:outline-none tw:focus:ring-2 tw:focus:ring-sb-blue/70 tw:dark:border-sb-night-ink/50 tw:dark:bg-sb-night-card tw:dark:text-sb-night-ink" rows="1" maxlength="4000" autocomplete="off" autocorrect="on" spellcheck="true" placeholder="Type your message..."></textarea>
                </div>
                <button type="submit" class="btn tw:inline-flex tw:items-center tw:justify-center tw:gap-2 tw:rounded-xl tw:border-2 tw:border-sb-ink tw:px-4 tw:py-2 tw:font-extrabold tw:shadow-sb-small tw:transition-transform tw:hover:translate-x-[2px] tw:hover:translate-y-[2px] tw:dark:border-sb-night-ink btn-primary tw:bg-sb-blue-strong tw:text-white">Send</button>
            </form>
        </div>

        <!-- Right column: profile info -->
        <div class="col-md-3 tw:col-span-12 tw:md:col-span-3 border-start sb-chat-profile" style="height:80vh; overflow-y:auto;">
            <h5>Profile Info</h5>
            <hr />
            @if (otherUserProfile != null)
            {
                <div class="text-center tw:text-center mb-3 tw:mb-4">
                    <img src="@Url.Content(otherUserProfile.ProfileImageUrl)"
                         class="rounded-circle tw:rounded-full" style="width:100px; height:100px; object-fit:cover;" />
                    <h6 class="mt-2 tw:mt-2">@otherUserProfile.FullName</h6>
                    <p class="text-muted tw:text-sb-muted tw:dark:text-sb-night-ink/70">@otherUserProfile.Profession | @otherUserProfile.Location</p>
                </div>
                <p>@otherUserProfile.Bio</p>
            }
            else
            {
                <p>No profile info available.</p>
            }
        </div>
    </div>
</div>

@section scripts {
    <script>
        $(function () {
            var conversationId = @Model.Id;
            var myId = '@User.Identity.GetUserId()';
            var token = $('#sendMessageForm input[name="__RequestVerificationToken"]').val();
            var imagePreviewUrl = null;
            function updateConversationPreview(text, hasImage, mine, sentAt) {
                var preview = (text || '').trim();
                if (preview) preview = mine ? 'You: ' + preview : preview;
                else if (hasImage) preview = mine ? 'You sent a photo' : 'Photo';
                var item = $('[data-conversation-id="' + conversationId + '"]');
                item.find('.conversation-preview').text(preview || 'No messages yet');
                if (sentAt) item.find('.conversation-last-activity').text(new Date(sentAt).toLocaleString());
                var list = item.parent();
                item.prependTo(list);
            }
            function clearImagePreview(clearInput) {
                if (imagePreviewUrl) URL.revokeObjectURL(imagePreviewUrl);
                imagePreviewUrl = null;
                if (clearInput) $('#chatImage').val('');
                $('#chatImagePreview').prop('hidden', true);
                $('#chatImageThumbnail').removeAttr('src');
                $('#chatImageName').text('');
            }
            function markRead() {
                $.post('@Url.Action("MarkRead", "Messages")',
                    { conversationId: conversationId, __RequestVerificationToken: token })
                    .done(function () {
                        $('[data-conversation-id="' + conversationId + '"] .conversation-unread').remove();
                    });
            }
            markRead();
            const connection = new signalR.HubConnectionBuilder()
                .withUrl('/chatHub')
                .withAutomaticReconnect()
                .build();

            connection.on('receiveMessage', function (msg) {
                if (String(msg.conversationId) !== String(conversationId)) return;

                var mine = msg.fromUserId === myId;
                updateConversationPreview(msg.text, msg.hasImage, mine, msg.sentAt);
                var css = mine ? 'text-end' : 'text-start';
                var bubble = mine ? 'sb-chat-bubble-mine' : 'sb-chat-bubble-other';

                var row = $("<div>").addClass(css + " mb-2").attr("data-message-id", msg.id);
                if (msg.text) $("<span>").addClass("sb-chat-bubble " + bubble).text(msg.text).appendTo(row);
                if (msg.hasImage) {
                    var imageUrl = '@Url.Action("Image", "Messages")?id=' + encodeURIComponent(msg.id);
                    $("<a>").attr({href: imageUrl, target: '_blank', rel: 'noopener'})
                        .append($("<img>").attr({src: imageUrl, alt: 'Image sent in chat'}).addClass('sb-chat-image')).appendTo(row);
                }
                row.append($("<br>"));
                var meta = $("<small>").addClass("text-muted").text(new Date(msg.sentAt).toLocaleString());
                if (mine) meta.append(' · ').append($("<span>").addClass("read-state").text("Sent"));
                row.append(meta);
                $("#messageList").append(row);
                if (!mine) markRead();

                var pane = $("#messagePane");
                pane.scrollTop(pane.prop("scrollHeight"));
            });

            connection.start().then(function () {
                return connection.invoke('JoinConversation', conversationId);
            }).catch(function (error) {
                console.error('Could not connect to chat:', error);
            });

            connection.onreconnected(function () {
                connection.invoke('JoinConversation', conversationId).then(markRead).catch(console.error);
            });

            connection.on('messagesRead', function (event) {
                if (Number(event.conversationId) !== conversationId || event.readerId === myId) return;
                event.messageIds.forEach(function (id) {
                    $('#messageList [data-message-id="' + id + '"] .read-state').text('Read');
                });
            });

            $("#sendMessageForm").submit(function (e) {
                e.preventDefault();

                var $form = $(this);
                if (!$('#messageText').val().trim() && !$('#chatImage')[0].files.length) return;
                var data = new FormData(this);
                $.ajax({ url: $form.attr('action'), method: 'POST', data: data, processData: false, contentType: false })
                    .done(function (result) {
                        updateConversationPreview(result.text, result.hasImage, true, result.sentAt);
                        $("#messageText").val("").trigger('input').focus();
                        clearImagePreview(true);
                    })
                    .fail(function () {
                        alert("Failed to send message.");
                    });
            });
            $('#chatImage').on('change', function () {
                if (imagePreviewUrl) URL.revokeObjectURL(imagePreviewUrl);
                imagePreviewUrl = null;
                if (!this.files.length) { clearImagePreview(false); return; }
                var file = this.files[0];
                imagePreviewUrl = URL.createObjectURL(file);
                $('#chatImageThumbnail').attr('src', imagePreviewUrl);
                $('#chatImageName').text(file.name);
                $('#chatImagePreview').prop('hidden', false);
            });
            $('#removeChatImage').on('click', function () { clearImagePreview(true); });
            $('#messageText').on('input', function () {
                this.style.height = 'auto';
                this.style.height = Math.min(this.scrollHeight, 120) + 'px';
            });
            $(window).on('beforeunload', function () {
                if (imagePreviewUrl) URL.revokeObjectURL(imagePreviewUrl);
            });
        });
    </script>
}

@section Styles { <style>
    .sb-chat-image { display:block; max-width:min(320px, 80%); max-height:320px; object-fit:contain; border-radius:14px; margin:6px 0 4px auto; }
    .text-start .sb-chat-image { margin-left:0; margin-right:auto; }
    .sb-chat-composer { min-width:0; flex:1; padding:.45rem .65rem; background:var(--card-bg); border:1px solid var(--border-color); border-radius:15px; }
    .sb-chat-composer:focus-within { border-color:var(--primary-color); box-shadow:0 0 0 3px rgba(50,77,178,.15); }
    .sb-chat-composer #messageText { display:block; width:100%; min-height:42px; max-height:120px; padding:.55rem .35rem; resize:none; border:0; box-shadow:none; background:transparent; color:var(--text-color); }
    .sb-chat-composer #messageText:focus { border:0; box-shadow:none; }
    .sb-chat-image-preview { display:flex; align-items:center; gap:.75rem; padding:.45rem; margin-bottom:.35rem; background:var(--bg-color); border:1px solid var(--border-color); border-radius:12px; }
    .sb-chat-image-preview[hidden] { display:none; }
    .sb-chat-image-preview img { width:78px; height:62px; object-fit:cover; border-radius:8px; }
    .sb-chat-image-preview span { min-width:0; flex:1; overflow-wrap:anywhere; color:var(--text-color); font-size:.9rem; }
    .sb-chat-image-preview .btn { flex-shrink:0; padding:.35rem .7rem; }
</style> }
