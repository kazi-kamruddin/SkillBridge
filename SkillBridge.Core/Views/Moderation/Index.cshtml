@model SkillBridge.Models.ModerationDashboardViewModel
@{
    ViewBag.Title = "Reports";
}

<main class="container tw:mx-auto tw:w-full tw:max-w-[1400px] tw:px-4 my-5 tw:my-8" aria-labelledby="title">
    <h1 id="title" class="h2 mb-4 tw:mb-6">Reports</h1>
    @if (TempData["ModerationNotice"] is string notice)
    {
        <div class="alert tw:rounded-xl tw:border-2 tw:border-sb-ink tw:p-4 tw:shadow-sb-small alert-success tw:bg-sb-sage tw:text-sb-ink" role="status">@notice</div>
    }
    @if (!Model.CommunityReports.Any() && !Model.ProfileReports.Any())
    {
        <div class="alert tw:rounded-xl tw:border-2 tw:border-sb-ink tw:p-4 tw:shadow-sb-small alert-info tw:bg-sb-blue tw:text-sb-ink">No reports need review.</div>
    }
    else
    {
        @foreach (var report in Model.CommunityReports)
        {
            <article class="card tw:overflow-hidden tw:rounded-2xl tw:border-2 tw:border-sb-ink tw:bg-sb-card tw:text-sb-ink tw:shadow-sb-small tw:dark:border-sb-night-ink tw:dark:bg-sb-night-card tw:dark:text-sb-night-ink mb-3 tw:mb-4">
                <div class="card-body tw:p-5">
                    <h2 class="h5">@report.ContentType report</h2>
                    <p class="mb-1 tw:mb-1"><strong>Content:</strong> @report.ContentPreview</p>
                    <p class="mb-1 tw:mb-1"><strong>Reason:</strong> @report.Reason</p>
                    <p class="small tw:text-sm text-muted tw:text-sb-muted tw:dark:text-sb-night-ink/70">Reported @report.CreatedAt.ToString("MMM dd, yyyy HH:mm")</p>
                    @if (report.PostId.HasValue)
                    {
                        <p><a href="@Url.Action("PostDetails", "Communities", new { id = report.PostId.Value })">View discussion</a></p>
                    }
                    <form method="post" action="@Url.Action("Resolve", "Moderation")" class="tw:inline">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="id" value="@report.Id" />
                        <button type="submit" name="decision" value="Dismissed" class="btn tw:inline-flex tw:items-center tw:justify-center tw:gap-2 tw:rounded-xl tw:border-2 tw:border-sb-ink tw:px-4 tw:py-2 tw:font-extrabold tw:shadow-sb-small tw:transition-transform tw:hover:translate-x-[2px] tw:hover:translate-y-[2px] tw:dark:border-sb-night-ink btn-outline-secondary tw:bg-sb-card tw:text-sb-ink btn-sm tw:px-3 tw:py-1.5 tw:text-sm">Dismiss</button>
                        <button type="submit" name="decision" value="Hidden" class="btn tw:inline-flex tw:items-center tw:justify-center tw:gap-2 tw:rounded-xl tw:border-2 tw:border-sb-ink tw:px-4 tw:py-2 tw:font-extrabold tw:shadow-sb-small tw:transition-transform tw:hover:translate-x-[2px] tw:hover:translate-y-[2px] tw:dark:border-sb-night-ink btn-danger tw:bg-sb-coral tw:text-sb-ink btn-sm tw:px-3 tw:py-1.5 tw:text-sm">Hide content</button>
                    </form>
                </div>
            </article>
        }
        @foreach (var report in Model.ProfileReports)
        {
            <article class="card tw:overflow-hidden tw:rounded-2xl tw:border-2 tw:border-sb-ink tw:bg-sb-card tw:text-sb-ink tw:shadow-sb-small tw:dark:border-sb-night-ink tw:dark:bg-sb-night-card tw:dark:text-sb-night-ink mb-3 tw:mb-4"><div class="card-body tw:p-5">
                <h2 class="h5">Profile report: @report.ReportedName</h2>
                <p><strong>Bio:</strong> @report.ProfileBio</p>
                <p><strong>Reason:</strong> @report.Reason</p>
                <p class="small tw:text-sm text-muted tw:text-sb-muted tw:dark:text-sb-night-ink/70">Reported @report.CreatedAt.ToString("MMM dd, yyyy HH:mm")</p>
                <a href="@Url.Action("PublicProfile", "Profile", new { id = report.ReportedUserId })">View profile</a>
                <form method="post" action="@Url.Action("ResolveProfile", "Moderation")" class="mt-2 tw:mt-2">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="id" value="@report.Id" />
                    <button name="decision" value="Dismissed" class="btn tw:inline-flex tw:items-center tw:justify-center tw:gap-2 tw:rounded-xl tw:border-2 tw:border-sb-ink tw:px-4 tw:py-2 tw:font-extrabold tw:shadow-sb-small tw:transition-transform tw:hover:translate-x-[2px] tw:hover:translate-y-[2px] tw:dark:border-sb-night-ink btn-outline-secondary tw:bg-sb-card tw:text-sb-ink btn-sm tw:px-3 tw:py-1.5 tw:text-sm">Dismiss</button>
                    <button name="decision" value="Reviewed" class="btn tw:inline-flex tw:items-center tw:justify-center tw:gap-2 tw:rounded-xl tw:border-2 tw:border-sb-ink tw:px-4 tw:py-2 tw:font-extrabold tw:shadow-sb-small tw:transition-transform tw:hover:translate-x-[2px] tw:hover:translate-y-[2px] tw:dark:border-sb-night-ink btn-danger tw:bg-sb-coral tw:text-sb-ink btn-sm tw:px-3 tw:py-1.5 tw:text-sm">Hide from discovery</button>
                </form>
            </div></article>
        }
    }
    @if (Model.HiddenProfiles.Any())
    {
        <h2 class="h4 mt-5 tw:mt-8">Profiles hidden from discovery</h2>
        @foreach (var profile in Model.HiddenProfiles)
        {
            <div class="card tw:overflow-hidden tw:rounded-2xl tw:border-2 tw:border-sb-ink tw:bg-sb-card tw:text-sb-ink tw:shadow-sb-small tw:dark:border-sb-night-ink tw:dark:bg-sb-night-card tw:dark:text-sb-night-ink mb-2 tw:mb-2"><div class="card-body tw:p-5 d-flex tw:flex justify-content-between tw:justify-between align-items-center tw:items-center">
                <span>@profile.Name</span>
                <form method="post" action="@Url.Action("RestoreProfile", "Moderation")">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="id" value="@profile.UserId" />
                    <button type="submit" class="btn tw:inline-flex tw:items-center tw:justify-center tw:gap-2 tw:rounded-xl tw:border-2 tw:border-sb-ink tw:px-4 tw:py-2 tw:font-extrabold tw:shadow-sb-small tw:transition-transform tw:hover:translate-x-[2px] tw:hover:translate-y-[2px] tw:dark:border-sb-night-ink btn-outline-primary tw:bg-sb-card tw:text-sb-blue-strong btn-sm tw:px-3 tw:py-1.5 tw:text-sm">Restore</button>
                </form>
            </div></div>
        }
    }
</main>
