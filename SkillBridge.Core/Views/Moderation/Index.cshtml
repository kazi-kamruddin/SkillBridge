@model SkillBridge.Models.ModerationDashboardViewModel
@{
    ViewBag.Title = "Reports";
}

<main class="container my-5" aria-labelledby="title">
    <h1 id="title" class="h2 mb-4">Reports</h1>
    @if (TempData["ModerationNotice"] is string notice)
    {
        <div class="alert alert-success" role="status">@notice</div>
    }
    @if (!Model.CommunityReports.Any() && !Model.ProfileReports.Any())
    {
        <div class="alert alert-info">No reports need review.</div>
    }
    else
    {
        @foreach (var report in Model.CommunityReports)
        {
            <article class="card mb-3">
                <div class="card-body">
                    <h2 class="h5">@report.ContentType report</h2>
                    <p class="mb-1"><strong>Content:</strong> @report.ContentPreview</p>
                    <p class="mb-1"><strong>Reason:</strong> @report.Reason</p>
                    <p class="small text-muted">Reported @report.CreatedAt.ToString("MMM dd, yyyy HH:mm")</p>
                    @if (report.PostId.HasValue)
                    {
                        <p><a href="@Url.Action("PostDetails", "Communities", new { id = report.PostId.Value })">View discussion</a></p>
                    }
                    <form method="post" action="@Url.Action("Resolve", "Moderation")" class="d-inline">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="id" value="@report.Id" />
                        <button type="submit" name="decision" value="Dismissed" class="btn btn-outline-secondary btn-sm">Dismiss</button>
                        <button type="submit" name="decision" value="Hidden" class="btn btn-danger btn-sm">Hide content</button>
                    </form>
                </div>
            </article>
        }
        @foreach (var report in Model.ProfileReports)
        {
            <article class="card mb-3"><div class="card-body">
                <h2 class="h5">Profile report: @report.ReportedName</h2>
                <p><strong>Bio:</strong> @report.ProfileBio</p>
                <p><strong>Reason:</strong> @report.Reason</p>
                <p class="small text-muted">Reported @report.CreatedAt.ToString("MMM dd, yyyy HH:mm")</p>
                <a href="@Url.Action("PublicProfile", "Profile", new { id = report.ReportedUserId })">View profile</a>
                <form method="post" action="@Url.Action("ResolveProfile", "Moderation")" class="mt-2">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="id" value="@report.Id" />
                    <button name="decision" value="Dismissed" class="btn btn-outline-secondary btn-sm">Dismiss</button>
                    <button name="decision" value="Reviewed" class="btn btn-danger btn-sm">Hide from discovery</button>
                </form>
            </div></article>
        }
    }
    @if (Model.HiddenProfiles.Any())
    {
        <h2 class="h4 mt-5">Profiles hidden from discovery</h2>
        @foreach (var profile in Model.HiddenProfiles)
        {
            <div class="card mb-2"><div class="card-body d-flex justify-content-between align-items-center">
                <span>@profile.Name</span>
                <form method="post" action="@Url.Action("RestoreProfile", "Moderation")">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="id" value="@profile.UserId" />
                    <button type="submit" class="btn btn-outline-primary btn-sm">Restore</button>
                </form>
            </div></div>
        }
    }
</main>
