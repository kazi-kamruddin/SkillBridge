@model SkillBridge.Models.InteractionFeedbackViewModel
@{
    ViewBag.Title = "Rate Exchange";
}

<div class="sb-page-shell tw:mx-auto tw:max-w-xl tw:py-6">
    <div class="card tw:rounded-2xl tw:border-2 tw:border-sb-border-card tw:bg-sb-card tw:p-6 tw:text-sb-ink tw:shadow-sb tw:dark:bg-sb-night-card tw:dark:text-sb-night-ink">
        <h1 class="tw:mb-3 tw:text-2xl tw:font-black">You completed an interaction with @Model.RatingModel.FromUserName</h1>

        <div class="tw:mb-4 tw:rounded-xl tw:border-2 tw:border-sb-border-card tw:bg-sb-sage tw:p-4 tw:text-sb-ink">
            @if (string.IsNullOrWhiteSpace(Model.IndexModel.SkillYouLearn))
            {
                <p class="tw:mb-0">One-way mentorship — you taught <strong>@Model.IndexModel.SkillYouTeach</strong></p>
            }
            else if (string.IsNullOrWhiteSpace(Model.IndexModel.SkillYouTeach))
            {
                <p class="tw:mb-0">One-way mentorship — you learned <strong>@Model.IndexModel.SkillYouLearn</strong></p>
            }
            else
            {
                <p class="tw:mb-1">You learned: <strong>@Model.IndexModel.SkillYouLearn</strong></p>
                <p class="tw:mb-0">You taught: <strong>@Model.IndexModel.SkillYouTeach</strong></p>
            }
        </div>

        <form id="rating-form">
            @Html.AntiForgeryToken()
            @Html.Hidden("InteractionId", Model.RatingModel.InteractionId)

            <div class="form-group tw:mb-4">
                <label class="form-label tw:mb-1 tw:block tw:font-bold" for="RatingValue">Rating (1-10):</label>
                <input type="number" class="form-control tw:min-h-11 tw:w-full tw:rounded-lg tw:border-2 tw:border-sb-border-control tw:bg-sb-surface-sunken tw:px-3 tw:py-2 tw:text-sb-ink tw:focus:border-sb-border-focus tw:focus:outline-none tw:focus:ring-2 tw:focus:ring-sb-blue/70" id="RatingValue" name="RatingValue" min="1" max="10" required />
            </div>

            <div class="form-group tw:mb-4">
                <label class="form-label tw:mb-1 tw:block tw:font-bold" for="Comment">Comment (optional):</label>
                <textarea class="form-control tw:min-h-24 tw:w-full tw:rounded-lg tw:border-2 tw:border-sb-border-control tw:bg-sb-surface-sunken tw:px-3 tw:py-2 tw:text-sb-ink tw:focus:border-sb-border-focus tw:focus:outline-none tw:focus:ring-2 tw:focus:ring-sb-blue/70" id="Comment" name="Comment" maxlength="250"></textarea>
            </div>

            <button type="submit" class="btn tw:inline-flex tw:min-h-11 tw:w-full tw:items-center tw:justify-center tw:gap-2 tw:rounded-xl tw:border-2 tw:border-sb-border-control tw:px-4 tw:py-2.5 tw:font-extrabold tw:shadow-sb-small tw:transition-transform tw:hover:translate-x-[2px] tw:hover:translate-y-[2px] btn-primary tw:bg-sb-blue-strong tw:text-white">Submit Rating</button>
        </form>

        <div id="rating-result" class="mt-3 tw:mt-3 tw:font-bold" role="status"></div>
    </div>
</div>

@section scripts {
    <script>
$(function () {
    $("#rating-form").submit(function (e) {
        e.preventDefault();
        var form = $(this);

        $.ajax({
            url: "@Url.Action("SubmitRating","Interactions")",
            type: "POST",
            data: form.serialize(),
            success: function (response) {
                if (response && response.success) {
                    $("#rating-result").html("<span class='text-success tw:text-sb-success-text'>Rating submitted successfully!</span>").show();
                    setTimeout(function () {
                        window.location.href = "@Url.Action("Index","Notifications")";
                    }, 900);
                    return;
                }

                var messages = [];

                if (response) {
                    if (response.errors) {
                        if (Array.isArray(response.errors)) {
                            if (response.errors.length && typeof response.errors[0] === "string") {
                                messages = response.errors;
                            } else {
                                messages = response.errors.map(function (e) { return e.ErrorMessage || e; });
                            }
                        } else if (typeof response.errors === "string") {
                            messages = [response.errors];
                        }
                    }
                    if (messages.length === 0 && response.message) {
                        messages = [response.message];
                    }
                }

                if (messages.length === 0) messages = ["An error occurred."];

                $("#rating-result").text(messages.join("; ")).show();
            },
            error: function () {
                $("#rating-result").html("<span class='text-danger tw:text-sb-danger-text'>Network/server error.</span>").show();
            }
        });
    });
});
    </script>
}
