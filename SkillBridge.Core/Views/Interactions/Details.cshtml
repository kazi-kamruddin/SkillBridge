@model SkillBridge.Models.InteractionHistoryViewModel
@{
    ViewBag.Title = "Exchange record";
    var isOneWay = string.IsNullOrWhiteSpace(Model.SkillYouLearn) || string.IsNullOrWhiteSpace(Model.SkillYouTeach);
}
<main class="container tw:mx-auto tw:w-full tw:max-w-[1400px] tw:px-4 my-5 tw:my-8" style="max-width: 1000px;">
    <a class="tw:inline-flex tw:min-h-11 tw:items-center tw:font-extrabold tw:dark:text-sb-blue-link" href="@(Model.Status == "Completed" ? Url.Action("History", "Interactions") : Url.Action("Index", "Interactions"))">← Back to exchanges</a>
    <h1 class="h2 mt-3 tw:mt-4">Exchange with @Model.OtherUserName</h1>
    @if (isOneWay)
    {
        <p class="tw:mb-2"><span class="badge tw:inline-flex tw:items-center tw:rounded-full tw:border tw:border-sb-border-control tw:bg-sb-blue tw:px-2.5 tw:py-0.5 tw:text-xs tw:font-bold tw:text-sb-ink">One-way mentorship</span></p>
    }
    <p><strong>Status:</strong> @Model.Status · <strong>Learned:</strong> @(string.IsNullOrWhiteSpace(Model.SkillYouLearn) ? "None (1-way mentorship)" : Model.SkillYouLearn) · <strong>Taught:</strong> @(string.IsNullOrWhiteSpace(Model.SkillYouTeach) ? "None (1-way mentorship)" : Model.SkillYouTeach)</p>
    @if (!string.IsNullOrWhiteSpace(Model.EndReason)) { <p><strong>End reason:</strong> @Model.EndReason</p> }
    @if (Model.EndedAt.HasValue) { <p class="text-muted tw:text-sb-muted tw:dark:text-sb-night-ink/70">Finished @Model.EndedAt.Value.ToString("d")</p> }
    @if (Model.CanRate) { <a class="btn tw:inline-flex tw:min-h-11 tw:items-center tw:justify-center tw:gap-2 tw:rounded-xl tw:border-2 tw:border-sb-border-control tw:px-4 tw:py-2 tw:font-extrabold tw:shadow-sb-small tw:transition-transform tw:hover:translate-x-[2px] tw:hover:translate-y-[2px] btn-primary tw:bg-sb-blue-strong tw:text-white mb-4 tw:mb-6" href="@Url.Action("RateInteraction", "Interactions", new { interactionId = Model.InteractionId })">Rate this exchange</a> }
    <h2 class="h4 mt-4 tw:mt-6">Milestones and notes</h2>
    @foreach (var track in Model.SkillBlocks.GroupBy(s => s.SkillName))
    {
        <section class="card tw:overflow-hidden tw:rounded-2xl tw:border-2 tw:border-sb-border-card tw:bg-sb-card tw:text-sb-ink tw:shadow-sb-small tw:dark:bg-sb-night-card tw:dark:text-sb-night-ink p-3 tw:p-4 mb-3 tw:mb-4">
            <h3 class="h5">@track.Key</h3>
            <ol>
                @foreach (var stage in track)
                {
                    <li class="mb-3 tw:mb-4"><strong>@stage.Description</strong> · @(stage.Status == "Green" ? "Completed" : stage.UserConfirmed ? "Confirmed by you only" : "Unfinished")
                        @foreach (var note in stage.Notes)
                        {
                            <div class="ms-3 tw:ms-4 small tw:text-sm"><strong>@(note.IsMine ? "Your note" : "Partner's note"):</strong> @note.WhatWeCovered
                                @if (!string.IsNullOrWhiteSpace(note.NextStep)) { <span>Next: @note.NextStep</span> }
                            </div>
                        }
                    </li>
                }
            </ol>
        </section>
    }
    <h2 class="h4 mt-4 tw:mt-6">Meeting history</h2>
    <partial name="_MeetingHistory" model="Model.MeetingHistory" />
    <h2 class="h4 mt-4 tw:mt-6">Ratings</h2>
    @if (Model.Ratings.Count == 0) { <p>No ratings have been submitted yet.</p> }
    @foreach (var rating in Model.Ratings)
    { <div class="card tw:overflow-hidden tw:rounded-2xl tw:border-2 tw:border-sb-border-card tw:bg-sb-card tw:text-sb-ink tw:shadow-sb-small tw:dark:bg-sb-night-card tw:dark:text-sb-night-ink p-3 tw:p-4 mb-2 tw:mb-2"><strong>@(rating.IsMine ? "Your rating" : "Partner's rating"): @rating.Value/10</strong><p class="mb-0 tw:mb-0">@rating.Comment</p></div> }
</main>
