@model SkillBridge.Models.InteractionSessionsViewModel

@section Styles {
    <style>
        .skill-blocks {
            display: flex;
            flex-wrap: wrap;
            gap: 16px;
            margin-top: 20px;
        }

        .stage {
            flex: 1 1 calc(33.333% - 16px);
            min-width: 220px;
            max-width: 350px;
            min-height: 170px;
            display: flex;
            flex-direction: column;
            justify-content: center;
            align-items: center;
            border: 2px solid var(--sb-border-card);
            border-radius: 16px;
            padding: 16px;
            text-align: center;
            font-weight: 700;
            color: var(--sb-ink);
            box-shadow: var(--sb-shadow-small);
            transition: transform 0.16s ease, box-shadow 0.16s ease;
        }
        .stage details { width: 100%; text-align: left; font-weight: 500; }
        .stage details summary { cursor: pointer; font-weight: 700; min-height: 44px; display: flex; align-items: center; }
        .stage textarea { color: var(--sb-ink); background-color: var(--sb-surface-sunken); border-color: var(--sb-border-control); }

        .stage > span {
            display: block;
            margin-bottom: 10px;
            font-size: 1rem;
            font-weight: 800;
        }

        .stage-state {
            display: inline-flex;
            align-items: center;
            padding: 3px 10px;
            border: 1.5px solid var(--sb-border-control);
            border-radius: 999px;
            font-size: 0.78rem;
            font-weight: 800;
            background: var(--sb-card);
            color: var(--sb-ink);
        }

        /* Stage Colors - harmonious across light & dark navy */
        .stage.Red {
            background: #f5d8d0;
            color: #17242a;
        }
        .stage.Yellow {
            background: #f7e4a8;
            color: #17242a;
        }
        .stage.Green {
            background: var(--sb-sage);
            color: var(--sb-ink);
        }
        body[data-theme="dark"] .stage.Red {
            background: var(--sb-coral);
            color: var(--sb-ink);
        }
        body[data-theme="dark"] .stage.Yellow {
            background: #3a3019;
            color: #f6e7bd;
        }
        body[data-theme="dark"] .stage.Green {
            background: var(--sb-sage);
            color: var(--sb-ink);
        }

        .stage:hover {
            transform: translate(2px, 2px);
            box-shadow: 1px 1px 0 var(--sb-shadow-slate);
        }

        /* Buttons */
        .mark-done {
            min-height: 44px;
            padding: 8px 16px;
            font-size: 0.9rem;
            font-weight: 800;
            border: 2px solid var(--sb-border-control);
            border-radius: 10px;
            cursor: pointer;
            color: var(--sb-ink);
            background: var(--sb-card);
            box-shadow: var(--sb-shadow-small);
            transition: transform 0.15s ease, box-shadow 0.15s ease;
        }
        .mark-done:hover {
            transform: translate(1px, 1px);
            box-shadow: 1px 1px 0 var(--sb-shadow-slate);
        }

        #end-interaction-btn {
            margin-top: 24px;
            min-height: 44px;
            padding: 10px 22px;
            font-size: 1rem;
            font-weight: 800;
        }

        @@media (max-width: 992px) {
            .stage { flex: 1 1 calc(50% - 16px); }
        }
        @@media (max-width: 576px) {
            .stage { flex: 1 1 100%; max-width: none; }
        }
    </style>
}

@{
    var tracks = Model.SkillBlocks.GroupBy(s => new { s.SkillId, s.SkillName }).ToList();
}

<div class="container tw:mx-auto tw:w-full tw:max-w-[1400px] tw:px-4 mt-4 tw:mt-6 sb-session-page">
    @Html.AntiForgeryToken()
    <h1 class="h2 mb-2 tw:mb-2">Your exchange plan</h1>
    @if (tracks.Count == 1)
    {
        <p class="tw:mb-2"><span class="badge tw:inline-flex tw:items-center tw:rounded-full tw:border tw:border-sb-ink tw:bg-sb-blue tw:px-3 tw:py-1 tw:text-xs tw:font-bold tw:text-sb-ink tw:dark:border-sb-night-ink tw:dark:text-sb-night-ink">One-way mentorship</span></p>
    }
    <p class="text-muted tw:text-sb-muted tw:dark:text-sb-night-ink/70 mb-4 tw:mb-6">Both partners confirm each milestone. You can suggest changes to upcoming milestones; the other member must agree.</p>
    @if (TempData["PlanNotice"] != null) { <p class="alert tw:rounded-xl tw:border-2 tw:border-sb-ink tw:p-4 tw:shadow-sb-small alert-success tw:bg-sb-sage tw:text-sb-ink" role="status">@TempData["PlanNotice"]</p> }

    <section class="card tw:overflow-hidden tw:rounded-2xl tw:border-2 tw:border-sb-border-card tw:bg-sb-card tw:text-sb-ink tw:shadow-sb-small tw:dark:bg-sb-night-card tw:dark:text-sb-night-ink p-4 tw:p-5 mb-4 tw:mb-6" aria-labelledby="meeting-heading">
        <h3 id="meeting-heading" class="h5">Plan your next meeting</h3>
        @if (Model.MeetingStartUtc.HasValue && Model.MeetingStatus != "Cancelled")
        {
            <p class="mb-1 tw:mb-1"><strong>Status:</strong> @Model.MeetingStatus · <strong>Format:</strong> @Model.MeetingFormat</p>
            <p class="mb-1 tw:mb-1"><strong>Time:</strong> <time class="meeting-time" data-utc="@Model.MeetingStartUtc.Value.ToString("yyyy-MM-ddTHH:mm:ssZ")">@Model.MeetingStartUtc.Value.ToString("yyyy-MM-dd HH:mm") UTC</time></p>
            @if (!string.IsNullOrWhiteSpace(Model.MeetingNote)) { <p class="mb-2 tw:mb-2"><strong>Place or link:</strong> @Model.MeetingNote</p> }
            @if (Model.CanRespondToMeeting)
            {
                <form method="post" action="@Url.Action("RespondToMeeting", "Interactions")" class="d-flex tw:flex tw:flex-wrap gap-2 tw:gap-2 mb-2 tw:mb-2">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="id" value="@Model.InteractionId" />
                    <button type="submit" name="decision" value="Accept" class="btn tw:inline-flex tw:min-h-11 tw:items-center tw:justify-center tw:gap-2 tw:rounded-xl tw:border-2 tw:border-sb-border-control tw:px-4 tw:py-2 tw:font-extrabold tw:shadow-sb-small tw:transition-transform tw:hover:translate-x-[2px] tw:hover:translate-y-[2px] btn-success tw:bg-sb-sage-deep tw:text-white btn-sm tw:text-sm">Accept time</button>
                    <button type="submit" name="decision" value="Decline" class="btn tw:inline-flex tw:min-h-11 tw:items-center tw:justify-center tw:gap-2 tw:rounded-xl tw:border-2 tw:border-sb-border-control tw:px-4 tw:py-2 tw:font-extrabold tw:shadow-sb-small tw:transition-transform tw:hover:translate-x-[2px] tw:hover:translate-y-[2px] btn-outline-secondary tw:bg-sb-card tw:text-sb-ink btn-sm tw:text-sm">Decline</button>
                </form>
            }
            @if (Model.MeetingStatus == "Confirmed" || Model.MeetingStatus == "Proposed")
            {
                <form method="post" action="@Url.Action("CancelMeeting", "Interactions")" class="mb-2 tw:mb-2">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="id" value="@Model.InteractionId" />
                    <button type="submit" class="btn tw:inline-flex tw:min-h-11 tw:items-center tw:justify-center tw:gap-2 tw:rounded-xl tw:border-2 tw:border-sb-border-control tw:px-4 tw:py-2 tw:font-extrabold tw:shadow-sb-small tw:transition-transform tw:hover:translate-x-[2px] tw:hover:translate-y-[2px] btn-outline-danger tw:bg-sb-card tw:text-sb-danger-text btn-sm tw:text-sm">Cancel meeting</button>
                </form>
            }
            @if (Model.MeetingStatus == "Confirmed" && Model.MeetingStartUtc <= DateTime.UtcNow)
            {
                <form method="post" action="@Url.Action("CompleteMeeting", "Interactions")" class="mb-2 tw:mb-2">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="id" value="@Model.InteractionId" />
                    <button type="submit" class="btn tw:inline-flex tw:min-h-11 tw:items-center tw:justify-center tw:gap-2 tw:rounded-xl tw:border-2 tw:border-sb-border-control tw:px-4 tw:py-2 tw:font-extrabold tw:shadow-sb-small tw:transition-transform tw:hover:translate-x-[2px] tw:hover:translate-y-[2px] btn-outline-success tw:bg-sb-card tw:text-sb-success-text btn-sm tw:text-sm">Mark meeting completed</button>
                </form>
            }
        }
        else if (Model.MeetingStatus == "Cancelled" || Model.MeetingStatus == "Declined")
        { <p>The previous time was @Model.MeetingStatus.ToLowerInvariant(). You can propose another.</p> }
        <details>
            <summary class="tw:cursor-pointer tw:font-bold tw:py-2">Propose a meeting time</summary>
            <form id="meetingForm" method="post" action="@Url.Action("ProposeMeeting", "Interactions")" class="mt-3 tw:mt-4" style="max-width: 550px;">
                @Html.AntiForgeryToken()
                <input type="hidden" name="id" value="@Model.InteractionId" />
                <input type="hidden" name="startsAtUtc" id="startsAtUtc" />
                <label for="meetingLocal" class="form-label tw:mb-1 tw:block tw:font-bold">Time in your local time zone</label>
                <input id="meetingLocal" type="datetime-local" class="form-control tw:min-h-11 tw:w-full tw:rounded-lg tw:border-2 tw:border-sb-border-control tw:bg-sb-surface-sunken tw:px-3 tw:py-2 tw:text-sb-ink tw:focus:border-sb-border-focus tw:focus:outline-none tw:focus:ring-2 tw:focus:ring-sb-blue/70 mb-2 tw:mb-2" required />
                <label for="meetingFormat" class="form-label tw:mb-1 tw:block tw:font-bold">Format</label>
                <select id="meetingFormat" name="format" class="form-select tw:min-h-11 tw:w-full tw:rounded-lg tw:border-2 tw:border-sb-border-control tw:bg-sb-surface-sunken tw:px-3 tw:py-2 tw:text-sb-ink tw:focus:border-sb-border-focus tw:focus:outline-none tw:focus:ring-2 tw:focus:ring-sb-blue/70 mb-2 tw:mb-2" required><option value="Online">Online</option><option value="In person">In person</option></select>
                <label for="meetingNote" class="form-label tw:mb-1 tw:block tw:font-bold">Meeting place or call link</label>
                <input id="meetingNote" name="note" maxlength="300" class="form-control tw:min-h-11 tw:w-full tw:rounded-lg tw:border-2 tw:border-sb-border-control tw:bg-sb-surface-sunken tw:px-3 tw:py-2 tw:text-sb-ink tw:focus:border-sb-border-focus tw:focus:outline-none tw:focus:ring-2 tw:focus:ring-sb-blue/70 mb-2 tw:mb-3" placeholder="Required for an in-person meeting" />
                <button type="submit" class="btn tw:inline-flex tw:min-h-11 tw:items-center tw:justify-center tw:gap-2 tw:rounded-xl tw:border-2 tw:border-sb-border-control tw:px-4 tw:py-2 tw:font-extrabold tw:shadow-sb-small tw:transition-transform tw:hover:translate-x-[2px] tw:hover:translate-y-[2px] btn-primary tw:bg-sb-blue-strong tw:text-white btn-sm tw:text-sm">Send proposal</button>
            </form>
        </details>
    </section>

    <h2 class="h5">Meeting history</h2>
    <partial name="_MeetingHistory" model="Model.MeetingHistory" />

    <div class="exchange-tracks">
        @foreach (var track in tracks)
        {
            var proposal = Model.PlanProposals.FirstOrDefault(p => p.SkillId == track.Key.SkillId);
            <section class="card tw:overflow-hidden tw:rounded-2xl tw:border-2 tw:border-sb-border-card tw:bg-sb-card tw:text-sb-ink tw:shadow-sb-small tw:dark:bg-sb-night-card tw:dark:text-sb-night-ink p-4 tw:p-5 mb-4 tw:mb-6 exchange-track" aria-label="@track.Key.SkillName plan">
                <h2 class="h4">@track.Key.SkillName</h2>
                <p class="small tw:text-sm text-muted tw:text-sb-muted tw:dark:text-sb-night-ink/70">@track.Count(s => s.Status == "Green") of @track.Count() milestones completed</p>
                @if (proposal != null)
                {
                    <div class="alert tw:rounded-xl tw:border-2 tw:border-sb-border-card tw:p-4 tw:shadow-sb-small alert-info tw:bg-sb-blue tw:text-sb-ink">
                        <strong>@(proposal.ProposedByMe ? "Waiting for your partner to review these changes" : "Your partner suggested this plan")</strong>
                        <ol class="mb-2 tw:mb-2 mt-2 tw:mt-2">@foreach (var step in proposal.Steps) { <li>@step.Title</li> }</ol>
                        <form method="post" action="@Url.Action("RespondToPlan", "Interactions")" class="d-flex tw:flex gap-2 tw:gap-2 flex-wrap tw:flex-wrap">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="interactionId" value="@Model.InteractionId" />
                            <input type="hidden" name="skillId" value="@track.Key.SkillId" />
                            @if (proposal.ProposedByMe)
                            { <button type="submit" name="decision" value="Withdraw" class="btn tw:inline-flex tw:min-h-11 tw:items-center tw:justify-center tw:gap-2 tw:rounded-xl tw:border-2 tw:border-sb-border-control tw:px-4 tw:py-2 tw:font-extrabold tw:shadow-sb-small tw:transition-transform tw:hover:translate-x-[2px] tw:hover:translate-y-[2px] btn-outline-secondary tw:bg-sb-card tw:text-sb-ink btn-sm tw:text-sm">Withdraw proposal</button> }
                            else
                            {
                                <button type="submit" name="decision" value="Accept" class="btn tw:inline-flex tw:min-h-11 tw:items-center tw:justify-center tw:gap-2 tw:rounded-xl tw:border-2 tw:border-sb-border-control tw:px-4 tw:py-2 tw:font-extrabold tw:shadow-sb-small tw:transition-transform tw:hover:translate-x-[2px] tw:hover:translate-y-[2px] btn-success tw:bg-sb-sage-deep tw:text-white btn-sm tw:text-sm">Accept plan</button>
                                <button type="submit" name="decision" value="Decline" class="btn tw:inline-flex tw:min-h-11 tw:items-center tw:justify-center tw:gap-2 tw:rounded-xl tw:border-2 tw:border-sb-border-control tw:px-4 tw:py-2 tw:font-extrabold tw:shadow-sb-small tw:transition-transform tw:hover:translate-x-[2px] tw:hover:translate-y-[2px] btn-outline-secondary tw:bg-sb-card tw:text-sb-ink btn-sm tw:text-sm">Decline</button>
                            }
                        </form>
                    </div>
                }
                <div class="skill-blocks">
                    @foreach (var stage in track)
                    {
                        <div class="stage @stage.Status" data-stage="@stage.StageNumber" data-skill="@stage.SkillId">
                            <span>Milestone @stage.StageNumber: @stage.Description</span>
                            <small class="stage-state mb-2 tw:mb-2">@(stage.Status == "Green" ? "Completed" : stage.UserConfirmed ? "Awaiting partner" : stage.IsLocked ? "Upcoming" : "Ready to confirm")</small>
                            @if (!stage.IsLocked && !stage.UserConfirmed)
                            { <button class="mark-done" data-stage="@stage.StageNumber" data-skill="@stage.SkillId">Confirm milestone</button> }
                            <details class="mt-2 tw:mt-2">
                                <summary>Milestone notes (@stage.Notes.Count)</summary>
                                @foreach (var note in stage.Notes)
                                {
                                    <div class="small tw:text-sm mt-2 tw:mt-2"><strong>@(note.IsMine ? "You" : "Partner"):</strong> @note.WhatWeCovered</div>
                                    @if (!string.IsNullOrWhiteSpace(note.NextStep)) { <div class="small tw:text-sm">Next: @note.NextStep</div> }
                                }
                                <form method="post" action="@Url.Action("SaveStageNote", "Interactions")" class="mt-2 tw:mt-2">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="sessionId" value="@stage.SessionId" />
                                    <label class="small tw:text-sm tw:font-bold" for="covered-@stage.SessionId">What you covered</label>
                                    <textarea id="covered-@stage.SessionId" name="whatWeCovered" maxlength="1000" required class="form-control tw:min-h-11 tw:w-full tw:rounded-lg tw:border-2 tw:border-sb-border-control tw:bg-sb-surface-sunken tw:px-3 tw:py-2 tw:text-sb-ink tw:focus:border-sb-border-focus tw:focus:outline-none tw:text-sm mb-1 tw:mb-1">@stage.Notes.FirstOrDefault(n => n.IsMine)?.WhatWeCovered</textarea>
                                    <label class="small tw:text-sm tw:font-bold" for="next-@stage.SessionId">Your next step</label>
                                    <textarea id="next-@stage.SessionId" name="nextStep" maxlength="500" class="form-control tw:min-h-11 tw:w-full tw:rounded-lg tw:border-2 tw:border-sb-border-control tw:bg-sb-surface-sunken tw:px-3 tw:py-2 tw:text-sb-ink tw:focus:border-sb-border-focus tw:focus:outline-none tw:text-sm mb-2 tw:mb-2">@stage.Notes.FirstOrDefault(n => n.IsMine)?.NextStep</textarea>
                                    <button type="submit" class="btn tw:inline-flex tw:min-h-11 tw:items-center tw:justify-center tw:gap-2 tw:rounded-xl tw:border-2 tw:border-sb-border-control tw:px-4 tw:py-2 tw:font-extrabold tw:shadow-sb-small tw:transition-transform tw:hover:translate-x-[2px] tw:hover:translate-y-[2px] btn-light tw:bg-sb-card tw:text-sb-ink btn-sm tw:text-sm">Save note</button>
                                </form>
                            </details>
                        </div>
                    }
                </div>
                @if (proposal == null && track.Any(s => s.IsEditable))
                {
                    <details class="mt-3 tw:mt-4 plan-editor">
                        <summary class="tw:cursor-pointer tw:font-bold tw:py-2">Suggest changes to upcoming milestones</summary>
                        <p class="small tw:text-sm text-muted tw:text-sb-muted tw:dark:text-sb-night-ink/70 mt-2 tw:mt-2">Rename, move, remove or add steps. Completed and already confirmed milestones stay in place. Your partner must accept the proposal.</p>
                        <form method="post" action="@Url.Action("ProposePlan", "Interactions")" class="plan-form" data-fixed-count="@track.Count(s => !s.IsEditable)" data-original-count="@track.Count(s => s.IsEditable)">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="interactionId" value="@Model.InteractionId" />
                            <input type="hidden" name="skillId" value="@track.Key.SkillId" />
                            <div class="plan-steps">
                                @{ var editableStages = track.Where(s => s.IsEditable).ToList(); }
                                @for (var planIndex = 0; planIndex < editableStages.Count; planIndex++)
                                {
                                    var stage = editableStages[planIndex];
                                    <div class="plan-step d-flex tw:flex flex-wrap tw:flex-wrap gap-2 tw:gap-2 align-items-center tw:items-center mb-2 tw:mb-2" data-session-id="@stage.SessionId">
                                        <input type="hidden" class="plan-session-id" name="steps[@planIndex].SessionId" value="@stage.SessionId" />
                                        <input class="form-control tw:min-h-11 tw:w-full tw:rounded-lg tw:border-2 tw:border-sb-border-control tw:bg-sb-surface-sunken tw:px-3 tw:py-2 tw:text-sb-ink tw:focus:border-sb-border-focus tw:focus:outline-none flex-grow-1 tw:flex-1 plan-title" name="steps[@planIndex].Title" style="max-width:450px" value="@stage.Description" maxlength="200" required aria-label="Milestone title" />
                                        <button type="button" class="btn tw:inline-flex tw:min-h-11 tw:min-w-11 tw:items-center tw:justify-center tw:gap-2 tw:rounded-xl tw:border-2 tw:border-sb-border-control tw:px-3 tw:py-2 tw:font-extrabold tw:shadow-sb-small tw:transition-transform tw:hover:translate-x-[2px] tw:hover:translate-y-[2px] btn-outline-secondary tw:bg-sb-card tw:text-sb-ink btn-sm tw:text-sm plan-up" aria-label="Move milestone earlier">↑</button>
                                        <button type="button" class="btn tw:inline-flex tw:min-h-11 tw:min-w-11 tw:items-center tw:justify-center tw:gap-2 tw:rounded-xl tw:border-2 tw:border-sb-border-control tw:px-3 tw:py-2 tw:font-extrabold tw:shadow-sb-small tw:transition-transform tw:hover:translate-x-[2px] tw:hover:translate-y-[2px] btn-outline-secondary tw:bg-sb-card tw:text-sb-ink btn-sm tw:text-sm plan-down" aria-label="Move milestone later">↓</button>
                                        <button type="button" class="btn tw:inline-flex tw:min-h-11 tw:items-center tw:justify-center tw:gap-2 tw:rounded-xl tw:border-2 tw:border-sb-border-control tw:px-4 tw:py-2 tw:font-extrabold tw:shadow-sb-small tw:transition-transform tw:hover:translate-x-[2px] tw:hover:translate-y-[2px] btn-outline-danger tw:bg-sb-card tw:text-sb-danger-text btn-sm tw:text-sm plan-remove" disabled="@(stage.Notes.Count > 0)">Remove</button>
                                    </div>
                                }
                            </div>
                            <div class="tw:flex tw:flex-wrap tw:gap-2 tw:mt-3">
                                <button type="button" class="btn tw:inline-flex tw:min-h-11 tw:items-center tw:justify-center tw:gap-2 tw:rounded-xl tw:border-2 tw:border-sb-border-control tw:px-4 tw:py-2 tw:font-extrabold tw:shadow-sb-small tw:transition-transform tw:hover:translate-x-[2px] tw:hover:translate-y-[2px] btn-outline-primary tw:bg-sb-card tw:text-sb-blue-strong tw:dark:bg-sb-night-card tw:dark:text-sb-blue-link btn-sm tw:text-sm plan-add">Add milestone</button>
                                <button type="submit" class="btn tw:inline-flex tw:min-h-11 tw:items-center tw:justify-center tw:gap-2 tw:rounded-xl tw:border-2 tw:border-sb-border-control tw:px-4 tw:py-2 tw:font-extrabold tw:shadow-sb-small tw:transition-transform tw:hover:translate-x-[2px] tw:hover:translate-y-[2px] btn-primary tw:bg-sb-blue-strong tw:text-white btn-sm tw:text-sm">Send plan proposal</button>
                            </div>
                            <p class="small tw:text-sm text-muted tw:text-sb-muted tw:dark:text-sb-night-ink/70 mt-2 tw:mt-2">Add or remove up to three milestones per proposal, with at most 12 per skill. Milestones with notes cannot be removed.</p>
                        </form>
                    </details>
                }
            </section>
        }
    </div>

    <!-- End Interaction Button -->
    @if (Model.SkillBlocks.All(s => s.Status == "Green"))
    {
        <button id="end-interaction-btn" class="btn tw:inline-flex tw:min-h-11 tw:items-center tw:justify-center tw:gap-2 tw:rounded-xl tw:border-2 tw:border-sb-border-control tw:px-5 tw:py-2.5 tw:font-extrabold tw:shadow-sb-small tw:transition-transform tw:hover:translate-x-[2px] tw:hover:translate-y-[2px] btn-success tw:bg-sb-sage-deep tw:text-white">Complete exchange</button>
    }
    <details class="mt-4 tw:mt-6">
        <summary class="tw:cursor-pointer tw:font-bold tw:py-2">Need to end this exchange early?</summary>
        <form method="post" action="@Url.Action("StopInteraction", "Interactions")" class="mt-3 tw:mt-4" style="max-width: 600px;">
            @Html.AntiForgeryToken()
            <input type="hidden" name="id" value="@Model.InteractionId" />
            <label class="form-label tw:mb-1 tw:block tw:font-bold" for="end-reason">Tell the other member why</label>
            <textarea id="end-reason" name="reason" class="form-control tw:min-h-11 tw:w-full tw:rounded-lg tw:border-2 tw:border-sb-border-control tw:bg-sb-surface-sunken tw:px-3 tw:py-2 tw:text-sb-ink tw:focus:border-sb-border-focus tw:focus:outline-none tw:focus:ring-2 tw:focus:ring-sb-blue/70 mb-2 tw:mb-3" maxlength="500" required></textarea>
            <button class="btn tw:inline-flex tw:min-h-11 tw:items-center tw:justify-center tw:gap-2 tw:rounded-xl tw:border-2 tw:border-sb-border-control tw:px-4 tw:py-2 tw:font-extrabold tw:shadow-sb-small tw:transition-transform tw:hover:translate-x-[2px] tw:hover:translate-y-[2px] btn-outline-danger tw:bg-sb-card tw:text-sb-danger-text" type="submit" onclick="return confirm('End this exchange without completing it?')">End exchange early</button>
        </form>
    </details>
</div>

@section scripts {
    <script>
        $(document).ready(function () {
            $(document).on("click", ".plan-add", function () {
                var form = $(this).closest(".plan-form");
                if (form.find('.plan-step[data-session-id="0"]').length >= 3) {
                    alert("Add up to three milestones per proposal.");
                    return;
                }
                if (form.find(".plan-step").length + Number(form.data("fixed-count")) >= 12) {
                    alert("Keep at most 12 milestones in each skill plan.");
                    return;
                }
                form.find(".plan-steps").append(
                    '<div class="plan-step d-flex tw:flex flex-wrap tw:flex-wrap gap-2 tw:gap-2 align-items-center tw:items-center mb-2 tw:mb-2" data-session-id="0">' +
                    '<input type="hidden" class="plan-session-id" value="0" />' +
                    '<input class="form-control tw:min-h-11 tw:w-full tw:rounded-lg tw:border-2 tw:border-sb-border-control tw:bg-sb-surface-sunken tw:px-3 tw:py-2 tw:text-sb-ink tw:focus:border-sb-border-focus tw:focus:outline-none flex-grow-1 tw:flex-1 plan-title" style="max-width:450px" maxlength="200" required aria-label="Milestone title" placeholder="New milestone" />' +
                    '<button type="button" class="btn tw:inline-flex tw:min-h-11 tw:min-w-11 tw:items-center tw:justify-center tw:gap-2 tw:rounded-xl tw:border-2 tw:border-sb-border-control tw:px-3 tw:py-2 tw:font-extrabold tw:shadow-sb-small tw:transition-transform tw:hover:translate-x-[2px] tw:hover:translate-y-[2px] btn-outline-secondary tw:bg-sb-card tw:text-sb-ink btn-sm tw:text-sm plan-up" aria-label="Move milestone earlier">↑</button>' +
                    '<button type="button" class="btn tw:inline-flex tw:min-h-11 tw:min-w-11 tw:items-center tw:justify-center tw:gap-2 tw:rounded-xl tw:border-2 tw:border-sb-border-control tw:px-3 tw:py-2 tw:font-extrabold tw:shadow-sb-small tw:transition-transform tw:hover:translate-x-[2px] tw:hover:translate-y-[2px] btn-outline-secondary tw:bg-sb-card tw:text-sb-ink btn-sm tw:text-sm plan-down" aria-label="Move milestone later">↓</button>' +
                    '<button type="button" class="btn tw:inline-flex tw:min-h-11 tw:items-center tw:justify-center tw:gap-2 tw:rounded-xl tw:border-2 tw:border-sb-border-control tw:px-4 tw:py-2 tw:font-extrabold tw:shadow-sb-small tw:transition-transform tw:hover:translate-x-[2px] tw:hover:translate-y-[2px] btn-outline-danger tw:bg-sb-card tw:text-sb-danger-text btn-sm tw:text-sm plan-remove">Remove</button></div>');
                form.find(".plan-step:last .plan-title").trigger("focus");
            });
            $(document).on("click", ".plan-remove", function () {
                var form = $(this).closest(".plan-form");
                if ($(this).closest('.plan-step').data('session-id') !== 0 &&
                    Number(form.data('original-count')) - form.find('.plan-step').filter(function () { return $(this).data('session-id') !== 0; }).length >= 3) {
                    alert("Remove up to three milestones per proposal.");
                    return;
                }
                if (form.find(".plan-step").length <= 1) {
                    alert("Keep at least one upcoming milestone.");
                    return;
                }
                $(this).closest(".plan-step").remove();
            });
            $(document).on("click", ".plan-up", function () {
                var row = $(this).closest(".plan-step");
                row.prev(".plan-step").before(row);
            });
            $(document).on("click", ".plan-down", function () {
                var row = $(this).closest(".plan-step");
                row.next(".plan-step").after(row);
            });
            $(document).on("submit", ".plan-form", function () {
                $(this).find(".plan-step").each(function (index) {
                    $(this).find(".plan-session-id").attr("name", "steps[" + index + "].SessionId");
                    $(this).find(".plan-title").attr("name", "steps[" + index + "].Title");
                });
            });
            $(".meeting-time").each(function () {
                var time = new Date($(this).data("utc"));
                if (!isNaN(time.getTime())) $(this).text(time.toLocaleString());
            });
            $("#meetingForm").on("submit", function (event) {
                var local = new Date($("#meetingLocal").val());
                if (isNaN(local.getTime())) { event.preventDefault(); return; }
                $("#startsAtUtc").val(local.toISOString());
            });
            $(".mark-done").click(function () {
                var button = $(this);
                var stageNumber = button.data("stage");
                var skillId = button.data("skill");

                $.post("@Url.Action("MarkStageDone", "Interactions")",
                    { stageNumber: stageNumber, skillId: skillId, interactionId: @Model.InteractionId,
                      __RequestVerificationToken: $('input[name="__RequestVerificationToken"]').val() },
                    function (response) {
                        if (response.success) {
                            var stageDiv = button.closest(".stage");
                            if (response.status === "Confirmed") {
                                stageDiv.removeClass("Red Yellow").addClass("Green");
                                stageDiv.find(".stage-state").text("Completed");
                            } else {
                                stageDiv.removeClass("Red Green").addClass("Yellow");
                                stageDiv.find(".stage-state").text("Awaiting partner");
                            }
                            button.remove();

                            if ($(".stage").length === $(".stage.Green").length && $("#end-interaction-btn").length === 0) {
                                $(".exchange-tracks").after('<button id="end-interaction-btn" class="btn tw:inline-flex tw:min-h-11 tw:items-center tw:justify-center tw:gap-2 tw:rounded-xl tw:border-2 tw:border-sb-border-control tw:px-5 tw:py-2.5 tw:font-extrabold tw:shadow-sb-small tw:transition-transform tw:hover:translate-x-[2px] tw:hover:translate-y-[2px] btn-success tw:bg-sb-sage-deep tw:text-white">Complete exchange</button>');
                                attachEndInteractionClick();
                            }
                        }
                    });
            });

            function attachEndInteractionClick() {
                $("#end-interaction-btn").click(function () {
                    $.post("@Url.Action("EndInteraction", "Interactions")",
                        { id: @Model.InteractionId,
                          __RequestVerificationToken: $('input[name="__RequestVerificationToken"]').val() },
                        function (response) {
                            alert("Interaction completed!");
                            window.location.href = "@Url.Action("Index", "Interactions")";
                        });
                });
            }

            attachEndInteractionClick();
        });
    </script>
}
