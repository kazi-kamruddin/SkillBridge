@model List<SkillBridge.Models.InteractionIndexViewModel>
@{
    ViewBag.Title = "Your Interactions";
}

@section Styles {
    <style>
        .sb-interactions-page .interaction-card {
            display: flex;
            flex-direction: column;
            justify-content: space-between;
            min-height: 250px;
            padding: 1.5rem;
            border-radius: 18px;
            border: 2px solid var(--sb-border-card);
            background: var(--sb-card);
            color: var(--sb-ink);
            box-shadow: var(--sb-shadow);
            position: relative;
            transition: transform 0.16s ease, box-shadow 0.16s ease;
        }
        .sb-interactions-page .interaction-card:hover {
            transform: translate(2px, 2px);
            box-shadow: var(--sb-shadow-small);
        }
        .sb-interactions-page .interaction-card h2 {
            font-size: 1.35rem;
            font-weight: 900;
            letter-spacing: -0.02em;
            color: var(--sb-ink);
            margin: 0 0 0.75rem;
        }
        .sb-interactions-page .interaction-card p {
            margin: 0.35rem 0;
            font-size: 0.95rem;
            color: var(--sb-ink);
        }
        .sb-interactions-page .interaction-card strong {
            color: var(--sb-accent-text);
        }
        body[data-theme="dark"] .sb-interactions-page .interaction-card strong {
            color: var(--sb-blue-link);
        }
    </style>
}

<main class="container tw:mx-auto tw:w-full tw:max-w-[1400px] tw:px-4 tw:py-6 sb-interactions-page">
    <header class="sb-page-heading tw:mb-6">
        <div class="tw:flex tw:flex-wrap tw:items-center tw:justify-between tw:gap-4">
            <div>
                <div class="sb-hero-kicker"><span class="sb-eyebrow">ACTIVE EXCHANGES</span></div>
                <h1 class="tw:m-0">Your Interactions</h1>
                <p class="tw:mb-0">Track shared milestones, coordinate upcoming meetings, and complete exchanges with your learning partners.</p>
            </div>
            <a href="@Url.Action("History", "Interactions")"
               class="btn tw:inline-flex tw:min-h-11 tw:items-center tw:justify-center tw:gap-2 tw:rounded-xl tw:border-2 tw:border-sb-border-control tw:bg-sb-card tw:px-4 tw:py-2 tw:text-sm tw:font-extrabold tw:text-sb-blue-strong tw:shadow-sb-small tw:transition-transform tw:hover:translate-x-[2px] tw:hover:translate-y-[2px] tw:dark:bg-sb-night-card tw:dark:text-sb-blue-link">
                View completed exchange history
            </a>
        </div>
    </header>

    @if (!Model.Any())
    {
        <div class="alert tw:rounded-2xl tw:border-2 tw:border-sb-border-card tw:bg-sb-blue tw:p-6 tw:text-sb-ink tw:shadow-sb-small" role="status">
            <p class="tw:mb-3 tw:font-bold">You have no active exchanges right now.</p>
            <div class="tw:flex tw:flex-wrap tw:gap-3">
                <a href="@Url.Action("Index", "Explore")" class="btn tw:inline-flex tw:min-h-11 tw:items-center tw:justify-center tw:gap-2 tw:rounded-xl tw:border-2 tw:border-sb-border-control tw:bg-sb-blue-strong tw:px-4 tw:py-2 tw:text-sm tw:font-extrabold tw:text-white tw:shadow-sb-small">Explore matching members</a>
                <a href="@Url.Action("History", "Interactions")" class="btn tw:inline-flex tw:min-h-11 tw:items-center tw:justify-center tw:gap-2 tw:rounded-xl tw:border-2 tw:border-sb-border-control tw:bg-sb-card tw:px-4 tw:py-2 tw:text-sm tw:font-extrabold tw:text-sb-ink tw:shadow-sb-small tw:dark:bg-sb-night-card tw:dark:text-sb-night-ink">View completed exchanges</a>
            </div>
        </div>
    }
    <div class="row tw:grid tw:grid-cols-12 tw:gap-5">
        @foreach (var interaction in Model)
        {
            var isOneWay = string.IsNullOrWhiteSpace(interaction.SkillYouLearn) || string.IsNullOrWhiteSpace(interaction.SkillYouTeach);
            <div class="interaction-card tw:col-span-12 tw:md:col-span-6 tw:xl:col-span-4">
                <div>
                    <div class="tw:mb-3 tw:flex tw:flex-wrap tw:items-center tw:justify-between tw:gap-2">
                        <h2 class="tw:m-0">@interaction.OtherUserName</h2>
                        <span class="badge tw:inline-flex tw:items-center tw:rounded-full tw:border tw:border-sb-border-control tw:bg-sb-sage tw:px-2.5 tw:py-0.5 tw:text-xs tw:font-bold tw:text-sb-ink">@interaction.Status</span>
                    </div>
                    @if (isOneWay)
                    {
                        <p class="tw:mb-2"><span class="badge tw:inline-flex tw:items-center tw:rounded-full tw:border tw:border-sb-border-control tw:bg-sb-blue tw:px-2.5 tw:py-0.5 tw:text-xs tw:font-bold tw:text-sb-ink">One-way mentorship</span></p>
                    }
                    <p><strong>Teaching:</strong> @(string.IsNullOrWhiteSpace(interaction.SkillYouTeach) ? "None (1-way mentorship)" : interaction.SkillYouTeach)</p>
                    <p><strong>Learning:</strong> @(string.IsNullOrWhiteSpace(interaction.SkillYouLearn) ? "None (1-way mentorship)" : interaction.SkillYouLearn)</p>
                    @if (interaction.Status == "Ended" && !string.IsNullOrWhiteSpace(interaction.EndReason))
                    {
                        <p><strong>Reason:</strong> @interaction.EndReason</p>
                    }
                </div>
                <div class="tw:mt-4 tw:pt-2">
                    @if (interaction.Status == "Ended")
                    {
                        <a class="btn tw:inline-flex tw:min-h-11 tw:items-center tw:justify-center tw:rounded-xl tw:border-2 tw:border-sb-border-control tw:bg-sb-blue-strong tw:px-4 tw:py-2 tw:text-sm tw:font-extrabold tw:text-white tw:shadow-sb-small tw:transition-transform tw:hover:translate-x-[2px] tw:hover:translate-y-[2px]" href="@Url.Action("Details", "Interactions", new { id = interaction.InteractionId })">View record</a>
                    }
                    else
                    {
                        <a class="btn tw:inline-flex tw:min-h-11 tw:items-center tw:justify-center tw:rounded-xl tw:border-2 tw:border-sb-border-control tw:bg-sb-blue-strong tw:px-4 tw:py-2 tw:text-sm tw:font-extrabold tw:text-white tw:shadow-sb-small tw:transition-transform tw:hover:translate-x-[2px] tw:hover:translate-y-[2px]" href="@Url.Action("Sessions", "Interactions", new { id = interaction.InteractionId })">View Details</a>
                    }
                </div>
            </div>
        }
    </div>
</main>
