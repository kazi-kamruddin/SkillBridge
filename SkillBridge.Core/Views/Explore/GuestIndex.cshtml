@model SkillBridge.Models.GuestExploreViewModel
@{
    ViewBag.Title = "Explore Skills";
}

<main class="container my-5" aria-labelledby="title">
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4 sb-page-heading">
        <div>
            <span class="sb-eyebrow">WHAT WILL YOU LEARN NEXT?</span>
            <h1 id="title">Explore skills.</h1>
            <p class="text-muted mb-0">Browse the skills people share on SkillBridge.</p>
        </div>
        @if (!User.Identity.IsAuthenticated)
        {
            <a class="btn btn-primary" href="@Url.Action("Register", "Account")">Join to find your matches</a>
        }
    </div>

    <form method="get" action="@Url.Action("Skills", "Explore")" class="row g-2 mb-4" role="search">
        <div class="col-sm-9">
            <label for="skill-search" class="form-label">Find a skill by name or goal</label>
            <input id="skill-search" name="q" value="@Model.Query" maxlength="100" class="form-control" placeholder="Try spreadsheets, databases, or 3D design" />
        </div>
        <div class="col-sm-3 align-self-end"><button class="btn btn-primary w-100" type="submit">Search skills</button></div>
    </form>
    @if (TempData["SkillNotice"] is string skillNotice)
    { <p class="alert alert-info" role="status">@skillNotice</p> }
    @if (User.Identity.IsAuthenticated)
    {
        @if (Model.CanReviewSuggestions)
        { <p><a href="@Url.Action("Suggestions", "Catalog")">Review skill suggestions</a></p> }
        <details class="card p-3 mb-4">
            <summary>Suggest a missing skill</summary>
            <p class="small text-muted mt-2">Suggestions are reviewed before they appear in the directory.</p>
            <form method="post" action="@Url.Action("SuggestSkill", "Explore")">
                @Html.AntiForgeryToken()
                <label for="suggested-skill" class="form-label">Skill name</label>
                <input id="suggested-skill" name="name" maxlength="100" minlength="2" required class="form-control mb-2" />
                <label for="suggested-category" class="form-label">Suggested category</label>
                <input id="suggested-category" name="categoryName" maxlength="100" minlength="2" required class="form-control mb-2" />
                <label for="suggested-reason" class="form-label">Why should we add it?</label>
                <textarea id="suggested-reason" name="reason" maxlength="500" minlength="10" required class="form-control mb-2"></textarea>
                <button type="submit" class="btn btn-outline-primary">Send suggestion</button>
            </form>
        </details>
        @if (Model.MySuggestions.Any())
        {
            <details class="mb-4"><summary>Your recent suggestions</summary>
                <ul class="mt-2">@foreach (var suggestion in Model.MySuggestions) { <li>@suggestion.Name — @suggestion.Status</li> }</ul>
            </details>
        }
    }

    @if (!Model.Skills.Any())
    {
        <div class="alert alert-info">@(string.IsNullOrWhiteSpace(Model.Query) ? "The skills directory is being prepared." : "No skills match that search. Try a broader goal or skill name.")</div>
    }
    else
    {
        @foreach (var category in Model.Skills.GroupBy(s => s.CategoryName))
        {
            <section class="mb-4" aria-label="@category.Key">
                <h2 class="h4 mb-3">@category.Key</h2>
                <div class="row g-3">
                    @foreach (var skill in category)
                    {
                        <div class="col-md-6 col-lg-4">
                            <div class="card h-100 shadow-sm">
                                <div class="card-body">
                                    <h3 class="h5"><a href="@Url.Action("Detail", "Explore", new { id = skill.SkillId })">@skill.SkillName</a></h3>
                                    @if (skill.Teachers.Any())
                                    {
                                        <p class="small text-muted mb-2">Members sharing this skill:</p>
                                        <ul class="mb-0">
                                            @foreach (var teacher in skill.Teachers)
                                            {
                                                <li><a href="@Url.Action("PublicProfile", "Profile", new { id = teacher.UserId })">@teacher.FullName</a></li>
                                            }
                                        </ul>
                                    }
                                    else
                                    {
                                        <p class="small text-muted mb-0">No public profiles for this skill yet.</p>
                                    }
                                </div>
                            </div>
                        </div>
                    }
                </div>
            </section>
        }
    }
</main>
