@model List<SkillBridge.Models.SkillSuggestion>
@{ ViewBag.Title = "Skill suggestions"; }
<main class="container tw:mx-auto tw:w-full tw:max-w-[1400px] tw:px-4 my-5 tw:my-8" style="max-width:920px">
    <h1 class="h2">Skill suggestions</h1>
    <p>Review requests, then write seven starter milestones before adding a skill to the directory.</p>
    @if (TempData["CatalogNotice"] is string notice) { <p class="alert tw:rounded-xl tw:border-2 tw:border-sb-ink tw:p-4 tw:shadow-sb-small alert-info tw:bg-sb-blue tw:text-sb-ink" role="status">@notice</p> }
    @if (!Model.Any()) { <p>No suggestions awaiting review.</p> }
    @foreach (var suggestion in Model)
    {
        <article class="card tw:overflow-hidden tw:rounded-2xl tw:border-2 tw:border-sb-ink tw:bg-sb-card tw:text-sb-ink tw:shadow-sb-small tw:dark:border-sb-night-ink tw:dark:bg-sb-night-card tw:dark:text-sb-night-ink p-3 tw:p-4 mb-3 tw:mb-4">
            <h2 class="h5">@suggestion.Name <small class="text-muted tw:text-sb-muted tw:dark:text-sb-night-ink/70">· @suggestion.CategoryName</small></h2>
            <p>@suggestion.Reason</p>
            <form method="post" action="@Url.Action("Review", "Catalog")">
                @Html.AntiForgeryToken()
                <input type="hidden" name="id" value="@suggestion.Id" />
                <details class="mb-2 tw:mb-2"><summary>Add this skill</summary>
                    <p class="small tw:text-sm text-muted tw:text-sb-muted tw:dark:text-sb-night-ink/70 mt-2 tw:mt-2">Write milestones from beginner to advanced.</p>
                    @for (var i = 0; i < 7; i++)
                    {
                        <label for="stage-@suggestion.Id-@i" class="form-label tw:mb-1 tw:block tw:font-bold">Milestone @(i + 1)</label>
                        <input id="stage-@suggestion.Id-@i" name="stages" maxlength="200" class="form-control tw:min-h-11 tw:w-full tw:rounded-lg tw:border-2 tw:border-sb-muted/40 tw:bg-sb-card tw:px-3 tw:py-2 tw:text-sb-ink tw:focus:border-sb-blue-strong tw:focus:outline-none tw:focus:ring-2 tw:focus:ring-sb-blue/70 tw:dark:border-sb-night-ink/50 tw:dark:bg-sb-night-card tw:dark:text-sb-night-ink mb-2 tw:mb-2" />
                    }
                    <button type="submit" name="decision" value="Add" class="btn tw:inline-flex tw:items-center tw:justify-center tw:gap-2 tw:rounded-xl tw:border-2 tw:border-sb-ink tw:px-4 tw:py-2 tw:font-extrabold tw:shadow-sb-small tw:transition-transform tw:hover:translate-x-[2px] tw:hover:translate-y-[2px] tw:dark:border-sb-night-ink btn-success tw:bg-sb-sage-deep tw:text-sb-ink">Add skill</button>
                </details>
                <button type="submit" name="decision" value="Decline" class="btn tw:inline-flex tw:items-center tw:justify-center tw:gap-2 tw:rounded-xl tw:border-2 tw:border-sb-ink tw:px-4 tw:py-2 tw:font-extrabold tw:shadow-sb-small tw:transition-transform tw:hover:translate-x-[2px] tw:hover:translate-y-[2px] tw:dark:border-sb-night-ink btn-outline-secondary tw:bg-sb-card tw:text-sb-ink">Decline suggestion</button>
            </form>
        </article>
    }
</main>
