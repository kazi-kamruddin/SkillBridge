@model List<SkillBridge.Models.Notification>
@{
    ViewBag.Title = "Notifications";
}

@section Styles {
    <style>
        .notification-container {
            max-width: 880px;
            margin: 2rem auto;
            padding: 0 15px;
        }

        .notification-header {
            display: flex;
            flex-wrap: wrap;
            gap: 0.75rem;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 2rem;
            padding-bottom: 1rem;
            border-bottom: 2px solid var(--sb-line);
        }

        .notification-title {
            font-weight: 850;
            color: var(--sb-ink);
            margin: 0;
        }

        .btn-modern {
            border-radius: 10px;
            padding: 0.5rem 1.2rem;
            font-weight: 800;
        }

        .btn-primary-modern {
            background: var(--sb-blue-strong);
            color: #ffffff;
        }

        .notification-list {
            border-radius: 16px;
            overflow: hidden;
        }

        .notification-item {
            padding: 1.5rem;
            background: var(--sb-card);
            color: var(--sb-ink);
            border: 2px solid var(--sb-line);
            border-radius: 14px;
            margin-bottom: 0.85rem;
            box-shadow: var(--sb-card-shadow-small);
        }

        .notification-item.unread {
            background: var(--sb-blue);
            border-left: 5px solid var(--sb-blue-strong);
        }

        .notification-content {
            flex: 1;
            min-width: 0;
        }

        .notification-message {
            margin-bottom: 0.5rem;
            font-size: 1rem;
            font-weight: 700;
            line-height: 1.5;
            color: var(--sb-ink);
            overflow-wrap: anywhere;
        }

        .notification-time {
            font-size: 0.85rem;
            color: var(--sb-muted);
            display: flex;
            align-items: center;
        }

        .notification-time i {
            margin-right: 5px;
        }

        .notification-actions {
            display: flex;
            flex-direction: column;
            gap: 10px;
        }

        .btn-sm-modern {
            border-radius: 8px;
            padding: 0.4rem 0.8rem;
            font-size: 0.85rem;
            font-weight: 750;
        }

        .btn-success-modern {
            background: #2f7d64;
            color: #fff;
        }

        .btn-danger-modern {
            background: #c93b2b;
            color: #fff;
        }

        .btn-secondary-modern {
            background: var(--sb-sage);
            color: var(--sb-ink);
        }

        .skill-selection {
            background: var(--sb-sage);
            color: var(--sb-ink);
            padding: 1rem;
            border-radius: 10px;
            margin-top: 1rem;
            border: 2px solid var(--sb-line);
        }

        .empty-state {
            text-align: center;
            padding: 3rem 1rem;
            color: var(--sb-ink);
            background: var(--sb-card);
            border: 2px dashed var(--sb-line);
            border-radius: 16px;
        }

        .empty-state i {
            font-size: 3.5rem;
            margin-bottom: 1rem;
            color: var(--sb-muted);
        }

        .empty-state h3 {
            font-weight: 800;
            color: var(--sb-ink);
            margin-bottom: 0.5rem;
        }

        .empty-state p {
            color: var(--sb-muted);
        }

        .badge-notification {
            background: #c93b2b;
            color: white;
            border-radius: 50%;
            width: 26px;
            height: 26px;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            font-size: 0.78rem;
            font-weight: 800;
            margin-left: 6px;
            border: 2px solid var(--sb-line);
        }
    </style>
}
    @Html.AntiForgeryToken()
    <div class="notification-container">
        @if (!Model.Any())
        {
            <div class="empty-state">
                <i class="far fa-bell"></i>
                <h3>No notifications</h3>
                <p>You're all caught up! Check back later for new notifications.</p>
            </div>
        }
        else
        {
            <div class="notification-header">
                <h1 class="notification-title">
                    Notifications
                    @if (Model.Any(n => !n.IsRead))
                    {
                        <span class="badge-notification">@Model.Count(n => !n.IsRead)</span>
                    }
                </h1>
                <button id="markAllReadBtn" class="btn tw:inline-flex tw:items-center tw:justify-center tw:gap-2 tw:rounded-xl tw:border-2 tw:border-sb-ink tw:px-4 tw:py-2 tw:font-extrabold tw:shadow-sb-small tw:transition-transform tw:hover:translate-x-[2px] tw:hover:translate-y-[2px] tw:dark:border-sb-night-ink btn-primary-modern btn-modern">
                    <i class="fas fa-check-double me-2 tw:me-2"></i>Mark All as Read
                </button>
            </div>

            <div class="notification-list">
                @{ var shownUpdatesHeading = false; }
                @foreach (var n in Model)
                {
                    if (n.Type != "SkillRequest" && !shownUpdatesHeading)
                    {
                        shownUpdatesHeading = true;
                        <h2 class="h5 px-4 tw:px-6 pt-3 tw:pt-4">Updates</h2>
                    }
                    else if (n.Type == "SkillRequest" && n == Model.First())
                    {
                        <h2 class="h5 px-4 tw:px-6 pt-3 tw:pt-4">Action needed</h2>
                    }
                    <div class="notification-item d-flex tw:flex tw:flex-col tw:sm:flex-row tw:gap-4 justify-content-between tw:justify-between align-items-start tw:items-start @(n.IsRead ? "" : "unread")" data-id="@n.Id">
                        <div class="notification-content">
                            <div class="notification-message">@n.Message</div>
                            <div class="notification-time">
                                <i class="far fa-clock"></i>@n.CreatedAt.ToLocalTime().ToString("g")
                            </div>

                            @if (n.Type == "SkillRequest")
                            {
                                <a href="@Url.Action("RequestDetails", "Profile", new { id = n.ReferenceId })" class="d-block tw:block mb-2 tw:mb-2">Read exchange proposal</a>
                                <div class="skill-selection tw:hidden" data-id="@n.Id">
                                    <label class="skill-selection-label form-label tw:mb-1 tw:block tw:font-bold fw-semibold tw:font-semibold" for="skill-dropdown-@n.Id">Choose exchange mode:</label>
                                    <select id="skill-dropdown-@n.Id" class="form-control tw:min-h-11 tw:w-full tw:rounded-lg tw:border-2 tw:border-sb-muted/40 tw:bg-sb-card tw:px-3 tw:py-2 tw:text-sb-ink tw:focus:border-sb-blue-strong tw:focus:outline-none tw:focus:ring-2 tw:focus:ring-sb-blue/70 tw:dark:border-sb-night-ink/50 tw:dark:bg-sb-night-card tw:dark:text-sb-night-ink form-control-modern skill-dropdown" data-id="@n.Id"></select>
                                    <button type="button" class="btn tw:inline-flex tw:items-center tw:justify-center tw:gap-2 tw:rounded-xl tw:border-2 tw:border-sb-ink tw:px-4 tw:py-2 tw:font-extrabold tw:shadow-sb-small tw:transition-transform tw:hover:translate-x-[2px] tw:hover:translate-y-[2px] tw:dark:border-sb-night-ink btn-primary-modern btn-sm-modern mt-2 tw:mt-2 initialize-btn" data-id="@n.Id">
                                        <i class="fas fa-play-circle me-1 tw:me-1"></i>Start Interaction
                                    </button>
                                </div>
                            }
                            else if (n.Type == "Exchange" || n.Type == "RequestUpdate" || n.Type == "Skill" || n.Type == "Catalog" || n.Type == "Community" ||
                                (n.Type == "Info" && n.ReferenceId.HasValue))
                            {
                                <a href="@SkillBridge.Helpers.NotificationLinkHelper.Resolve(n, Url)" class="d-block tw:block mb-2 tw:mb-2">View update</a>
                            }
                        </div>

                        <div class="notification-actions tw:w-full tw:sm:w-auto tw:sm:min-w-[180px]">
                            @if (n.Type == "SkillRequest")
                            {
                                <div class="notification-decision-buttons d-flex tw:flex tw:flex-wrap gap-2 tw:gap-2">
                                    <button type="button" class="btn tw:inline-flex tw:items-center tw:justify-center tw:gap-2 tw:rounded-xl tw:border-2 tw:border-sb-ink tw:px-4 tw:py-2 tw:font-extrabold tw:shadow-sb-small tw:transition-transform tw:hover:translate-x-[2px] tw:hover:translate-y-[2px] tw:dark:border-sb-night-ink btn-success-modern btn-sm-modern accept-btn" data-id="@n.Id">
                                        <i class="fas fa-check me-1 tw:me-1"></i>Accept
                                    </button>
                                    <button type="button" class="btn tw:inline-flex tw:items-center tw:justify-center tw:gap-2 tw:rounded-xl tw:border-2 tw:border-sb-ink tw:px-4 tw:py-2 tw:font-extrabold tw:shadow-sb-small tw:transition-transform tw:hover:translate-x-[2px] tw:hover:translate-y-[2px] tw:dark:border-sb-night-ink btn-danger-modern btn-sm-modern decline-btn" data-id="@n.Id">
                                        <i class="fas fa-times me-1 tw:me-1"></i>Decline
                                    </button>
                                </div>
                            }
                            else if (n.Type != "Feedback" && !n.IsRead)
                            {
                                <button type="button" class="btn tw:inline-flex tw:items-center tw:justify-center tw:gap-2 tw:rounded-xl tw:border-2 tw:border-sb-ink tw:px-4 tw:py-2 tw:font-extrabold tw:shadow-sb-small tw:transition-transform tw:hover:translate-x-[2px] tw:hover:translate-y-[2px] tw:dark:border-sb-night-ink btn-secondary-modern btn-sm-modern mark-read" data-id="@n.Id">
                                    <i class="fas fa-eye me-1 tw:me-1"></i>Mark as Read
                                </button>
                            }
                            else if (n.Type == "Feedback" && !n.IsRead)
                            {
                                <div class="d-flex tw:flex flex-column tw:flex-col gap-2 tw:gap-2">
                                    <a href="@Url.Action("RateInteraction", "Interactions", new { interactionId = n.ReferenceId })" class="btn tw:inline-flex tw:items-center tw:justify-center tw:gap-2 tw:rounded-xl tw:border-2 tw:border-sb-ink tw:px-4 tw:py-2 tw:font-extrabold tw:shadow-sb-small tw:transition-transform tw:hover:translate-x-[2px] tw:hover:translate-y-[2px] tw:dark:border-sb-night-ink btn-primary-modern btn-sm-modern">
                                        <i class="fas fa-star me-1 tw:me-1"></i>Rate the Interaction
                                    </a>
                                    <button type="button" class="btn tw:inline-flex tw:items-center tw:justify-center tw:gap-2 tw:rounded-xl tw:border-2 tw:border-sb-ink tw:px-4 tw:py-2 tw:font-extrabold tw:shadow-sb-small tw:transition-transform tw:hover:translate-x-[2px] tw:hover:translate-y-[2px] tw:dark:border-sb-night-ink btn-secondary-modern btn-sm-modern mark-read" data-id="@n.Id">
                                        <i class="fas fa-eye me-1 tw:me-1"></i>Mark as Read
                                    </button>
                                </div>
                            }
                        </div>
                    </div>
                }
            </div>
        }
    </div>

@section Scripts {
    <script>
        $(document).ready(function () {
            var verificationToken = $('input[name="__RequestVerificationToken"]').val();
            $(document).on("click", ".mark-read", function () {
                var btn = $(this);
                var id = btn.data("id");
                $.post("/Notifications/MarkAsRead/" + id, { __RequestVerificationToken: verificationToken }, function (res) {
                    if (res.success) {
                        var item = btn.closest(".notification-item");
                        item.removeClass("unread");
                        btn.closest(".notification-actions").html('');
                        updateNotificationCount();
                    }
                });
            });

            // decline request
            $(document).on("click", ".decline-btn", function () {
                var btn = $(this);
                var id = btn.data("id");
                btn.prop("disabled", true);
                $.post("/Notifications/DeclineSkillRequest", { notificationId: id, __RequestVerificationToken: verificationToken }, function (res) {
                    if (res.success) {
                        btn.closest(".notification-item").fadeOut(300, function () {
                            $(this).remove();
                            updateNotificationCount();
                        });
                    } else {
                        btn.prop("disabled", false);
                    }
                }).fail(function () {
                    btn.prop("disabled", false);
                });
            });

            // accept request
            $(document).on("click", ".accept-btn", function () {
                var btn = $(this);
                var id = btn.data("id");
                var container = $(".skill-selection[data-id='" + id + "']");
                var dropdown = container.find(".skill-dropdown");
                var label = container.find(".skill-selection-label");
                btn.prop("disabled", true);

                $.get("/Notifications/AcceptSkillRequest", { notificationId: id }, function (res) {
                    if (!res || res.canAcceptOneWay === false) {
                        btn.prop("disabled", false);
                        alert("This request is no longer available.");
                        return;
                    }

                    dropdown.empty();
                    if (res.skills && res.skills.length > 0) {
                        label.text("Select a skill to learn back (or accept as 1-way mentorship):");
                        $.each(res.skills, function (i, skill) {
                            dropdown.append($('<option>').val(skill.skillId).text('Swap: learn ' + skill.name));
                        });
                    } else {
                        label.text("No reciprocal match listed — start as 1-way mentorship:");
                    }
                    dropdown.append($('<option>').val('').text('Accept as 1-way mentorship (teach without learning back)'));

                    container.removeClass("d-none tw:hidden");
                    btn.closest('.notification-decision-buttons').hide();
                }).fail(function () {
                    btn.prop("disabled", false);
                    alert("Could not load exchange options. Please try again.");
                });
            });

            // initiate interaction
            $(document).on("click", ".initialize-btn", function () {
                var btn = $(this);
                var id = btn.data("id");
                var dropdown = $(".skill-selection[data-id='" + id + "']").find(".skill-dropdown");
                var selectedSkillId = dropdown.val() || "";
                btn.prop("disabled", true);

                $.post("/Notifications/InitializeInteraction", {
                    notificationId: id,
                    skillId: selectedSkillId,
                    __RequestVerificationToken: verificationToken
                }, function (res) {
                    if (res && res.success) {
                        btn.closest(".notification-item").fadeOut(300, function () {
                            $(this).remove();
                            updateNotificationCount();
                        });
                    } else {
                        btn.prop("disabled", false);
                        alert("Failed to initialize interaction.");
                    }
                }).fail(function () {
                    btn.prop("disabled", false);
                    alert("Failed to initialize interaction. Please try again.");
                });
            });

            // Mark all notifications as read
            $("#markAllReadBtn").click(function () {
                if (!confirm("Mark all notifications as read?")) return;

                $.post("/Notifications/MarkAllAsRead", { __RequestVerificationToken: verificationToken }, function (res) {
                    if (res.success) {
                        $(".notification-item.unread").removeClass("unread");
                        $(".notification-item:not(:has(.skill-selection)) .notification-actions").html('');
                        $("#markAllReadBtn").prop('disabled', true).html('<i class="fas fa-check me-2 tw:me-2"></i>All Read');
                        updateNotificationCount();
                    } else {
                        alert("Failed to mark all as read.");
                    }
                });
            });

            function updateNotificationCount() {
                var unreadCount = $(".notification-item.unread").length;
                if (unreadCount === 0) {
                    $(".badge-notification").remove();
                    $("#notificationBadge").text("0");
                } else {
                    $(".badge-notification").text(unreadCount);
                    $("#notificationBadge").text(unreadCount);
                }
            }
        });
    </script>
}
