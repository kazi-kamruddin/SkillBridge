@model SkillBridge.Models.ResetPasswordViewModel
@{
    ViewBag.Title = "Reset password";
}
<main class="container sb-account-simple" aria-labelledby="title">
    <div class="sb-account-panel">
        <span class="sb-eyebrow">Account access</span>
        <h1 id="title">Reset your password.</h1>
        <p class="text-muted">Choose a new password to get back to your account.</p>
        @using (Html.BeginForm("ResetPassword", "Account", FormMethod.Post, new { role = "form" }))
        {
            @Html.AntiForgeryToken()
            @Html.ValidationSummary("", new { @class = "text-danger" })
            @Html.HiddenFor(model => model.Code)
            <div class="mb-3">@Html.LabelFor(m => m.Email, new { @class = "form-label fw-bold" })@Html.TextBoxFor(m => m.Email, new { @class = "form-control", autocomplete = "email", type = "email" })</div>
            <div class="mb-3">@Html.LabelFor(m => m.Password, new { @class = "form-label fw-bold" })@Html.PasswordFor(m => m.Password, new { @class = "form-control", autocomplete = "new-password" })</div>
            <div class="mb-4">@Html.LabelFor(m => m.ConfirmPassword, new { @class = "form-label fw-bold" })@Html.PasswordFor(m => m.ConfirmPassword, new { @class = "form-control", autocomplete = "new-password" })</div>
            <button type="submit" class="btn btn-primary">Reset password</button>
        }
    </div>
</main>
@section Scripts {
    <script src="~/Scripts/jquery.validate.min.js"></script>
    <script src="~/Scripts/jquery.validate.unobtrusive.min.js"></script>
}
