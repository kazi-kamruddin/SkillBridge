@model SkillBridge.Models.RegisterViewModel
@{
    ViewBag.Title = "Register";
}

@section Styles {
    <link rel="stylesheet" href="~/Styles/register.css" />
}

<div class="d-flex tw:flex justify-content-center tw:justify-center align-items-center tw:items-center sb-auth-screen">
    <div class="card tw:rounded-2xl tw:border-2 tw:border-sb-ink tw:bg-sb-card tw:text-sb-ink tw:shadow-sb-small tw:dark:border-sb-night-ink tw:dark:bg-sb-night-card tw:dark:text-sb-night-ink shadow tw:shadow-sb sb-auth-card sb-register-card">

        <!-- Left Side (Red Banner with Switch to Login) -->
        <div class="sb-auth-aside sb-auth-aside-red">
            <span class="sb-auth-symbol" aria-hidden="true">✳</span>
            <h2 class="mb-3 tw:mb-4">Already a member?</h2>
            <p>Log in to pick up your exchanges and keep learning.</p>
            <a href="@Url.Action("Login", "Account")" class="btn btn-light sb-auth-switch-link" data-auth-target="login">Sign In</a>
        </div>

        <!-- Right Side (Register Form) -->
        <div class="sb-auth-form">
            <span class="sb-eyebrow">YOUR NEXT SKILL STARTS HERE</span>
            <h1 class="mb-4 tw:mb-6">Join the exchange.</h1>
            <p class="text-muted tw:text-sb-muted tw:dark:text-sb-night-ink/70 small tw:text-sm">Create your account, then add your name to explore. Add skills whenever you're ready to connect with another member. You can keep your profile private from signed-out visitors.</p>

            @using (Html.BeginForm("Register", "Account", FormMethod.Post, new { role = "form" }))
            {
                @Html.AntiForgeryToken()
                @Html.ValidationSummary("", new { @class = "text-danger tw:text-[#a34f42]" })

                <!-- Email -->
                <div class="form-group tw:mb-4 mb-3">
                    @Html.LabelFor(m => m.Email)
                    <div class="input-group">
                        <span class="input-group-text">
                            <svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="5" width="18" height="14" rx="2"/><path d="m3 7 9 6 9-6"/></svg>
                        </span>
                        @Html.TextBoxFor(m => m.Email, new { @class = "form-control tw:min-h-11 tw:w-full tw:rounded-none tw:border-2 tw:border-sb-muted/40 tw:bg-sb-card tw:px-3 tw:py-2 tw:text-sb-ink tw:focus:border-sb-blue-strong tw:focus:outline-none tw:focus:ring-2 tw:focus:ring-sb-blue/70 tw:dark:border-sb-night-ink/50 tw:dark:bg-sb-night-card tw:dark:text-sb-night-ink", placeholder = "Enter your email" })
                    </div>
                </div>

                <!-- Password with Show/Hide Toggle -->
                <div class="form-group tw:mb-4 mb-3">
                    @Html.LabelFor(m => m.Password)
                    <div class="input-group">
                        <span class="input-group-text">
                            <svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="5" y="10" width="14" height="11" rx="2"/><path d="M8 10V7a4 4 0 0 1 8 0v3"/></svg>
                        </span>
                        @Html.PasswordFor(m => m.Password, new { @class = "form-control tw:min-h-11 tw:w-full tw:border-2 tw:border-r-0 tw:border-sb-muted/40 tw:bg-sb-card tw:px-3 tw:py-2 tw:text-sb-ink tw:focus:border-sb-blue-strong tw:focus:outline-none tw:focus:ring-2 tw:focus:ring-sb-blue/70 tw:dark:border-sb-night-ink/50 tw:dark:bg-sb-night-card tw:dark:text-sb-night-ink", placeholder = "Enter your password" })
                        <button type="button" class="btn sb-password-toggle tw:inline-flex tw:items-center tw:justify-center tw:px-3 tw:border-2 tw:border-l-0 tw:border-sb-muted/40 tw:bg-sb-card tw:text-sb-ink tw:hover:bg-sb-blue tw:focus:outline-none tw:dark:border-sb-night-ink/50 tw:dark:bg-sb-night-card tw:dark:text-sb-night-ink tw:dark:hover:bg-sb-blue" aria-label="Show password" title="Show password">
                            <svg class="sb-eye-icon" aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <path d="M2 12s3-7 10-7 10 7 10 7-3 7-10 7-10-7-10-7Z"/>
                                <circle cx="12" cy="12" r="3"/>
                            </svg>
                            <svg class="sb-eye-off-icon tw:hidden" aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <path d="M9.88 9.88a3 3 0 1 0 4.24 4.24"/>
                                <path d="M10.73 5.08A10.43 10.43 0 0 1 12 5c7 0 10 7 10 7a13.16 13.16 0 0 1-1.67 2.68"/>
                                <path d="M6.61 6.61A13.526 13.526 0 0 0 2 12s3 7 10 7a9.74 9.74 0 0 0 5.39-1.61"/>
                                <line x1="2" y1="2" x2="22" y2="22"/>
                            </svg>
                        </button>
                    </div>
                </div>

                <!-- Confirm Password with Show/Hide Toggle -->
                <div class="form-group tw:mb-4 mb-4 tw:mb-6">
                    @Html.LabelFor(m => m.ConfirmPassword)
                    <div class="input-group">
                        <span class="input-group-text">
                            <svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="5" y="10" width="14" height="11" rx="2"/><path d="M8 10V7a4 4 0 0 1 8 0v3"/></svg>
                        </span>
                        @Html.PasswordFor(m => m.ConfirmPassword, new { @class = "form-control tw:min-h-11 tw:w-full tw:border-2 tw:border-r-0 tw:border-sb-muted/40 tw:bg-sb-card tw:px-3 tw:py-2 tw:text-sb-ink tw:focus:border-sb-blue-strong tw:focus:outline-none tw:focus:ring-2 tw:focus:ring-sb-blue/70 tw:dark:border-sb-night-ink/50 tw:dark:bg-sb-night-card tw:dark:text-sb-night-ink", placeholder = "Confirm your password" })
                        <button type="button" class="btn sb-password-toggle tw:inline-flex tw:items-center tw:justify-center tw:px-3 tw:border-2 tw:border-l-0 tw:border-sb-muted/40 tw:bg-sb-card tw:text-sb-ink tw:hover:bg-sb-blue tw:focus:outline-none tw:dark:border-sb-night-ink/50 tw:dark:bg-sb-night-card tw:dark:text-sb-night-ink tw:dark:hover:bg-sb-blue" aria-label="Show password" title="Show password">
                            <svg class="sb-eye-icon" aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <path d="M2 12s3-7 10-7 10 7 10 7-3 7-10 7-10-7-10-7Z"/>
                                <circle cx="12" cy="12" r="3"/>
                            </svg>
                            <svg class="sb-eye-off-icon tw:hidden" aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <path d="M9.88 9.88a3 3 0 1 0 4.24 4.24"/>
                                <path d="M10.73 5.08A10.43 10.43 0 0 1 12 5c7 0 10 7 10 7a13.16 13.16 0 0 1-1.67 2.68"/>
                                <path d="M6.61 6.61A13.526 13.526 0 0 0 2 12s3 7 10 7a9.74 9.74 0 0 0 5.39-1.61"/>
                                <line x1="2" y1="2" x2="22" y2="22"/>
                            </svg>
                        </button>
                    </div>
                </div>

                <button type="submit" class="btn tw:inline-flex tw:items-center tw:justify-center tw:gap-2 tw:rounded-xl tw:border-2 tw:border-sb-ink tw:px-4 tw:py-2 tw:font-extrabold tw:shadow-sb-small tw:transition-transform tw:hover:translate-x-[2px] tw:hover:translate-y-[2px] tw:dark:border-sb-night-ink btn-primary tw:bg-sb-blue-strong tw:text-white sb-auth-submit w-100 tw:w-full">
                    Create account
                </button>
            }
            @if (ViewBag.GoogleEnabled == true)
            {
                <form method="post" action="@Url.Action("GoogleSignIn", "Account")" class="mt-3 tw:mt-4">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn tw:inline-flex tw:items-center tw:justify-center tw:gap-2 tw:rounded-xl tw:border-2 tw:border-sb-ink tw:px-4 tw:py-2 tw:font-extrabold tw:shadow-sb-small tw:transition-transform tw:hover:translate-x-[2px] tw:hover:translate-y-[2px] tw:dark:border-sb-night-ink btn-outline-secondary tw:bg-sb-card tw:text-sb-ink w-100 tw:w-full">Continue with Google</button>
                </form>
            }
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/Scripts/jquery.validate.min.js"></script>
    <script src="~/Scripts/jquery.validate.unobtrusive.min.js"></script>
}
