@model SkillBridge.Models.RegisterViewModel
@{
    ViewBag.Title = "Register";
}

@section Styles {
    <link rel="stylesheet" href="~/Styles/register.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons/font/bootstrap-icons.css">
}

<div class="d-flex justify-content-center align-items-center sb-auth-screen">
    <div class="card shadow p-4 sb-register-card">
        <span class="sb-eyebrow">YOUR NEXT SKILL STARTS HERE</span>
        <h1 class="mb-4">Join the exchange.</h1>
        <p class="text-muted small">Create your account, then add your name to explore. Add skills whenever you're ready to connect with another member. You can keep your profile private from signed-out visitors.</p>

        @using (Html.BeginForm("Register", "Account", FormMethod.Post, new { role = "form" }))
        {
            @Html.AntiForgeryToken()
            @Html.ValidationSummary("", new { @class = "text-danger" })

            <div class="form-group mb-3">
                @Html.LabelFor(m => m.Email)
                <div class="input-group">
                    <span class="input-group-text">
                        <i class="bi bi-envelope"></i>
                    </span>
                    @Html.TextBoxFor(m => m.Email, new { @class = "form-control", placeholder = "Enter your email" })
                </div>
            </div>

            <div class="form-group mb-3">
                @Html.LabelFor(m => m.Password)
                <div class="input-group">
                    <span class="input-group-text">
                        <i class="bi bi-lock"></i>
                    </span>
                    @Html.PasswordFor(m => m.Password, new { @class = "form-control", placeholder = "Enter your password" })
                </div>
            </div>

            <div class="form-group mb-4">
                @Html.LabelFor(m => m.ConfirmPassword)
                <div class="input-group">
                    <span class="input-group-text">
                        <i class="bi bi-lock-fill"></i>
                    </span>
                    @Html.PasswordFor(m => m.ConfirmPassword, new { @class = "form-control", placeholder = "Confirm your password" })
                </div>
            </div>

            <button type="submit" class="btn btn-primary sb-auth-submit w-100">
                Create account
            </button>
        }
        @if (ViewBag.GoogleEnabled == true)
        {
            <form method="post" action="@Url.Action("GoogleSignIn", "Account")" class="mt-3">
                @Html.AntiForgeryToken()
                <button type="submit" class="btn btn-outline-secondary w-100">Continue with Google</button>
            </form>
        }
    </div>
</div>

@section Scripts {
    <script src="~/Scripts/jquery.validate.min.js"></script>
<script src="~/Scripts/jquery.validate.unobtrusive.min.js"></script>
}
