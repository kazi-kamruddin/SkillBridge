@{
    ViewBag.Title = "Reset password confirmation";
}

<main class="container tw:mx-auto tw:w-full tw:max-w-[1400px] tw:px-4 sb-account-simple" aria-labelledby="title">
    <div class="sb-account-panel">
        <span class="sb-eyebrow">Account access</span>
        <h1 id="title">Password updated.</h1>
        <p>Your password has been reset. You can sign in with your new password.</p>
        @Html.ActionLink("Sign in", "Login", "Account", routeValues: null, htmlAttributes: new { id = "loginLink", @class = "btn tw:inline-flex tw:items-center tw:justify-center tw:gap-2 tw:rounded-xl tw:border-2 tw:border-sb-ink tw:px-4 tw:py-2 tw:font-extrabold tw:shadow-sb-small tw:transition-transform tw:hover:translate-x-[2px] tw:hover:translate-y-[2px] tw:dark:border-sb-night-ink btn-primary tw:bg-sb-blue-strong tw:text-white" })
    </div>
</main>
