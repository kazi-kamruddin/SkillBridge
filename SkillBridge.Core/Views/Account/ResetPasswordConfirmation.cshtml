@{
    ViewBag.Title = "Reset password confirmation";
}

<main class="container sb-account-simple" aria-labelledby="title">
    <div class="sb-account-panel">
        <span class="sb-eyebrow">Account access</span>
        <h1 id="title">Password updated.</h1>
        <p>Your password has been reset. You can sign in with your new password.</p>
        @Html.ActionLink("Sign in", "Login", "Account", routeValues: null, htmlAttributes: new { id = "loginLink", @class = "btn btn-primary" })
    </div>
</main>
