@model SkillBridge.Models.ForgotPasswordViewModel
@{
    ViewBag.Title = "Forgot your password?";
}
<main class="container tw:mx-auto tw:w-full tw:max-w-[1400px] tw:px-4 sb-account-simple" aria-labelledby="title">
    <div class="sb-account-panel">
        <span class="sb-eyebrow">Account access</span>
        <h1 id="title">Forgot your password?</h1>
        <p class="text-muted tw:text-sb-muted tw:dark:text-sb-night-ink/70">Enter the email address for your account and we'll send you a reset link.</p>
        @using (Html.BeginForm("ForgotPassword", "Account", FormMethod.Post, new { role = "form" }))
        {
            @Html.AntiForgeryToken()
            @Html.ValidationSummary("", new { @class = "text-danger tw:text-[#a34f42]" })
            <div class="mb-4 tw:mb-6">
                @Html.LabelFor(m => m.Email, new { @class = "form-label tw:mb-1 tw:block tw:font-bold fw-bold" })
                @Html.TextBoxFor(m => m.Email, new { @class = "form-control tw:min-h-11 tw:w-full tw:rounded-lg tw:border-2 tw:border-sb-muted/40 tw:bg-sb-card tw:px-3 tw:py-2 tw:text-sb-ink tw:focus:border-sb-blue-strong tw:focus:outline-none tw:focus:ring-2 tw:focus:ring-sb-blue/70 tw:dark:border-sb-night-ink/50 tw:dark:bg-sb-night-card tw:dark:text-sb-night-ink", autocomplete = "email", type = "email" })
            </div>
            <button type="submit" class="btn tw:inline-flex tw:items-center tw:justify-center tw:gap-2 tw:rounded-xl tw:border-2 tw:border-sb-ink tw:px-4 tw:py-2 tw:font-extrabold tw:shadow-sb-small tw:transition-transform tw:hover:translate-x-[2px] tw:hover:translate-y-[2px] tw:dark:border-sb-night-ink btn-primary tw:bg-sb-blue-strong tw:text-white">Email reset link</button>
        }
        <p class="sb-account-return"><a href="@Url.Action("Login", "Account")">Back to sign in</a></p>
    </div>
</main>
@section Scripts {
    <script src="~/Scripts/jquery.validate.min.js"></script>
    <script src="~/Scripts/jquery.validate.unobtrusive.min.js"></script>
}
