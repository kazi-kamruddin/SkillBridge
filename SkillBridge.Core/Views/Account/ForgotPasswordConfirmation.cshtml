@{
    ViewBag.Title = "Forgot Password Confirmation";
}

<main class="container sb-account-simple" aria-labelledby="title">
    <div class="sb-account-panel">
        <span class="sb-eyebrow">Account access</span>
        <h1 id="title">Check your email.</h1>
        <p>If an account exists for that email address, a password reset link will arrive shortly. The link expires after one hour.</p>
        <a href="@Url.Action("Login", "Account")">Back to sign in</a>
    </div>
</main>
