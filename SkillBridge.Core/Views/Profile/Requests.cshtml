@model List<SkillBridge.Models.SkillRequest>
@{
    ViewBag.Title = "Exchange Proposals";
    var myId = User.Identity.GetUserId();
}
<main class="container my-5">
    <h1 class="h2 mb-4">Exchange proposals</h1>
    @if (!Model.Any()) { <p>No proposals yet. <a href="@Url.Action("Index", "Explore")">Explore members</a>.</p> }
    @foreach (var request in Model)
    {
        <article class="card mb-3"><div class="card-body">
            <h2 class="h5">@request.Skill.Name</h2>
            <p class="mb-1">@(request.RequesterId == myId ? "Sent to" : "Received from") @(request.RequesterId == myId ? request.Receiver.UserName : request.Requester.UserName)</p>
            <p class="mb-1">Status: @request.Status</p>
            <a href="@Url.Action("RequestDetails", "Profile", new { id = request.Id })">View proposal</a>
            @if (request.ReceiverId == myId && request.Status == "Pending")
            {
                <span class="ms-3 badge bg-warning text-dark">Needs your response</span>
            }
        </div></article>
    }
</main>
