@model SkillBridge.Models.ChangePasswordViewModel
@{
    ViewBag.Title = "Change Password";
}

@section Styles {
    <link rel="stylesheet" href="~/Styles/changePassword.css" />
}

<main class="container tw:mx-auto tw:w-full tw:max-w-[540px] tw:px-4 tw:py-8 tw:my-6">
    <div class="card tw:overflow-hidden tw:rounded-2xl tw:border-2 tw:border-sb-border-card tw:bg-sb-card tw:p-6 tw:sm:p-8 tw:text-sb-ink tw:shadow-sb tw:dark:bg-sb-night-card tw:dark:text-sb-night-ink">
        <span class="sb-eyebrow tw:block tw:mb-1">SECURITY</span>
        <h1 class="h2 tw:mb-5">Change Password</h1>

        @using (Html.BeginForm("ChangePassword", "Profile", FormMethod.Post))
        {
            @Html.AntiForgeryToken()
            @Html.ValidationSummary(true, "", new { @class = "text-danger tw:text-sb-danger-text tw:font-semibold tw:mb-4" })

            <div class="form-group tw:mb-4">
                @Html.LabelFor(m => m.OldPassword, new { @class = "form-label tw:mb-1 tw:block tw:font-bold" })
                @Html.PasswordFor(m => m.OldPassword, new { @class = "form-control tw:min-h-11 tw:w-full tw:rounded-lg tw:border-2 tw:border-sb-border-control tw:bg-sb-surface-sunken tw:px-3 tw:py-2 tw:text-sb-ink tw:focus:border-sb-border-focus tw:focus:outline-none", placeholder = "Enter Old Password" })
            </div>

            <div class="form-group tw:mb-4">
                @Html.LabelFor(m => m.NewPassword, new { @class = "form-label tw:mb-1 tw:block tw:font-bold" })
                @Html.PasswordFor(m => m.NewPassword, new { @class = "form-control tw:min-h-11 tw:w-full tw:rounded-lg tw:border-2 tw:border-sb-border-control tw:bg-sb-surface-sunken tw:px-3 tw:py-2 tw:text-sb-ink tw:focus:border-sb-border-focus tw:focus:outline-none", placeholder = "Enter New Password" })
            </div>

            <div class="form-group tw:mb-5">
                @Html.LabelFor(m => m.ConfirmPassword, new { @class = "form-label tw:mb-1 tw:block tw:font-bold" })
                @Html.PasswordFor(m => m.ConfirmPassword, new { @class = "form-control tw:min-h-11 tw:w-full tw:rounded-lg tw:border-2 tw:border-sb-border-control tw:bg-sb-surface-sunken tw:px-3 tw:py-2 tw:text-sb-ink tw:focus:border-sb-border-focus tw:focus:outline-none", placeholder = "Confirm New Password" })
            </div>

            <div class="tw:flex tw:flex-wrap tw:gap-3">
                <button type="submit" class="btn tw:inline-flex tw:min-h-11 tw:flex-1 tw:items-center tw:justify-center tw:gap-2 tw:rounded-xl tw:border-2 tw:border-sb-border-control tw:px-5 tw:py-2.5 tw:font-extrabold tw:shadow-sb-small tw:transition-transform tw:hover:translate-x-[2px] tw:hover:translate-y-[2px] btn-primary tw:bg-sb-blue-strong tw:text-white">Update Password</button>
                <a href="@Url.Action("Index", "Profile")" class="btn tw:inline-flex tw:min-h-11 tw:items-center tw:justify-center tw:rounded-xl tw:border-2 tw:border-sb-border-control tw:px-4 tw:py-2.5 tw:font-extrabold tw:shadow-sb-small btn-outline-secondary tw:bg-sb-card tw:text-sb-ink tw:dark:bg-sb-night-card tw:dark:text-sb-night-ink">Cancel</a>
            </div>
        }
    </div>
</main>
