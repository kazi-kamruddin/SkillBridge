@model SkillBridge.Models.ChangePasswordViewModel
@{
    ViewBag.Title = "Change Password";
}

@section Styles {
    <link rel="stylesheet" href="~/Styles/changePassword.css" />
    <style>
        .change-card {
            width: min(100%, 400px);
            border-radius: 12px;
            padding: 30px 20px;
            box-shadow: 0 4px 20px rgba(0, 0, 0, 0.1);
        }

            .change-card h2 {
                text-align: center;
                margin-bottom: 30px;
            }

            .change-card .form-group {
                margin-bottom: 20px;
            }

            .change-card .form-control {
                width: 100%;
                border-radius: 25px;
                padding: 10px 15px;
            }

            .change-card .btn-submit {
                width: 100%;
                border-radius: 25px;
                background-color: #ff4b2b;
                color: white;
                font-weight: bold;
                transition: background-color 0.3s;
            }

                .change-card .btn-submit:hover {
                    background-color: #28a745; /* green on hover */
                }
    </style>
}

<div class="d-flex tw:flex justify-content-center tw:justify-center align-items-center tw:items-center" style="min-height: 80vh;">
    <div class="card tw:overflow-hidden tw:rounded-2xl tw:border-2 tw:border-sb-ink tw:bg-sb-card tw:text-sb-ink tw:shadow-sb-small tw:dark:border-sb-night-ink tw:dark:bg-sb-night-card tw:dark:text-sb-night-ink change-card">
        <h2>Change Password</h2>

        @using (Html.BeginForm("ChangePassword", "Profile", FormMethod.Post))
        {
            @Html.AntiForgeryToken()
            @Html.ValidationSummary(true, "", new { @class = "text-danger tw:text-[#a34f42]" })

            <div class="form-group tw:mb-4">
                @Html.LabelFor(m => m.OldPassword)
                @Html.PasswordFor(m => m.OldPassword, new { @class = "form-control tw:min-h-11 tw:w-full tw:rounded-lg tw:border-2 tw:border-sb-muted/40 tw:bg-sb-card tw:px-3 tw:py-2 tw:text-sb-ink tw:focus:border-sb-blue-strong tw:focus:outline-none tw:focus:ring-2 tw:focus:ring-sb-blue/70 tw:dark:border-sb-night-ink/50 tw:dark:bg-sb-night-card tw:dark:text-sb-night-ink", placeholder = "Enter Old Password" })
            </div>

            <div class="form-group tw:mb-4">
                @Html.LabelFor(m => m.NewPassword)
                @Html.PasswordFor(m => m.NewPassword, new { @class = "form-control tw:min-h-11 tw:w-full tw:rounded-lg tw:border-2 tw:border-sb-muted/40 tw:bg-sb-card tw:px-3 tw:py-2 tw:text-sb-ink tw:focus:border-sb-blue-strong tw:focus:outline-none tw:focus:ring-2 tw:focus:ring-sb-blue/70 tw:dark:border-sb-night-ink/50 tw:dark:bg-sb-night-card tw:dark:text-sb-night-ink", placeholder = "Enter New Password" })
            </div>

            <div class="form-group tw:mb-4">
                @Html.LabelFor(m => m.ConfirmPassword)
                @Html.PasswordFor(m => m.ConfirmPassword, new { @class = "form-control tw:min-h-11 tw:w-full tw:rounded-lg tw:border-2 tw:border-sb-muted/40 tw:bg-sb-card tw:px-3 tw:py-2 tw:text-sb-ink tw:focus:border-sb-blue-strong tw:focus:outline-none tw:focus:ring-2 tw:focus:ring-sb-blue/70 tw:dark:border-sb-night-ink/50 tw:dark:bg-sb-night-card tw:dark:text-sb-night-ink", placeholder = "Confirm New Password" })
            </div>

            <button type="submit" class="btn tw:inline-flex tw:items-center tw:justify-center tw:gap-2 tw:rounded-xl tw:border-2 tw:border-sb-ink tw:px-4 tw:py-2 tw:font-extrabold tw:shadow-sb-small tw:transition-transform tw:hover:translate-x-[2px] tw:hover:translate-y-[2px] tw:dark:border-sb-night-ink btn-submit mt-3 tw:mt-4">Submit</button>
        }
    </div>
</div>
