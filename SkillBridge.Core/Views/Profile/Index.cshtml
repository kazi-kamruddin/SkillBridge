@model SkillBridge.Models.IndexViewModel
@{
    ViewBag.Title = "Profile";
}

@section Styles {
    <link rel="stylesheet" href="~/Styles/indexProfile.css" />
}


<main class="container text-center mt-5 sb-public-profile sb-own-profile" aria-labelledby="title">

    <p class="text-success">@ViewBag.StatusMessage</p>
    @if (TempData["AccountNotice"] is string accountNotice) { <div class="alert alert-info" role="status">@accountNotice</div> }

    <div class="mb-3 text-center">
        <img src="@Model.ProfileImageUrl"
             alt="Profile Picture"
             class="rounded-circle"
             style="width:150px; height:150px; object-fit:cover; border:2px solid #ccc;" />
    </div>

    <span class="sb-eyebrow">YOUR SPACE ON SKILLBRIDGE</span>
    <h1 id="title">@Model.FullName</h1>
    @if (Model.TeachingSkills.Count == 0 || Model.LearningSkills.Count == 0)
    {
        <div class="alert alert-info text-start mx-auto" style="max-width:700px">You can browse SkillBridge now. Add a skill you can teach and one you want to learn before starting an exchange or conversation. <a href="@Url.Action("UpdateProfile", "Profile")">Add skills</a>.</div>
    }
    @if (Model.IsHidden) { <div class="alert alert-warning">Your profile is currently hidden from discovery. Contact the site moderator if you believe this is a mistake.</div> }
    <p class="small text-muted">Your profile is @(Model.IsPublic ? "visible to signed-out visitors" : "visible only to signed-in members"). <a href="@Url.Action("UpdateProfile", "Profile")">Change visibility</a></p>
    <nav aria-label="Profile actions" class="d-flex flex-wrap justify-content-center gap-2 my-3">
        <a class="btn btn-primary btn-sm" href="@Url.Action("UpdateProfile", "Profile")">Edit profile and skills</a>
        <a class="btn btn-outline-primary btn-sm" href="@Url.Action("Requests", "Profile")">Exchange proposals</a>
        <a class="btn btn-outline-primary btn-sm" href="@Url.Action("Index", "SavedProfiles")">Saved members</a>
        <a class="btn btn-outline-secondary btn-sm" href="@Url.Action("BlockedMembers", "Profile")">Blocked members</a>
    </nav>
    @if (Model.GoogleEnabled && !Model.GoogleLinked)
    {
        <form method="post" action="@Url.Action("LinkGoogle", "Account")">
            @Html.AntiForgeryToken()
            <button type="submit" class="btn btn-outline-primary btn-sm">Link Google sign-in</button>
        </form>
    }
    else if (Model.GoogleLinked) { <p class="small">Google sign-in linked.</p> }
    <p class="small">Email @(Model.EmailConfirmed ? "confirmed" : "not confirmed")</p>

    <p class="text-muted">@Model.Bio</p>
    @if (!string.IsNullOrWhiteSpace(Model.Location)) { <p><i class="bi bi-geo-alt"></i> @Model.Location</p> }

    <hr />

    <!-- Personal Information Section -->
    <div class="text-start mx-auto" style="max-width: 600px;">
        <h4 class="mt-4 mb-3">Personal Information</h4>
        <dl class="row">
            <dt class="col-sm-4">Profession:</dt>
            <dd class="col-sm-8">@Model.Profession</dd>

            <dt class="col-sm-4">Age:</dt>
            <dd class="col-sm-8">@(Model.Age?.ToString() ?? "Not added")</dd>
            <dt class="col-sm-4">Availability:</dt>
            <dd class="col-sm-8">@(string.IsNullOrWhiteSpace(Model.AvailabilityNotes) ? "Not set" : Model.AvailabilityNotes)</dd>
            <dt class="col-sm-4">Usual days:</dt>
            <dd class="col-sm-8">@(Model.AvailableDaysMask == 0 ? "Not set" : AvailabilityHelper.DescribeDays(Model.AvailableDaysMask))</dd>
            <dt class="col-sm-4">Time zone:</dt>
            <dd class="col-sm-8">@(Model.TimeZoneId ?? "Not set")</dd>
            <dt class="col-sm-4">Meeting format:</dt>
            <dd class="col-sm-8">@Model.MeetingFormat</dd>

            <dt class="col-sm-4">Average Rating:</dt>
            <dd class="col-sm-8">
                @Model.AverageRating.ToString("0.0") / 10
                (out of @Model.RatingsReceived rated interaction@(Model.RatingsReceived == 1 ? "" : "s"))
            </dd>
            <dt class="col-sm-4"></dt>
            <dd class="col-sm-8">
                Completed total @Model.InteractionsCompleted interaction@(Model.InteractionsCompleted == 1 ? "" : "s")
            </dd>

        </dl>
    </div>

    <!-- Teaching Skills -->
    <h4 class="mt-4 mb-3">Teaching Skills</h4>
    <div class="card shadow p-4 mx-auto" style="max-width: 600px;">
        @if (Model.TeachingSkills != null && Model.TeachingSkills.Count > 0)
        {
            foreach (var skill in Model.TeachingSkills)
            {
                var percent = skill.TotalStages > 0
                    ? Math.Min(100, skill.KnownUpToStage * 100 / skill.TotalStages) : 0;
                <div class="mb-3 text-start">
                    <label><strong>@skill.SkillName (@skill.CategoryName)</strong> — Stage @skill.KnownUpToStage of @skill.TotalStages</label>
                    <div class="progress" style="height: 25px;">
                        <div class="progress-bar bg-danger" role="progressbar"
                             style="width:@(percent)%;"
                             aria-valuenow="@(percent)"
                             aria-valuemin="0" aria-valuemax="100">
                            @(percent)%
                        </div>
                    </div>
                </div>
            }
        }
        else
        {
            <p>No teaching skills added.</p>
        }
    </div>

    <!-- Learning Skills -->
    <h4 class="mt-5 mb-3">Seeking to Learn</h4>
    <div class="d-flex flex-wrap justify-content-center gap-3">
        @if (Model.LearningSkills != null && Model.LearningSkills.Count > 0)
        {
            foreach (var skill in Model.LearningSkills)
            {
                <div class="card sb-learning-skill">
                    <div class="card-body p-2 text-center">
                        <span>@skill.SkillName </span>
                    </div>
                </div>
            }
        }
        else
        {
            <p>No learning skills added.</p>
        }
    </div>

    <div style="height: 45px;"></div>

    <div class="mt-4 d-flex justify-content-center gap-2 flex-wrap">
        <a class="btn btn-outline-primary" href="@Url.Action(Model.HasPassword ? "ChangePassword" : "SetPassword", "Profile")">@(Model.HasPassword ? "Change Password" : "Set Password")</a>
    </div>
</main>
