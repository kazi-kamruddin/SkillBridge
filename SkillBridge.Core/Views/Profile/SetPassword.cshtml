@model SkillBridge.Models.SetPasswordViewModel
@{ ViewBag.Title = "Set password"; }
<main class="container tw:mx-auto tw:w-full tw:max-w-[540px] tw:px-4 mt-5 tw:mt-8 tw:mb-8">
    <div class="card tw:overflow-hidden tw:rounded-2xl tw:border-2 tw:border-sb-border-card tw:bg-sb-card tw:p-6 tw:sm:p-8 tw:text-sb-ink tw:shadow-sb tw:dark:bg-sb-night-card tw:dark:text-sb-night-ink">
        <span class="sb-eyebrow tw:block tw:mb-1">SECURITY</span>
        <h1 class="h2 tw:mb-2">Set a password</h1>
        <p class="tw:text-sb-muted tw:mb-5">Use this password if you want to sign in without Google.</p>
        <form method="post" action="@Url.Action("SetPassword", "Profile")">
            @Html.AntiForgeryToken()
            @Html.ValidationSummary(true, "", new { @class = "text-danger tw:text-sb-danger-text tw:font-semibold tw:mb-3" })
            <div class="tw:mb-4">
                <label for="NewPassword" class="form-label tw:mb-1 tw:block tw:font-bold">New password</label>
                @Html.PasswordFor(m => m.NewPassword, new { @class = "form-control tw:min-h-11 tw:w-full tw:rounded-lg tw:border-2 tw:border-sb-border-control tw:bg-sb-surface-sunken tw:px-3 tw:py-2 tw:text-sb-ink tw:focus:border-sb-border-focus tw:focus:outline-none" })
                @Html.ValidationMessageFor(m => m.NewPassword, "", new { @class = "text-danger tw:text-sb-danger-text tw:text-sm tw:font-semibold" })
            </div>
            <div class="tw:mb-5">
                <label for="ConfirmPassword" class="form-label tw:mb-1 tw:block tw:font-bold">Confirm password</label>
                @Html.PasswordFor(m => m.ConfirmPassword, new { @class = "form-control tw:min-h-11 tw:w-full tw:rounded-lg tw:border-2 tw:border-sb-border-control tw:bg-sb-surface-sunken tw:px-3 tw:py-2 tw:text-sb-ink tw:focus:border-sb-border-focus tw:focus:outline-none" })
                @Html.ValidationMessageFor(m => m.ConfirmPassword, "", new { @class = "text-danger tw:text-sb-danger-text tw:text-sm tw:font-semibold" })
            </div>
            <button type="submit" class="btn tw:inline-flex tw:min-h-11 tw:w-full tw:items-center tw:justify-center tw:gap-2 tw:rounded-xl tw:border-2 tw:border-sb-border-control tw:px-4 tw:py-2.5 tw:font-extrabold tw:shadow-sb-small tw:transition-transform tw:hover:translate-x-[2px] tw:hover:translate-y-[2px] btn-primary tw:bg-sb-blue-strong tw:text-white">Set password</button>
        </form>
    </div>
</main>
