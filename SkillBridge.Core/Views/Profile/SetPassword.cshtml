@model SkillBridge.Models.SetPasswordViewModel
@{ ViewBag.Title = "Set password"; }
<main class="container tw:mx-auto tw:w-full tw:max-w-[1400px] tw:px-4 mt-5 tw:mt-8" style="max-width: 540px;">
    <h2>Set a password</h2>
    <p>Use this password if you want to sign in without Google.</p>
    <form method="post" action="@Url.Action("SetPassword", "Profile")">
        @Html.AntiForgeryToken()
        @Html.ValidationSummary(true, "", new { @class = "text-danger tw:text-[#a34f42]" })
        <label for="NewPassword" class="form-label tw:mb-1 tw:block tw:font-bold">New password</label>
        @Html.PasswordFor(m => m.NewPassword, new { @class = "form-control tw:min-h-11 tw:w-full tw:rounded-lg tw:border-2 tw:border-sb-muted/40 tw:bg-sb-card tw:px-3 tw:py-2 tw:text-sb-ink tw:focus:border-sb-blue-strong tw:focus:outline-none tw:focus:ring-2 tw:focus:ring-sb-blue/70 tw:dark:border-sb-night-ink/50 tw:dark:bg-sb-night-card tw:dark:text-sb-night-ink mb-2 tw:mb-2" })
        @Html.ValidationMessageFor(m => m.NewPassword, "", new { @class = "text-danger tw:text-[#a34f42]" })
        <label for="ConfirmPassword" class="form-label tw:mb-1 tw:block tw:font-bold">Confirm password</label>
        @Html.PasswordFor(m => m.ConfirmPassword, new { @class = "form-control tw:min-h-11 tw:w-full tw:rounded-lg tw:border-2 tw:border-sb-muted/40 tw:bg-sb-card tw:px-3 tw:py-2 tw:text-sb-ink tw:focus:border-sb-blue-strong tw:focus:outline-none tw:focus:ring-2 tw:focus:ring-sb-blue/70 tw:dark:border-sb-night-ink/50 tw:dark:bg-sb-night-card tw:dark:text-sb-night-ink mb-2 tw:mb-2" })
        @Html.ValidationMessageFor(m => m.ConfirmPassword, "", new { @class = "text-danger tw:text-[#a34f42]" })
        <button type="submit" class="btn tw:inline-flex tw:items-center tw:justify-center tw:gap-2 tw:rounded-xl tw:border-2 tw:border-sb-ink tw:px-4 tw:py-2 tw:font-extrabold tw:shadow-sb-small tw:transition-transform tw:hover:translate-x-[2px] tw:hover:translate-y-[2px] tw:dark:border-sb-night-ink btn-primary tw:bg-sb-blue-strong tw:text-white">Set password</button>
    </form>
</main>
