@model SkillBridge.Models.SetPasswordViewModel
@{ ViewBag.Title = "Set password"; }
<main class="container mt-5" style="max-width: 540px;">
    <h2>Set a password</h2>
    <p>Use this password if you want to sign in without Google.</p>
    <form method="post" action="@Url.Action("SetPassword", "Profile")">
        @Html.AntiForgeryToken()
        @Html.ValidationSummary(true, "", new { @class = "text-danger" })
        <label for="NewPassword" class="form-label">New password</label>
        @Html.PasswordFor(m => m.NewPassword, new { @class = "form-control mb-2" })
        @Html.ValidationMessageFor(m => m.NewPassword, "", new { @class = "text-danger" })
        <label for="ConfirmPassword" class="form-label">Confirm password</label>
        @Html.PasswordFor(m => m.ConfirmPassword, new { @class = "form-control mb-2" })
        @Html.ValidationMessageFor(m => m.ConfirmPassword, "", new { @class = "text-danger" })
        <button type="submit" class="btn btn-primary">Set password</button>
    </form>
</main>
