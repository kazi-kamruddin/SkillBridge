@model SkillBridge.Models.UpdateProfileViewModel
@using System.Collections.Generic
@using System.Linq
@{
    ViewBag.Title = "Update Profile";

    var boardModel = new SkillBridge.Models.SkillSelectionBoardViewModel
    {
        FormId = "updateProfileForm",
        AllSkillCategories = Model.AllSkillCategories ?? new List<SkillBridge.Models.SkillCategory>(),
        SkillsToLearn = Model.SkillsToLearn ?? new List<int>(),
        KnownSkillStages = (Model.SkillsIKnow ?? new List<SkillBridge.Models.UpdateProfileViewModel.UserKnownSkill>())
            .GroupBy(s => s.SkillId)
            .ToDictionary(g => g.Key, g => g.First().KnownUpToStage),
        VerifiedLearningStages = Model.VerifiedLearningStages ?? new Dictionary<int, int>()
    };
}

@section Styles {
    <link rel="stylesheet" href="~/Styles/updateProfile.css" />
}

<main class="container tw:mx-auto tw:w-full tw:max-w-[1400px] tw:px-4 mt-4 tw:mt-6">
    <h2>@ViewBag.Title</h2>
    @if (TempData["AccountNotice"] is string accountNotice) { <div class="alert tw:rounded-xl tw:border-2 tw:border-sb-border-card tw:p-4 tw:shadow-sb-small alert-info tw:bg-sb-blue tw:text-sb-ink" role="status">@accountNotice</div> }
    <p class="text-muted tw:text-sb-muted tw:dark:text-sb-night-ink/70">Add skills you can teach, skills you want to learn, or both—whatever fits your goals.</p>

    @using (Html.BeginForm("UpdateProfile", "Profile", FormMethod.Post, new { @id = "updateProfileForm", enctype = "multipart/form-data" }))
    {
        @Html.AntiForgeryToken()
        @Html.ValidationSummary(false, "", new { @class = "sb-validation-summary" })

        <div class="mb-3 tw:mb-4">
            @Html.LabelFor(m => m.FullName, new { @class = "form-label tw:mb-1 tw:block tw:font-bold" })
            @Html.TextBoxFor(m => m.FullName, new { @class = "form-control tw:min-h-11 tw:w-full tw:rounded-lg tw:border-2 tw:border-sb-border-control tw:bg-sb-surface-sunken tw:px-3 tw:py-2 tw:text-sb-ink tw:focus:border-sb-border-focus tw:focus:outline-none" })
            @Html.ValidationMessageFor(m => m.FullName, "", new { @class = "sb-field-error" })
        </div>

        <div class="mb-3 tw:mb-4">
            <label for="ProfileImage" class="form-label tw:mb-1 tw:block tw:font-bold">Profile photo (optional, up to 3 MB)</label>
            <div class="sb-avatar-picker" data-sb-avatar-picker data-sb-existing-avatar="@Model.ExistingProfileImageUrl">
                <div class="sb-avatar-preview" data-sb-avatar-preview>
                    <div class="sb-avatar-preview-slot" data-sb-avatar-img-slot>
                        <img src="@Model.ExistingProfileImageUrl" alt="Current profile photo" class="sb-avatar-preview-img" data-sb-avatar-img width="64" height="64" />
                    </div>
                    <div class="sb-avatar-preview-meta">
                        <span class="sb-avatar-preview-name" data-sb-avatar-name>Current profile photo</span>
                        <span class="sb-avatar-preview-size" data-sb-avatar-size></span>
                    </div>
                    <button type="button" class="sb-avatar-clear-btn tw:min-h-10" data-sb-avatar-clear hidden>Clear selection</button>
                </div>
                <input type="file"
                       id="ProfileImage"
                       name="ProfileImage"
                       data-sb-avatar-input
                       data-sb-avatar-max-bytes="3145728"
                       class="form-control tw:min-h-11 tw:w-full tw:rounded-lg tw:border-2 tw:border-sb-border-control tw:bg-sb-surface-sunken tw:px-3 tw:py-2 tw:text-sb-ink tw:focus:border-sb-border-focus tw:focus:outline-none"
                       accept="image/jpeg,image/png,image/webp" />
                <div class="sb-avatar-client-error" data-sb-avatar-error hidden role="alert"></div>
                <label class="form-check tw:inline-flex tw:min-h-[44px] tw:items-center tw:gap-2.5 mt-1 tw:cursor-pointer">
                    <input type="checkbox" name="RemoveProfileImage" value="true" checked="@Model.RemoveProfileImage" class="form-check-input tw:accent-sb-blue-strong" /> Remove current photo
                </label>
            </div>
            @Html.ValidationMessageFor(m => m.ProfileImage, "", new { @class = "sb-field-error" })
        </div>

        <div class="mb-3 tw:mb-4">
            @Html.LabelFor(m => m.Email, new { @class = "form-label tw:mb-1 tw:block tw:font-bold" })
            @Html.TextBoxFor(m => m.Email, new { @class = "form-control tw:min-h-11 tw:w-full tw:rounded-lg tw:border-2 tw:border-sb-border-control tw:bg-sb-surface-sunken tw:px-3 tw:py-2 tw:text-sb-ink tw:opacity-80", @readonly = "readonly" })
        </div>

        <div class="mb-3 tw:mb-4">
            @Html.LabelFor(m => m.Bio, new { @class = "form-label tw:mb-1 tw:block tw:font-bold" })
            @Html.TextAreaFor(m => m.Bio, new { @class = "form-control tw:min-h-11 tw:w-full tw:rounded-lg tw:border-2 tw:border-sb-border-control tw:bg-sb-surface-sunken tw:px-3 tw:py-2 tw:text-sb-ink tw:focus:border-sb-border-focus tw:focus:outline-none", rows = 3 })
        </div>

        <div class="form-check tw:flex tw:items-start tw:gap-3 mb-3 tw:mb-4">
            @Html.CheckBoxFor(m => m.IsPublic, new { @class = "form-check-input tw:mt-0.5 tw:accent-sb-blue-strong" })
            <div>
                @Html.LabelFor(m => m.IsPublic, "Allow signed-out visitors to view my profile", new { @class = "form-check-label tw:font-semibold tw:cursor-pointer" })
                <div class="form-text tw:mt-1 tw:block tw:text-sm tw:text-sb-muted tw:dark:text-sb-night-ink/70">When enabled, your name, location, profession, bio, skills and ratings are public. Leave unchecked to stay visible only to signed-in members. Your email and age always stay private.</div>
            </div>
        </div>

        <div class="mb-3 tw:mb-4">
            @Html.LabelFor(m => m.Profession, new { @class = "form-label tw:mb-1 tw:block tw:font-bold" })
            @Html.TextBoxFor(m => m.Profession, new { @class = "form-control tw:min-h-11 tw:w-full tw:rounded-lg tw:border-2 tw:border-sb-border-control tw:bg-sb-surface-sunken tw:px-3 tw:py-2 tw:text-sb-ink tw:focus:border-sb-border-focus tw:focus:outline-none", list = "profession-suggestions", maxlength = "100", placeholder = "Your profession or role" })
            <datalist id="profession-suggestions"><option value="Student"></option><option value="Teacher"></option><option value="Software Developer"></option><option value="Designer"></option><option value="Freelancer"></option></datalist>
        </div>

        <div class="mb-3 tw:mb-4">
            @Html.LabelFor(m => m.Location, new { @class = "form-label tw:mb-1 tw:block tw:font-bold" })
            @Html.TextBoxFor(m => m.Location, new { @class = "form-control tw:min-h-11 tw:w-full tw:rounded-lg tw:border-2 tw:border-sb-border-control tw:bg-sb-surface-sunken tw:px-3 tw:py-2 tw:text-sb-ink tw:focus:border-sb-border-focus tw:focus:outline-none", list = "location-suggestions", maxlength = "100", placeholder = "City or Online" })
            <datalist id="location-suggestions"><option value="Online"></option><option value="Dhaka"></option><option value="Chattogram"></option><option value="Khulna"></option><option value="Rajshahi"></option></datalist>
        </div>

        <div class="mb-3 tw:mb-4">
            @Html.LabelFor(m => m.Age, new { @class = "form-label tw:mb-1 tw:block tw:font-bold" })
            @Html.TextBoxFor(m => m.Age, new { @class = "form-control tw:min-h-11 tw:w-full tw:rounded-lg tw:border-2 tw:border-sb-border-control tw:bg-sb-surface-sunken tw:px-3 tw:py-2 tw:text-sb-ink tw:focus:border-sb-border-focus tw:focus:outline-none", type = "number", min = "0" })
        </div>

        <div class="mb-3 tw:mb-4">
            @Html.LabelFor(m => m.AvailabilityNotes, new { @class = "form-label tw:mb-1 tw:block tw:font-bold" })
            @Html.TextAreaFor(m => m.AvailabilityNotes, new { @class = "form-control tw:min-h-11 tw:w-full tw:rounded-lg tw:border-2 tw:border-sb-border-control tw:bg-sb-surface-sunken tw:px-3 tw:py-2 tw:text-sb-ink tw:focus:border-sb-border-focus tw:focus:outline-none", rows = 2, maxlength = "300", placeholder = "For example, weekday evenings in Dhaka time" })
            <div class="form-text tw:mt-1 tw:block tw:text-sm tw:text-sb-muted tw:dark:text-sb-night-ink/70">This appears on your profile, including to signed-out visitors when your profile is public.</div>
        </div>
        <fieldset class="mb-3 tw:mb-4">
            <legend class="h6 tw:font-bold tw:mb-2">Days you are usually available (optional)</legend>
            <div class="d-flex tw:flex flex-wrap tw:flex-wrap gap-3 tw:gap-3">
                @for (var day = 0; day < 7; day++)
                {
                    <label class="form-check-label tw:inline-flex tw:min-h-[44px] tw:items-center tw:gap-2 tw:rounded-lg tw:border tw:border-sb-border-control/40 tw:bg-sb-surface-raised tw:px-3 tw:py-1.5 tw:font-semibold tw:cursor-pointer"><input class="form-check-input tw:accent-sb-blue-strong" type="checkbox" name="AvailableDays" value="@day" checked="@(Model.AvailableDays?.Contains(day) == true)" />@AvailabilityHelper.DayNames[day]</label>
                }
            </div>
        </fieldset>
        <div class="mb-3 tw:mb-4">
            @Html.LabelFor(m => m.TimeZoneId, new { @class = "form-label tw:mb-1 tw:block tw:font-bold" })
            @Html.TextBoxFor(m => m.TimeZoneId, new { @class = "form-control tw:min-h-11 tw:w-full tw:rounded-lg tw:border-2 tw:border-sb-border-control tw:bg-sb-surface-sunken tw:px-3 tw:py-2 tw:text-sb-ink tw:focus:border-sb-border-focus tw:focus:outline-none", list = "time-zone-suggestions", maxlength = "80", placeholder = "For example, Asia/Dhaka" })
            <datalist id="time-zone-suggestions"><option value="Asia/Dhaka"></option><option value="Asia/Kolkata"></option><option value="UTC"></option><option value="Europe/London"></option><option value="America/New_York"></option></datalist>
            <div class="form-text tw:mt-1 tw:block tw:text-sm tw:text-sb-muted tw:dark:text-sb-night-ink/70">Use a standard time zone name so meeting times display correctly.</div>
            @Html.ValidationMessageFor(m => m.TimeZoneId, "", new { @class = "sb-field-error" })
        </div>
        <div class="mb-3 tw:mb-4">
            @Html.LabelFor(m => m.MeetingFormat, new { @class = "form-label tw:mb-1 tw:block tw:font-bold" })
            @Html.DropDownListFor(m => m.MeetingFormat, new SelectList(new[] { "Either", "Online", "In person" }, Model.MeetingFormat), new { @class = "form-select tw:min-h-11 tw:w-full tw:rounded-lg tw:border-2 tw:border-sb-border-control tw:bg-sb-surface-sunken tw:px-3 tw:py-2 tw:text-sb-ink tw:focus:border-sb-border-focus tw:focus:outline-none" })
        </div>

        <hr class="tw:my-6 tw:border-sb-border-card" />
        <partial name="_SkillSelectionBoard" model="boardModel" />

        <div class="mt-4 tw:mt-6 tw:flex tw:flex-wrap tw:items-center tw:gap-3">
            <button type="submit" class="btn tw:inline-flex tw:min-h-11 tw:items-center tw:justify-center tw:gap-2 tw:rounded-xl tw:border-2 tw:border-sb-border-control tw:px-5 tw:py-2.5 tw:font-extrabold tw:shadow-sb-small tw:transition-transform tw:hover:translate-x-[2px] tw:hover:translate-y-[2px] btn-success tw:bg-sb-sage-deep tw:text-white">Save Changes</button>
            <a href="@Url.Action("Index", "Profile")" class="btn tw:inline-flex tw:min-h-11 tw:items-center tw:justify-center tw:gap-2 tw:rounded-xl tw:border-2 tw:border-sb-border-control tw:px-5 tw:py-2.5 tw:font-extrabold tw:shadow-sb-small tw:transition-transform tw:hover:translate-x-[2px] tw:hover:translate-y-[2px] btn-outline-secondary tw:bg-sb-card tw:text-sb-ink tw:dark:bg-sb-night-card tw:dark:text-sb-night-ink">Cancel</a>
        </div>
    }
</main>

@section Scripts {
    <script src="~/Scripts/jquery.validate.min.js"></script>
    <script src="~/Scripts/jquery.validate.unobtrusive.min.js"></script>
    <script src="~/Scripts/skill-selection-board.js" asp-append-version="true"></script>

    <script>
        $(document).ready(function () {
            var $form = $("#updateProfileForm");
            $form.submit(function (e) {
                e.preventDefault();
                $form.find(".invalid-feedback").remove();
                $form.find(".is-invalid").removeClass("is-invalid");

                var firstInvalidField = null;
                function markInvalid($field, message) {
                    if (!firstInvalidField) firstInvalidField = $field;
                    $field.addClass("is-invalid");
                    if ($field.next(".invalid-feedback").length === 0) {
                        $("<div class='invalid-feedback'>" + message + "</div>").insertAfter($field);
                    }
                }

                if (!$.trim($form.find("input[name='FullName']").val())) markInvalid($("input[name='FullName']"), "Full Name is required");
                if (!$.trim($form.find("input[name='Email']").val())) markInvalid($("input[name='Email']"), "Email is required");

                var age = $form.find("input[name='Age']").val();
                if (age && parseInt(age, 10) <= 0) markInvalid($("input[name='Age']"), "Enter a valid age");

                var photoInput = document.getElementById("ProfileImage");
                if (photoInput && photoInput.files && photoInput.files[0] && photoInput.files[0].size > 3145728) {
                    var photoErr = document.querySelector("[data-sb-avatar-error]");
                    if (photoErr) {
                        photoErr.textContent = "Choose an image up to 3 MB.";
                        photoErr.hidden = false;
                    }
                    firstInvalidField = firstInvalidField || $(photoInput);
                }

                if (firstInvalidField) {
                    $('html, body').animate({ scrollTop: firstInvalidField.offset().top - 110 }, 300);
                    return false;
                }

                this.submit();
            });
        });
    </script>
}
