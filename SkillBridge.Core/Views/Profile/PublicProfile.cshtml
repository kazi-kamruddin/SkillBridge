@model SkillBridge.Models.PublicProfileViewModel


@section Styles {
    <link rel="stylesheet" href="~/Styles/publicProfile.css" />
}

<main class="container tw:mx-auto tw:w-full tw:max-w-[1400px] tw:px-4 mt-5 tw:mt-8 sb-public-profile sb-profile-redesign" aria-labelledby="title">
    @Html.AntiForgeryToken()
    @if (TempData["ProfileNotice"] is string notice) { <div class="alert tw:rounded-xl tw:border-2 tw:border-sb-ink tw:p-4 tw:shadow-sb-small alert-info tw:bg-sb-blue tw:text-sb-ink" role="status">@notice</div> }

    <header class="sb-profile-hero">
        <div class="sb-profile-hero-copy">
            <div class="sb-hero-kicker"><span class="sb-icon-tile sb-icon-tile-blue" aria-hidden="true"><svg class="sb-icon"><use href="#sb-i-people" /></svg></span><span class="sb-eyebrow">MEET YOUR NEXT LEARNING PARTNER</span></div>
            <h1 id="title">@Model.FullName</h1>
            @if (!string.IsNullOrWhiteSpace(Model.Profession) || !string.IsNullOrWhiteSpace(Model.Location)) { <p class="sb-profile-meta">@string.Join(" · ", new[] { Model.Profession, Model.Location }.Where(s => !string.IsNullOrWhiteSpace(s)))</p> }
            @if (!string.IsNullOrWhiteSpace(Model.Bio)) { <p class="sb-profile-bio">@Model.Bio</p> }
            <div class="sb-profile-facts">
                @if (!string.IsNullOrWhiteSpace(Model.AvailabilityNotes)) { <span><strong>Availability</strong> @Model.AvailabilityNotes</span> }
                @if (Model.AvailableDaysMask != 0) { <span><strong>Usual days</strong> @AvailabilityHelper.DescribeDays(Model.AvailableDaysMask)</span> }
                @if (!string.IsNullOrWhiteSpace(Model.TimeZoneId)) { <span><strong>Time zone</strong> @Model.TimeZoneId</span> }
                <span><strong>Meet</strong> @Model.MeetingFormat</span>
            </div>
        </div>
        <div class="sb-profile-portrait"><img src="@Model.ProfileImageUrl" alt="@Model.FullName" /></div>
    </header>

    @if (User.Identity.IsAuthenticated && Model.UserId != User.Identity.GetUserId())
    {
        <div class="sb-profile-actions">
            <form method="post" action="@Url.Action(Model.IsSaved ? "Remove" : "Save", "SavedProfiles")" class="mb-2 tw:mb-2">
                @Html.AntiForgeryToken()
                <input type="hidden" name="id" value="@Model.UserId" />
                <button type="submit" class="btn tw:inline-flex tw:items-center tw:justify-center tw:gap-2 tw:rounded-xl tw:border-2 tw:border-sb-ink tw:px-4 tw:py-2 tw:font-extrabold tw:shadow-sb-small tw:transition-transform tw:hover:translate-x-[2px] tw:hover:translate-y-[2px] tw:dark:border-sb-night-ink btn-outline-primary tw:bg-sb-card tw:text-sb-blue-strong btn-sm tw:px-3 tw:py-1.5 tw:text-sm">@(Model.IsSaved ? "Remove from saved" : "Save member")</button>
            </form>
            @if (Model.CanKnock)
            {
                using (Html.BeginForm("Knock", "Messages", FormMethod.Post))
                {
                    @Html.AntiForgeryToken()
                    @Html.Hidden("targetUserId", Model.UserId)
                    <button type="submit" class="btn tw:inline-flex tw:items-center tw:justify-center tw:gap-2 tw:rounded-xl tw:border-2 tw:border-sb-ink tw:px-4 tw:py-2 tw:font-extrabold tw:shadow-sb-small tw:transition-transform tw:hover:translate-x-[2px] tw:hover:translate-y-[2px] tw:dark:border-sb-night-ink btn-success tw:bg-sb-sage-deep tw:text-sb-ink"><i class="fas fa-hand-point-right"></i> Knock</button>
                }
            }
            <details class="mt-3 tw:mt-4"><summary>Report this profile</summary>
                <form action="@Url.Action("ReportProfile", "Profile")" method="post" class="mt-2 tw:mt-2 mx-auto tw:mx-auto" style="max-width: 500px;">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="id" value="@Model.UserId" />
                    <label class="form-label tw:mb-1 tw:block tw:font-bold" for="profile-report-reason">Reason</label>
                    <textarea id="profile-report-reason" name="reason" class="form-control tw:min-h-11 tw:w-full tw:rounded-lg tw:border-2 tw:border-sb-muted/40 tw:bg-sb-card tw:px-3 tw:py-2 tw:text-sb-ink tw:focus:border-sb-blue-strong tw:focus:outline-none tw:focus:ring-2 tw:focus:ring-sb-blue/70 tw:dark:border-sb-night-ink/50 tw:dark:bg-sb-night-card tw:dark:text-sb-night-ink mb-2 tw:mb-2" maxlength="500" required></textarea>
                    <button class="btn tw:inline-flex tw:items-center tw:justify-center tw:gap-2 tw:rounded-xl tw:border-2 tw:border-sb-ink tw:px-4 tw:py-2 tw:font-extrabold tw:shadow-sb-small tw:transition-transform tw:hover:translate-x-[2px] tw:hover:translate-y-[2px] tw:dark:border-sb-night-ink btn-outline-danger tw:bg-sb-card tw:text-[#944f43] btn-sm tw:px-3 tw:py-1.5 tw:text-sm" type="submit">Send report</button>
                </form>
            </details>
            <form action="@Url.Action("Block", "Profile")" method="post" class="mt-3 tw:mt-4">
                @Html.AntiForgeryToken()
                <input type="hidden" name="id" value="@Model.UserId" />
                <button type="submit" class="btn tw:inline-flex tw:items-center tw:justify-center tw:gap-2 tw:rounded-xl tw:border-2 tw:border-sb-ink tw:px-4 tw:py-2 tw:font-extrabold tw:shadow-sb-small tw:transition-transform tw:hover:translate-x-[2px] tw:hover:translate-y-[2px] tw:dark:border-sb-night-ink btn-outline-danger tw:bg-sb-card tw:text-[#944f43] btn-sm tw:px-3 tw:py-1.5 tw:text-sm" onclick="return confirm('Block this member? You will no longer be able to contact each other.')">Block member</button>
            </form>
        </div>
    }

    <div class="sb-profile-content-grid">
    <!-- Personal Information -->
    <section class="sb-profile-panel sb-profile-glance">
        <h2 class="h4 mt-4 tw:mt-6 mb-3 tw:mb-4">At a glance</h2>
        <dl class="row tw:grid tw:grid-cols-12 tw:gap-4">
            <dt class="col-sm-4 tw:col-span-12 tw:sm:col-span-4">Profession:</dt>
            <dd class="col-sm-8 tw:col-span-12 tw:sm:col-span-8">@Model.Profession</dd>

            <dt class="col-sm-4 tw:col-span-12 tw:sm:col-span-4">Average Rating:</dt>
            <dd class="col-sm-8 tw:col-span-12 tw:sm:col-span-8">
                @Model.AverageRating.ToString("0.0") / 10
                (out of @Model.RatingsReceived rated interaction@(Model.RatingsReceived == 1 ? "" : "s"))
            </dd>

            <dt class="col-sm-4 tw:col-span-12 tw:sm:col-span-4"></dt>
            <dd class="col-sm-8 tw:col-span-12 tw:sm:col-span-8">
                Completed total @Model.InteractionsCompleted interaction@(Model.InteractionsCompleted == 1 ? "" : "s")
            </dd>
        </dl>
    </section>

    <!-- Teaching Skills -->
    <section class="sb-profile-panel sb-profile-teaching">
    <h2 class="h4 mb-3 tw:mb-4">What @Model.FullName can teach</h2>
    <div>
        <ul id="skillsToTeachList" class="list-unstyled mb-0 tw:mb-0">
            @foreach (var skill in Model.SkillsToTeach)
            {
                var showButton = skill.RequestStatus != "Hidden";
                var buttonClass = "tw:bg-sb-sage-deep tw:text-sb-ink";
                var buttonText = "Request";
                var isDisabled = false;

                if (skill.RequestStatus == "Pending")
                {
                    buttonText = "Request Sent";
                    buttonClass = "tw:bg-sb-coral tw:text-sb-ink";
                    isDisabled = true;
                }
                else if (skill.RequestStatus == "Declined" || skill.RequestStatus == "Withdrawn")
                {
                    buttonText = "Request Again";
                    buttonClass = "tw:bg-sb-coral tw:text-sb-ink";
                }
                else if (skill.RequestStatus == "Accepted")
                {
                    buttonText = "Exchange started";
                    isDisabled = true;
                }

                var percent = skill.TotalStages > 0
                    ? Math.Min(100, skill.Stage * 100 / skill.TotalStages) : 0;
                <li class="mb-4 tw:mb-6 text-start tw:text-left">
                    <label><strong>@skill.SkillName</strong> (Stage: @skill.Stage of @skill.TotalStages)</label>

                    <div class="progress tw:overflow-hidden tw:rounded-full tw:border tw:border-sb-ink tw:bg-sb-sage mt-2 tw:mt-2" style="height:25px;">
                        <div class="progress-bar tw:grid tw:h-full tw:place-items-center tw:bg-sb-blue-strong tw:text-white bg-danger tw:bg-sb-coral" role="progressbar"
                             style="width:@(percent)%;"
                             aria-valuenow="@(percent)"
                             aria-valuemin="0" aria-valuemax="100">
                            @(percent)%
                        </div>
                    </div>

                    @if (User.Identity.IsAuthenticated && showButton)
                    {
                        <div class="text-center tw:text-center mt-3 tw:mt-4">
                            @if (isDisabled) { <span class="badge tw:inline-flex tw:items-center tw:rounded-full tw:border tw:border-sb-ink tw:px-2.5 tw:py-1 tw:text-xs tw:font-bold bg-warning tw:bg-sb-coral text-dark tw:text-sb-ink tw:dark:text-sb-night-ink">@buttonText</span> }
                            else
                            {
                                <details class="text-start tw:text-left"><summary class="btn tw:inline-flex tw:items-center tw:justify-center tw:gap-2 tw:rounded-xl tw:border-2 tw:border-sb-ink tw:px-4 tw:py-2 tw:font-extrabold tw:shadow-sb-small tw:transition-transform tw:hover:translate-x-[2px] tw:hover:translate-y-[2px] tw:dark:border-sb-night-ink @buttonClass">@buttonText</summary>
                                    <form class="requestSkillForm mt-3 tw:mt-4">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="userSkillId" value="@skill.UserSkillId" />
                                        <input type="hidden" name="profileId" value="@Model.UserId" />
                                        <label class="form-label tw:mb-1 tw:block tw:font-bold" for="goal-@skill.UserSkillId">What would you like to achieve?</label>
                                        <textarea id="goal-@skill.UserSkillId" name="goal" class="form-control tw:min-h-11 tw:w-full tw:rounded-lg tw:border-2 tw:border-sb-muted/40 tw:bg-sb-card tw:px-3 tw:py-2 tw:text-sb-ink tw:focus:border-sb-blue-strong tw:focus:outline-none tw:focus:ring-2 tw:focus:ring-sb-blue/70 tw:dark:border-sb-night-ink/50 tw:dark:bg-sb-night-card tw:dark:text-sb-night-ink mb-2 tw:mb-2" maxlength="500" required></textarea>
                                        <label class="form-label tw:mb-1 tw:block tw:font-bold" for="pace-@skill.UserSkillId">Preferred pace</label>
                                        <select id="pace-@skill.UserSkillId" name="pace" class="form-select tw:min-h-11 tw:w-full tw:rounded-lg tw:border-2 tw:border-sb-muted/40 tw:bg-sb-card tw:px-3 tw:py-2 tw:text-sb-ink tw:focus:border-sb-blue-strong tw:focus:outline-none tw:focus:ring-2 tw:focus:ring-sb-blue/70 tw:dark:border-sb-night-ink/50 tw:dark:bg-sb-night-card tw:dark:text-sb-night-ink mb-2 tw:mb-2" required><option value="">Choose a pace</option><option>Weekly</option><option>Twice weekly</option><option>Flexible</option></select>
                                        <label class="form-label tw:mb-1 tw:block tw:font-bold" for="meeting-@skill.UserSkillId">First meeting idea (optional)</label>
                                        <input id="meeting-@skill.UserSkillId" name="firstMeetingIdea" class="form-control tw:min-h-11 tw:w-full tw:rounded-lg tw:border-2 tw:border-sb-muted/40 tw:bg-sb-card tw:px-3 tw:py-2 tw:text-sb-ink tw:focus:border-sb-blue-strong tw:focus:outline-none tw:focus:ring-2 tw:focus:ring-sb-blue/70 tw:dark:border-sb-night-ink/50 tw:dark:bg-sb-night-card tw:dark:text-sb-night-ink mb-2 tw:mb-2" maxlength="300" placeholder="For example, discuss goals over chat" />
                                        <button type="submit" class="btn tw:inline-flex tw:items-center tw:justify-center tw:gap-2 tw:rounded-xl tw:border-2 tw:border-sb-ink tw:px-4 tw:py-2 tw:font-extrabold tw:shadow-sb-small tw:transition-transform tw:hover:translate-x-[2px] tw:hover:translate-y-[2px] tw:dark:border-sb-night-ink btn-primary tw:bg-sb-blue-strong tw:text-white">Send proposal</button>
                                        <span class="request-result ms-2 tw:ms-2" role="status"></span>
                                    </form>
                                </details>
                            }
                        </div>
                    }
                </li>
            }
        </ul>
    </div>
    </section>

    <!-- Learning Skills -->
    <section class="sb-profile-panel sb-profile-learning">
    <h2 class="h4 mb-3 tw:mb-4">What @Model.FullName wants to learn</h2>
    <div class="d-flex tw:flex flex-wrap tw:flex-wrap gap-3 tw:gap-4">
        @foreach (var skill in Model.SkillsToLearn)
        {
            <div class="card tw:overflow-hidden tw:rounded-2xl tw:border-2 tw:border-sb-ink tw:bg-sb-card tw:text-sb-ink tw:shadow-sb-small tw:dark:border-sb-night-ink tw:dark:bg-sb-night-card tw:dark:text-sb-night-ink sb-learning-skill">
                <div class="card-body tw:p-5 p-2 tw:p-2 text-center tw:text-center">
                    <span>@skill.SkillName (Stage: @skill.Stage)</span>
                </div>
            </div>
        }
    </div>
    </section>
    </div>
</main>

@section Scripts {
    <script>
        $(document).ready(function () {
            $(".requestSkillForm").on("submit", function (event) {
                event.preventDefault();
                var $form = $(this), $button = $form.find('button[type="submit"]');
                $button.prop("disabled", true);
                $.ajax({
                    url: '@Url.Action("SendSkillRequest", "Profile")',
                    type: 'POST',
                    data: $form.serialize(),
                    success: function (res) {
                        if (res.success) {
                            $form.find(".request-result").text("Proposal sent.");
                        } else {
                            $form.find(".request-result").text(res.message || "Could not send proposal.");
                            $button.prop("disabled", false);
                        }
                    },
                    error: function () {
                        $form.find(".request-result").text("Could not send proposal. Try again.");
                        $button.prop("disabled", false);
                    }
                });
            });
        });
    </script>
}
