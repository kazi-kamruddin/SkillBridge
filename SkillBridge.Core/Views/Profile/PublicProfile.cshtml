@model SkillBridge.Models.PublicProfileViewModel


@section Styles {
    <link rel="stylesheet" href="~/Styles/publicProfile.css" />
}

<main class="container text-center mt-5 sb-public-profile" aria-labelledby="title">
    @Html.AntiForgeryToken()
    @if (TempData["ProfileNotice"] is string notice) { <div class="alert alert-info" role="status">@notice</div> }

    <div class="mb-3 text-center">
        <img src="@Model.ProfileImageUrl"
             alt="@Model.FullName"
             class="rounded-circle"
             style="width:150px; height:150px; object-fit:cover; border:2px solid #ccc;" />
    </div>

    <span class="sb-eyebrow">MEET YOUR NEXT LEARNING PARTNER</span>
    <h1 id="title">@Model.FullName</h1>
    @if (!string.IsNullOrWhiteSpace(Model.Profession) || !string.IsNullOrWhiteSpace(Model.Location)) { <p class="text-muted">@string.Join(" · ", new[] { Model.Profession, Model.Location }.Where(s => !string.IsNullOrWhiteSpace(s)))</p> }
    <p>@Model.Bio</p>
    @if (!string.IsNullOrWhiteSpace(Model.AvailabilityNotes)) { <p><strong>Availability:</strong> @Model.AvailabilityNotes</p> }
    @if (Model.AvailableDaysMask != 0) { <p><strong>Usual days:</strong> @AvailabilityHelper.DescribeDays(Model.AvailableDaysMask)</p> }
    @if (!string.IsNullOrWhiteSpace(Model.TimeZoneId)) { <p><strong>Time zone:</strong> @Model.TimeZoneId</p> }
    <p><strong>Meeting format:</strong> @Model.MeetingFormat</p>

    @if (User.Identity.IsAuthenticated && Model.UserId != User.Identity.GetUserId())
    {
        <div class="mt-3 mb-4">
            <form method="post" action="@Url.Action(Model.IsSaved ? "Remove" : "Save", "SavedProfiles")" class="mb-2">
                @Html.AntiForgeryToken()
                <input type="hidden" name="id" value="@Model.UserId" />
                <button type="submit" class="btn btn-outline-primary btn-sm">@(Model.IsSaved ? "Remove from saved" : "Save member")</button>
            </form>
            @if (Model.CanKnock)
            {
                using (Html.BeginForm("Knock", "Messages", FormMethod.Post))
                {
                    @Html.AntiForgeryToken()
                    @Html.Hidden("targetUserId", Model.UserId)
                    <button type="submit" class="btn btn-success"><i class="fas fa-hand-point-right"></i> Knock</button>
                }
            }
            <details class="mt-3"><summary>Report this profile</summary>
                <form action="@Url.Action("ReportProfile", "Profile")" method="post" class="mt-2 mx-auto" style="max-width: 500px;">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="id" value="@Model.UserId" />
                    <label class="form-label" for="profile-report-reason">Reason</label>
                    <textarea id="profile-report-reason" name="reason" class="form-control mb-2" maxlength="500" required></textarea>
                    <button class="btn btn-outline-danger btn-sm" type="submit">Send report</button>
                </form>
            </details>
            <form action="@Url.Action("Block", "Profile")" method="post" class="mt-3">
                @Html.AntiForgeryToken()
                <input type="hidden" name="id" value="@Model.UserId" />
                <button type="submit" class="btn btn-outline-danger btn-sm" onclick="return confirm('Block this member? You will no longer be able to contact each other.')">Block member</button>
            </form>
        </div>
    }

    <hr />

    <!-- Personal Information -->
    <div class="text-start mx-auto" style="max-width: 600px;">
        <h2 class="h4 mt-4 mb-3">At a glance</h2>
        <dl class="row">
            <dt class="col-sm-4">Profession:</dt>
            <dd class="col-sm-8">@Model.Profession</dd>

            <dt class="col-sm-4">Average Rating:</dt>
            <dd class="col-sm-8">
                @Model.AverageRating.ToString("0.0") / 10
                (out of @Model.RatingsReceived rated interaction@(Model.RatingsReceived == 1 ? "" : "s"))
            </dd>

            <dt class="col-sm-4"></dt>
            <dd class="col-sm-8">
                Completed total @Model.InteractionsCompleted interaction@(Model.InteractionsCompleted == 1 ? "" : "s")
            </dd>
        </dl>
    </div>

    <!-- Teaching Skills -->
    <h2 class="h4 mt-4 mb-3">What @Model.FullName can teach</h2>
    <div class="card shadow p-4 mx-auto" style="max-width: 600px;">
        <ul id="skillsToTeachList" class="list-unstyled mb-0">
            @foreach (var skill in Model.SkillsToTeach)
            {
                var showButton = skill.RequestStatus != "Hidden";
                var buttonClass = "btn btn-success"; 
                var buttonText = "Request";
                var isDisabled = false;

                if (skill.RequestStatus == "Pending")
                {
                    buttonText = "Request Sent";
                    buttonClass = "btn btn-warning"; 
                    isDisabled = true;
                }
                else if (skill.RequestStatus == "Declined" || skill.RequestStatus == "Withdrawn")
                {
                    buttonText = "Request Again";
                    buttonClass = "btn btn-danger"; 
                }
                else if (skill.RequestStatus == "Accepted")
                {
                    buttonText = "Exchange started";
                    isDisabled = true;
                }

                var percent = skill.TotalStages > 0
                    ? Math.Min(100, skill.Stage * 100 / skill.TotalStages) : 0;
                <li class="mb-4 text-start">
                    <label><strong>@skill.SkillName</strong> (Stage: @skill.Stage of @skill.TotalStages)</label>

                    <div class="progress mt-2" style="height:25px;">
                        <div class="progress-bar bg-danger" role="progressbar"
                             style="width:@(percent)%;"
                             aria-valuenow="@(percent)"
                             aria-valuemin="0" aria-valuemax="100">
                            @(percent)%
                        </div>
                    </div>

                    @if (User.Identity.IsAuthenticated && showButton)
                    {
                        <div class="text-center mt-3">
                            @if (isDisabled) { <span class="badge bg-warning text-dark">@buttonText</span> }
                            else
                            {
                                <details class="text-start"><summary class="btn @buttonClass">@buttonText</summary>
                                    <form class="requestSkillForm mt-3">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="userSkillId" value="@skill.UserSkillId" />
                                        <input type="hidden" name="profileId" value="@Model.UserId" />
                                        <label class="form-label" for="goal-@skill.UserSkillId">What would you like to achieve?</label>
                                        <textarea id="goal-@skill.UserSkillId" name="goal" class="form-control mb-2" maxlength="500" required></textarea>
                                        <label class="form-label" for="pace-@skill.UserSkillId">Preferred pace</label>
                                        <select id="pace-@skill.UserSkillId" name="pace" class="form-select mb-2" required><option value="">Choose a pace</option><option>Weekly</option><option>Twice weekly</option><option>Flexible</option></select>
                                        <label class="form-label" for="meeting-@skill.UserSkillId">First meeting idea (optional)</label>
                                        <input id="meeting-@skill.UserSkillId" name="firstMeetingIdea" class="form-control mb-2" maxlength="300" placeholder="For example, discuss goals over chat" />
                                        <button type="submit" class="btn btn-primary">Send proposal</button>
                                        <span class="request-result ms-2" role="status"></span>
                                    </form>
                                </details>
                            }
                        </div>
                    }
                </li>
            }
        </ul>
    </div>

    <!-- Learning Skills -->
    <h2 class="h4 mt-5 mb-3">What @Model.FullName wants to learn</h2>
    <div class="d-flex flex-wrap justify-content-center gap-3">
        @foreach (var skill in Model.SkillsToLearn)
        {
            <div class="card sb-learning-skill">
                <div class="card-body p-2 text-center">
                    <span>@skill.SkillName (Stage: @skill.Stage)</span>
                </div>
            </div>
        }
    </div>

    <div style="height: 45px;"></div>
</main>

@section Scripts {
    <script>
        $(document).ready(function () {
            $(".requestSkillForm").on("submit", function (event) {
                event.preventDefault();
                var $form = $(this), $button = $form.find('button[type="submit"]');
                $button.prop("disabled", true);
                $.ajax({
                    url: '@Url.Action("SendSkillRequest", "Profile")',
                    type: 'POST',
                    data: $form.serialize(),
                    success: function (res) {
                        if (res.success) {
                            $form.find(".request-result").text("Proposal sent.");
                        } else {
                            $form.find(".request-result").text(res.message || "Could not send proposal.");
                            $button.prop("disabled", false);
                        }
                    },
                    error: function () {
                        $form.find(".request-result").text("Could not send proposal. Try again.");
                        $button.prop("disabled", false);
                    }
                });
            });
        });
    </script>
}
